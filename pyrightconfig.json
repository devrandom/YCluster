{
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": [
    "config/ansible/admin/files/ycluster",
    "mcp/cluster-exec/src"
  ],
  "include": [
    "config/ansible/admin/files",
    "contrib",
    "mcp/cluster-exec"
  ],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "**/.venv",
    "**/venv"
  ],
  "reportMissingModuleSource": false,
  "reportMissingTypeStubs": false
}
