#!/bin/bash
# Manage the cluster-exec MCP server (streamable HTTP transport).
#
# Commands (run with no args for usage):
#   --start    Launch the server in the background and wait until the HTTP
#              port is bound. Returns when the server is reachable.
#              Idempotent: refuses to start a second instance while one is
#              running.
#   --stop     POST /stop to the server with bearer auth; the daemon kills
#              its backgrounded SSH sessions and signals itself to
#              terminate. Waits for the port to release. Works regardless
#              of whether the pid file is intact.
#   --status   Report whether the server is up and where its URL is.
#   --restart  --stop + --start.
#
# State files (under tmp/, gitignored):
#   tmp/cluster-exec.pid   PID of the running server (uvicorn). Diagnostic
#                          only — pid tracking is unreliable across PID
#                          namespaces (e.g. codex/bwrap --unshare-pid).
#                          Liveness and stop both use the network port
#                          instead.
#   tmp/cluster-exec.log   stdout/stderr of the server
#   tmp/cluster-exec.state.json
#                          persisted background-session registry (mode
#                          0600; override with CE_STATE_PATH). Kept across
#                          restarts so `status` does not forget sessions.
#
# Env vars (read by the server itself, not by this script — set them before
# invoking --start):
#   CE_HTTP_HOST           bind address (default 127.0.0.1)
#   CE_HTTP_PORT           bind port (default 4003)
#   CE_HTTP_PATH           MCP endpoint path (default /mcp)
#   CE_BASTION             SSH bastion host (required; the run tool fails
#                          fast at startup if unset)
#   CE_SSH_CONTROL_PERSIST_S
#                          seconds to keep one multiplexed bastion
#                          connection alive after the last call (default
#                          300; 0 disables ControlMaster reuse)
#   CE_SSH_CONTROL_PATH    ControlMaster socket path (default
#                          ~/.ssh/cluster-exec-%C; %C hashes the
#                          destination/user/port; empty disables)
#   CE_BEARER_PATH         bearer token file (default
#                          ~/.config/cluster-exec/bearer, mode 0600)
#   CE_ENVRC               .envrc to auto-export CE_BEARER into (default
#                          $REPO/.envrc)
#   CE_LOG_PATH            JSONL log path for run output (default
#                          tmp/cluster.log)
#   CE_STATE_PATH          persisted background-session registry (default
#                          tmp/cluster-exec.state.json, mode 0600). Reloaded
#                          on start so status survives daemon restarts.
#   CE_TIMEOUT_S           hard timeout per backgrounded run, seconds
#                          (default 1800)
#   CE_AUTO_BG_TIMEOUT_S   auto-bg threshold, seconds (default 10; bump
#                          for deployments where a known-long command
#                          should hold the foreground rather than
#                          auto-backgrounding; set 0 to disable)
#   CE_PROGRESS_INTERVAL_S, CE_PROGRESS_TAIL_LINES
#   CE_CAPTURE_REQUESTS    debug-only: path to a JSONL file that will
#                          receive one line per incoming HTTP request
#                          (ts, method, path, headers, body). Bearer
#                          tokens and project-identifying fields are
#                          redacted before write. Use to inspect what
#                          MCP clients send on the wire.
#
# This script does not inherit CE_* into the spawned server. Pass them through
# the shell (e.g. `CE_BASTION=s3.frp bash mcp/cluster-exec/cedaemon --start`)
# or wire them in your .envrc before calling.

set -euo pipefail

REPO="$(cd "$(dirname "$0")/../.." && pwd)"
PID="$REPO/tmp/cluster-exec.pid"
LOG="$REPO/tmp/cluster-exec.log"
HOST="${CE_HTTP_HOST:-127.0.0.1}"
PORT="${CE_HTTP_PORT:-4003}"
PATH_="${CE_HTTP_PATH:-/mcp}"
URL="http://$HOST:$PORT$PATH_"
BEARER_PATH="${CE_BEARER_PATH:-$HOME/.config/cluster-exec/bearer}"
ENVRC="${CE_ENVRC:-$REPO/.envrc}"

mkdir -p "$(dirname "$PID")"

usage() {
    cat <<EOF
Usage: $(basename "$0") <command>

Manage the cluster-exec MCP server (streamable HTTP transport at $URL).

The server requires HTTP Bearer authentication. The token file is at
$BEARER_PATH (mode 0600). On --start, CE_BEARER is auto-exported in
$ENVRC so opencode's {env:CE_BEARER} header picks it up.

Commands:
  --start    Launch in the background, wait until the port is bound.
  --stop     POST /stop with bearer auth (kills bg SSH, signals self).
  --status   Print whether the server is up and the URL.
  --restart  --stop + --start.
EOF
}

# Liveness check — port-based, not pid-based.
#
# Why not pid: the daemon is spawned via `setsid cmd &` and `$!` captures
# setsid's short-lived parent, not the long-lived uvicorn worker. uv then
# spawns python which spawns uvicorn — the pid chain is `bash → setsid →
# uv → python → uvicorn-worker`, and which one bash's `$!` actually
# captures depends on the setsid flavor. Tracking any one of them is
# fragile.
#
# Worse: when this script runs from inside a sandboxed shell (e.g.
# codex/bwrap with `--unshare-pid`), the daemon's pids live in a
# different PID namespace than the one a later `cedaemon --status`
# invocation sees. `kill -0 $pid` always returns false even though the
# daemon is happily serving requests.
#
# Port-based liveness avoids both problems: `bash`'s `/dev/tcp` works
# across PID namespaces and doesn't require root or external tools.
# Stopping works the same way: we POST to the server's `/stop`
# endpoint (also network-namespace-portable), the daemon kills its
# backgrounded SSH sessions and signals itself to terminate.
port_bound() {
    (echo > "/dev/tcp/$HOST/$PORT") 2>/dev/null
}

wait_for_port() {
    local timeout_s=15
    local start
    start=$(date +%s)
    while true; do
        # Cheap port check — works across PID namespaces.
        if (echo > "/dev/tcp/$HOST/$PORT") 2>/dev/null; then
            return 0
        fi
        if (( $(date +%s) - start > timeout_s )); then
            echo "server did not bind $HOST:$PORT within ${timeout_s}s" >&2
            tail -n 40 "$LOG" >&2 || true
            return 1
        fi
        sleep 0.2
    done
}

wait_for_port_release() {
    local timeout_s=15
    local start
    start=$(date +%s)
    while port_bound; do
        if (( $(date +%s) - start > timeout_s )); then
            echo "port $PORT still bound after ${timeout_s}s" >&2
            return 1
        fi
        sleep 0.2
    done
    return 0
}

# POST /stop with bearer auth. The daemon kills backgrounded SSH
# sessions, schedules SIGTERM on itself, and returns 200 — the port
# releases as uvicorn shuts down.
http_post_stop() {
    if [[ ! -f "$BEARER_PATH" ]]; then
        echo "bearer token file missing: $BEARER_PATH" >&2
        return 1
    fi
    local token
    token=$(cat "$BEARER_PATH")
    local resp
    resp=$(curl --max-time 10 -fsS -X POST \
        -H "Authorization: Bearer $token" \
        "http://$HOST:$PORT/stop" 2>&1) || {
        echo "stop request failed: $resp" >&2
        return 1
    }
    echo "server acknowledged stop: $resp"
}

do_start() {
    if port_bound; then
        echo "already running (port $PORT bound, url $URL)"
        exit 0
    fi
    : > "$LOG"
    unset VIRTUAL_ENV
    # setsid puts the child in its own session so it survives the parent
    # shell exiting — we don't want to hang on to a tty.
    setsid uv run --project "$REPO/mcp/cluster-exec" \
        python -m cluster_exec \
        >> "$LOG" 2>&1 < /dev/null &
    echo $! > "$PID"
    wait_for_port
    echo "started — pid $(cat "$PID") (track may not match long-lived worker), url $URL, log $LOG"
    echo "bearer token file: $BEARER_PATH (mode 0600)"
    ensure_bearer_in_envrc "$BEARER_PATH" "$ENVRC"
    echo "stop with: $(basename "$0") --stop"
}

# Append `export CE_BEARER=$(cat <bearer_path>)` to $2 unless it's already
# present, so opencode's `{env:CE_BEARER}` header substitution picks up the
# token. Skipped silently if the envrc file is missing — the user can wire
# it manually in that case.
ensure_bearer_in_envrc() {
    local token_path="$1"
    local envrc="$2"
    if [[ ! -f "$envrc" ]]; then
        echo "note: $envrc not found — to wire opencode, export CE_BEARER=\$(cat '$token_path')"
        return
    fi
    if grep -qF 'export CE_BEARER=' "$envrc"; then
        echo "CE_BEARER already exported in $envrc"
        return
    fi
    {
        echo ""
        echo "# Auto-managed by mcp/cluster-exec/cedaemon — bearer for cluster_exec MCP"
        echo "export CE_BEARER=\"\$(cat '$token_path')\""
    } >> "$envrc"
    echo "added CE_BEARER export to $envrc (direnv will reload)"
}

do_stop() {
    if ! port_bound; then
        rm -f "$PID"
        echo "not running"
        exit 0
    fi
    if ! http_post_stop; then
        return 1
    fi
    if ! wait_for_port_release; then
        echo "see log $LOG for details" >&2
        return 1
    fi
    rm -f "$PID"
    echo "stopped"
}

do_status() {
    if port_bound; then
        local pid_msg
        if [[ -s "$PID" ]]; then
            pid_msg="pid $(cat "$PID") (may not be long-lived worker)"
        else
            pid_msg="pid unknown (sandboxed start — see log)"
        fi
        echo "running — $pid_msg, url $URL, log $LOG, bearer $BEARER_PATH"
    else
        rm -f "$PID"
        echo "not running — start with: $(basename "$0") --start"
    fi
}

do_restart() {
    # Idempotent: stop only if running, then always start. Lets you call
    # --restart on a fresh machine without first checking --status.
    if port_bound; then
        do_stop || return 1
    fi
    do_start
}

case "${1:-}" in
    --start)
        do_start
        ;;
    --stop)
        do_stop
        ;;
    --status)
        do_status
        ;;
    --restart)
        do_restart
        ;;
    -h|--help|"")
        usage
        ;;
    *)
        echo "unknown option: $1" >&2
        usage >&2
        exit 2
        ;;
esac
