# app.<domain> — legacy alias. <domain> now serves the landing page and
# self-service surface directly, so app.<domain> just redirects to the root.
# Rendered by certbot-manager from this `*_app.conf.j2` template (the `_app`
# suffix keeps server_name=app.<primary> and adds it to the certificate SAN).
#
# Single listener pair, like the other app vhosts: the cluster-internal /
# direct listener (plain :443) and the frp tunnel landing
# (127.0.0.2:17443, PROXY protocol v2), so both internal and external
# app.<domain> hits redirect to https://<primary>/.
server {
    {% if use_tls %}
    listen 443 ssl http2;
    listen 127.0.0.2:17443 ssl http2 proxy_protocol;
    {% else %}
    listen 80;
    listen 127.0.0.2:17443 proxy_protocol;
    {% endif %}
    server_name {{ domain | default('app') }};

    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    {% if use_tls %}
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    {% endif %}
    add_header X-Content-Type-Options nosniff always;

    # Permanent redirect to the root landing page. `primary` is the
    # bare <domain>, injected by certbot-manager update-nginx.
    location / {
        return 301 https://{{ primary }}/;
    }
}
