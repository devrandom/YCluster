# Alt vhost for the frp tunnel. frpc forwards external traffic to
# 127.0.0.2 on the backend ports (17080 / 17443), and frps uses PROXY
# protocol v2 — so this vhost picks up real client IPs and rate-limit
# zones can drop back to per-client semantics. See
# todo/networking/switch-rathole-to-frp.md and
# docs/archive/frp-migration.md.
#
# frp serves the production primary public HTTP/HTTPS (:80 / :443) —
# rathole's public HTTP (:80) and HTTPS rollback (:14443) are gone.
#
# This vhost is now the DEFAULT server on the frp proxy ports only. The
# per-hostname app surfaces (open-webui, app., comfy., auth., and the
# admin *public* surface) live in their own per-app templates, each of
# which declares its plain internal listener (:443) alongside the PROXY
# landing (127.0.0.2:17443). What stays here:
#   - the HTTP :17080 server (ACME HTTP-01 + the admin public whitelist
#     / authed locations over plain HTTP),
#   - the `_` HTTPS default (404 fallback for unmatched hosts),
#   - the public admin.<domain> HTTPS block. Admin is the one exception to
#     the single-source model: the internal admin vhost (admin-api.conf.j2)
#     is a deliberately identity-less operator surface on :443, so the
#     forward-authed public admin surface must remain a distinct block here.
#     app/auth/comfy/open-webui are identical behind the IdP on both the
#     internal and proxy listeners, so they are not duplicated here.
#
# Like the sibling vhost templates, TLS listeners/certs are gated on
# `use_tls`. In --local dev mode (use_tls=False, no cluster cert seeded)
# the HTTPS surface falls back to plain HTTP on the same alt port, so
# nginx still config-tests and reloads; in prod (use_tls=True) this
# renders exactly the TLS surface below.

# HTTP - PUBLIC ALT (frp tunnel endpoint on 127.0.0.2:17080).
# Public whitelist + authed locations — same scope as before so
# frp-served HTTP exercises the same paths (including forward-auth via
# the cluster IdP).
server {
    listen 127.0.0.2:17080 proxy_protocol;
    server_name _;

    # PROXY protocol v2 from frps — picks up real client IPs. Trust
    # the loopback bind: only the local frpc can reach 127.0.0.2.
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;

    # ACME HTTP-01 challenges (certbot --webroot): public HTTP lands
    # here via the frp tunnel (f1:80 -> frpc -> 127.0.0.2:17080), so the
    # challenge path must be served on this vhost. certbot writes to
    # /var/www/html and must run on the node where the frpc tunnel lands
    # (the storage leader) — see ycluster/utils/certbot_manager.py.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type text/plain;
    }

    # Public whitelist (wg bootstrap flow + read-only status dashboard).
    include /etc/nginx/admin-api-public-locations.conf;

    # Authenticated pages (forward-auth via the cluster IdP).
    include /etc/nginx/admin-api-authed-locations.conf;

    location / {
        return 404;
    }
}

# HTTPS - PUBLIC ALT (frp tunnel endpoint on 127.0.0.2:17443).
# Default server (server_name _) — 404 fallback for unmatched hosts.
server {
    {% if use_tls %}
    listen 127.0.0.2:17443 ssl http2 proxy_protocol;
    {% else %}
    listen 127.0.0.2:17443 proxy_protocol;
    {% endif %}
    server_name _;

    {% if use_tls %}
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    {% endif %}
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;

    location / {
        return 404;
    }
}

# Admin-API — public (forward-authed) admin.<domain> surface over the frp
# tunnel. Distinct from the internal identity-less admin vhost
# (admin-api.conf.j2 on plain :443): this one enforces the IdP forward-auth
# for external users and includes the whitelist + authed locations.
server {
    {% if use_tls %}
    listen 127.0.0.2:17443 ssl http2 proxy_protocol;
    {% else %}
    listen 127.0.0.2:17443 proxy_protocol;
    {% endif %}
    server_name admin.{{ domain | default('_') }};

    {% if use_tls %}
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Frontend NAT gateway pull endpoint (docs/design/vm-frontend-nat.md):
    # request optional client certs so the nat-rules location can verify
    # the frontend agent. Browsers without a cert proceed normally
    # (optional = requested, not required); the per-location
    # $ssl_client_verify check in the location block enforces it.
    ssl_client_certificate /etc/nginx/nat-ca.crt;
    ssl_verify_client optional;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    {% endif %}
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;

    limit_req_status 429;

    # Public whitelist (wg bootstrap flow + read-only status dashboard).
    include /etc/nginx/admin-api-public-locations.conf;

    # Authenticated pages (forward-auth via the cluster IdP) + their data APIs.
    include /etc/nginx/admin-api-authed-locations.conf;

    location / {
        return 404;
    }
}
