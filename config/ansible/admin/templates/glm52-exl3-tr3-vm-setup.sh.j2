#!/usr/bin/env bash
# Pull the GLM-5.2 EXL3 TR3 3-bpw image into {{ exl3_tr3_vm_name }}, smoke-test
# GPU passthrough, check the NFS model mount, and hint at the HF download if
# the model is missing.
#
#   ~/bin/glm52-exl3-tr3-vm-setup.sh
#
# Run as the dev user (no sudo, no root in the VM). Pre-reqs (operator-managed
# one-time setup; not part of this script):
#  - {{ exl3_tr3_vm_name }} VM exists on this host, 4 GPUs passed through:
#      ycluster vm launch {{ exl3_tr3_vm_name }} \
#        --owner {{ exl3_tr3_vm_owner }} --gpus {{ exl3_tr3_vm_gpus }} \
#        --mem {{ exl3_tr3_vm_mem }} --cpu {{ exl3_tr3_vm_cpu }}
#  - Driver downgraded inside the VM to nvidia-driver-{{ exl3_tr3_driver_pkg }}.
#    Host driver 610 hits CUDA error 803 "unsupported display driver / cuda
#    driver combination" against the EXL3 image's bundled CUDA 13.2.75 — the
#    image accepts up to driver 580.x.
#  - NFS model mount at /model inside the VM (operator installs nfs-kernel-server
#    on this host, adds the export, and mounts inside the VM).
#
# Image: 0xSero's custom vLLM `verdictai/glm52-exl3-sparkinfer:v31-…-cu132-sm120a`
# — EXL3 Trellis MoE + B12X sparse MLA + MTP spec-decode with a quantized EXL3
# layer-78 draft. The image's bundled CUDA 13.2.75 pins driver ≤ 580 (the host
# 610 driver is too new). Recipe + 80–83 tok/s reproduction on this hardware:
# docs/inference/glm-5.2-nvfp4-sm120-design-2026-06.md, "EXL3 TR3 attempt"
# section.
set -euo pipefail

VM="{{ exl3_tr3_vm_name }}"
IMAGE="{{ exl3_tr3_image }}"
MODEL_HOST="{{ exl3_tr3_model_dir }}"
DRIVER_LIB_VERSION="{{ exl3_tr3_driver_lib_version }}"

command -v incus >/dev/null \
  || { echo "incus missing - an operator must run admin/install-incus.yml" >&2; exit 1; }

# VM must be running. `incus info` returns Status: Running | Stopped.
incus info "$VM" | grep -q "^Status: Running$" \
  || { echo "VM '$VM' is not running. Start it: incus start $VM" >&2; exit 1; }

# Helper: run a command inside the VM as root (root is the default user for
# GPU passthrough + libcuda bind-mounts; the dev user on the host does not
# need sudo for `incus exec` because of the incus-admin group).
in_vm() { incus exec "$VM" -- "$@"; }

echo "== pull $IMAGE (inside VM) =="
in_vm podman pull "$IMAGE"

echo "== GPU passthrough smoke test =="
# CDI is broken in podman 4.9.3 with full PCI slot usage from vfio-pci
# passthrough (`nvidia.com/gpu=0` errors "unresolvable"); the launch script
# injects /dev/nvidia* manually + bind-mounts the host libcuda. Here we just
# verify the passthrough contract: every passthrough GPU's char device is
# visible inside the VM. A missing device here means the host's
# gpu-passthrough.service failed to bind the GPU to vfio-pci, or the VM was
# launched without --gpus.
for d in /dev/nvidia0 /dev/nvidia1 /dev/nvidia2 /dev/nvidia3 \
         /dev/nvidia-uvm /dev/nvidiactl; do
  in_vm test -e "$d" \
    || { echo "missing device $d inside VM - vfio-pci passthrough broken?" >&2; exit 1; }
done

echo "== driver version check (libcuda.so.$DRIVER_LIB_VERSION must exist) =="
# The EXL3 image's bundled CUDA 13.2.75 requires driver ≤ 580.x. Driver 610
# (current Ubuntu 24.04 default) hits CUDA error 803 at first vLLM init.
in_vm test -f "/usr/lib/x86_64-linux-gnu/libcuda.so.$DRIVER_LIB_VERSION" \
  || { echo "libcuda.so.$DRIVER_LIB_VERSION missing inside VM." >&2; \
       echo "Downgrade the in-VM driver:" >&2; \
       echo "  incus exec $VM -- apt install -y nvidia-driver-{{ exl3_tr3_driver_pkg }}" >&2; \
       exit 1; }

echo "== model mount check =="
if in_vm test -f "/model/config.json" && in_vm test -f "/model/model.safetensors.index.json"; then
  echo "  /model ready"
else
  echo "Model missing at /model inside VM. Two-step setup:"
  echo ""
  echo "  # 1. Install nfs-kernel-server on this host (one-time):"
  echo "  sudo apt install -y nfs-kernel-server"
  echo "  sudo tee /etc/exports.d/ycluster-models.conf <<EOF"
  echo "/home/dev/models {{ exl3_tr3_nfs_cidr }}(ro,sync,no_subtree_check,no_root_squash)"
  echo "EOF"
  echo "  sudo exportfs -ra"
  echo ""
  echo "  # 2. Mount inside the VM (one-time):"
  echo "  incus exec $VM -- apt install -y nfs-common"
  echo "  incus exec $VM -- mount -t nfs -o ro,vers=4 $(hostname -I | awk '{print $1}'):/home/dev/models /mnt/nv4-models"
  echo "  incus exec $VM -- ln -sfn /mnt/nv4-models/{{ exl3_tr3_repo_basename }} /model"
  echo ""
  echo "  # 3. Download the weights to the host (XET disabled - see comment below):"
  echo "  HF_HUB_DISABLE_XET=1 hf download {{ exl3_tr3_repo }} --local-dir $MODEL_HOST"
  echo ""
  echo "  # HF_HUB_DISABLE_XET=1: this node's egress can't reach the Xet CAS endpoint"
  echo "  # (the Xet path stalls at 0 B/s); the classic HF CDN works (~200 MB/s)."
  exit 0
fi

echo
echo "Image + GPU + model ready. Start the server:"
echo "  ~/bin/glm52-exl3-tr3-vm-start.sh"
