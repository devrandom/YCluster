#!/bin/bash
# Build the 'ubuntu-cuda' Incus VM image: Ubuntu 24.04 with the NVIDIA
# open kernel modules, CUDA toolkit and container toolkit preinstalled.
# Generated by Ansible (install-incus.yml).
set -euo pipefail

ALIAS="ubuntu-cuda"
BUILDER="cuda-image-builder"
BASE="images:ubuntu/24.04/cloud"
CUDA_VERSION="{{ cuda_version }}"

if [[ "${1:-}" != "--force" ]] && incus image alias list --format csv | grep -q "^${ALIAS},"; then
    echo "Image '$ALIAS' already exists. Pass --force to rebuild."
    exit 0
fi

cleanup() { incus delete --force "$BUILDER" 2>/dev/null || true; }
trap cleanup EXIT

incus delete --force "$BUILDER" 2>/dev/null || true

echo "==> Launching builder VM..."
incus launch "$BASE" "$BUILDER" --vm \
    -c limits.cpu=8 -c limits.memory=16GiB \
    -d root,size=40GiB

echo "==> Waiting for guest agent..."
for _ in $(seq 1 60); do
    incus exec "$BUILDER" -- true 2>/dev/null && break
    sleep 5
done
incus exec "$BUILDER" -- cloud-init status --wait || true

echo "==> Installing NVIDIA driver and CUDA in guest..."
incus exec "$BUILDER" -- bash -euxc "
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    # linux-headers-virtual keeps headers in lockstep with linux-image-virtual,
    # so DKMS rebuilds the NVIDIA module when unattended-upgrades stages a new
    # kernel; without it the next reboot comes up driverless.
    apt-get install -y build-essential dkms linux-headers-virtual \
        linux-headers-\$(uname -r) \
        pkg-config libglvnd-dev curl openssh-server \
        python3-dev ninja-build cmake
    curl -fsSL -o /tmp/cuda-keyring.deb \
        https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb
    apt-get install -y /tmp/cuda-keyring.deb
    rm -f /tmp/cuda-keyring.deb
    apt-get update
    apt-get install -y cuda-toolkit-${CUDA_VERSION} nvidia-open nvidia-container-toolkit
    printf 'export PATH=/usr/local/cuda/bin:\$PATH\nexport LD_LIBRARY_PATH=/usr/local/cuda/lib64:\$LD_LIBRARY_PATH\n' \
        > /etc/profile.d/cuda.sh
    apt-get clean
"

echo "==> Baking in guest NVIDIA power-limit service ({{ nvidia_power_limit_watts }} W)..."
# A passthrough host has no host-visible GPU (all GPUs are bound to
# vfio-pci and handed to VMs), so the host-side nvidia-power-limit.service
# correctly no-ops there. The limit therefore has to be set inside each
# guest, on every boot. Bake the same power-limit script and a matching
# systemd unit into the image so every GPU VM enforces it. The guest script
# no-ops cleanly in a CPU-only VM (no nvidia-smi GPU), so this is safe for
# the whole image population.
GUEST_POWER_LIMIT_B64='{{ lookup('file', 'files/scripts/nvidia-power-limit') | b64encode }}'
incus exec "$BUILDER" -- bash -euc "
    printf '%s' \"$GUEST_POWER_LIMIT_B64\" | base64 -d > /usr/local/sbin/nvidia-power-limit
    chmod 0755 /usr/local/sbin/nvidia-power-limit
    cat > /etc/systemd/system/nvidia-power-limit.service <<'EOF'
[Unit]
Description=Set NVIDIA GPU power limits (guest)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/nvidia-power-limit {{ '--max' if nvidia_power_limit_watts >= 600 else '' }}

[Install]
WantedBy=multi-user.target
EOF
    systemctl enable nvidia-power-limit.service 2>/dev/null || true
    systemctl enable nvidia-persistenced.service 2>/dev/null || true
"

echo "==> Stopping and publishing image..."
incus stop "$BUILDER"
# `incus publish --alias` refuses to overwrite an existing alias, so on
# --force we drop it first.
incus image alias delete "$ALIAS" 2>/dev/null || true
incus publish "$BUILDER" --alias "$ALIAS" \
    --compression zstd \
    description="Ubuntu 24.04 + NVIDIA open driver + CUDA ${CUDA_VERSION}"

echo "==> Done. Image '$ALIAS' is ready."
