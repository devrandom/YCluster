#!/usr/bin/env bash
# (Re)start the MiniMax-M3 MXFP4 server on stock vLLM (the b12x replacement).
# Run as the dev user (no sudo), e.g. after a reboot:
#
#   ~/bin/minimax-m3-stock-start.sh
#
# Idempotent: replaces any existing container. Uses GPUs 0-3 by default
# (override with GPUS). Managed by install-minimax-m3.yml - edit there. See
# docs/inference/minimax-m3-nvfp4-sm120.md for how this stack was derived.
#
# Key differences from the b12x stack:
#  - stock vllm-openai image + olka-fi MXFP4 checkpoint (Marlin weight-only
#    kernels on SM120) instead of the b12x CuTe NVFP4 fork.
#  - EAGLE3 speculative decoding is ON by default: stock's MSA backend keeps
#    FULL decode cudagraphs under spec-decode (the b12x backend couldn't),
#    which is where the 1.5-2.2x single-stream win comes from.
#  - one 3-line patch file bind-mounted over the image (clamp-limit fix,
#    generated by minimax-m3-stock-setup.sh; candidate for upstreaming).
#  - reasoning + tool-call parsers are 0.24's built-in minimax_m3 pair (same
#    behavior b12x had baked in: <mm:think> -> reasoning_content, and
#    tool_choice=auto works for Open-WebUI native tool calling).
#  - thinking_mode=enabled is the default chat-template kwarg ON PURPOSE: M3's
#    default (adaptive) system prompt contains a literal <mm:think></mm:think>
#    in its instructions, which defeats the reasoning parser's prompt scan and
#    leaks raw tags into STREAMED content (non-streaming is unaffected).
#    "enabled" prefills <mm:think> at the prompt end, so the scan lands on a
#    start marker and streaming parses correctly. Per-request
#    chat_template_kwargs still override.
set -euo pipefail

IMAGE="{{ minimax_m3_stock_image }}"
MODEL_HOST="${MODEL_HOST:-{{ minimax_m3_mxfp4_dir }}}"
CONTAINER="${CONTAINER:-minimax-m3-stock}"
PORT="${PORT:-9211}"
GPUS="${GPUS:-0 1 2 3}"
TP="${TP:-4}"
# First id is the established gateway id (kept for compat across the quant
# change), then the b12x-era alias, then the generic id.
SERVED_NAMES="${SERVED_NAMES:-{{ minimax_m3_stock_served_names }}}"
MAXLEN="${MAXLEN:-256000}"
# vLLM v1 preallocates pinned CPU buffers scaling with MAXSEQS x MAXLEN per
# worker; the 0.24 default MAXSEQS at 256k context OOM-kills a 31 GiB host
# (global OOM - pinned pages can't swap). 64 concurrent seqs is ample for us
# (the b12x recipe ran with 4). The vision encoder cache also scales with
# MAXLEN (~15 GiB GPU at 256k) - we serve text-only, so the run below zeroes
# image/video via --limit-mm-per-prompt, which skips the encoder entirely.
MAXSEQS="${MAXSEQS:-64}"
# Chunked-prefill chunk size (vLLM v1 default: 8192). Decodes are co-scheduled
# with prefill chunks — one decode iteration per engine step — so step time
# caps generation speed for everyone while a long prompt prefills. At 8192
# concurrent generation collapses to ~1-3 tok/s; measured at 1024 it holds
# ~5-15 tok/s (cold prefill ~2k tok/s). Below 1024 prefill throughput halves
# for little decode gain (Marlin MoE per-step cost is mostly fixed) and 512
# collides with spec-decode draft slots. See
# docs/inference/minimax-m3-nvfp4-sm120.md.
MAXBATCH="${MAXBATCH:-1024}"
GPU_UTIL="${GPU_UTIL:-0.90}"
PATCH_FILE="${PATCH_FILE:-{{ minimax_m3_stock_patch_dir }}/compressed_tensors_moe_w4a4_mxfp4.py}"
PATCH_TARGET=/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/compressed_tensors/compressed_tensors_moe/compressed_tensors_moe_w4a4_mxfp4.py
# Patched chat template (fixes orphaned tool message 400s). Bind-mounted over
# the image's built-in template; --chat-template overrides the checkpoint's
# tokenizer_config.json template.
CHAT_TEMPLATE="${CHAT_TEMPLATE:-/opt/inference/minimax-m3/chat-template.jinja}"
CHAT_TEMPLATE_TARGET="${CHAT_TEMPLATE_TARGET:-/opt/inference/minimax-m3/chat-template.jinja}"

# EAGLE3 speculative decoding - default ON (proven net win on this stack).
# M3_EAGLE3=0 to disable; SPECULATIVE_CONFIG overrides the whole JSON. Do NOT
# add attention_backend to the spec-config: vLLM picks the right drafter
# backend itself.
M3_EAGLE3="${M3_EAGLE3:-1}"
EAGLE3_DIR="${EAGLE3_DIR:-{{ minimax_m3_eagle3_dir }}}"
EAGLE3_REPO="{{ minimax_m3_eagle3_repo }}"
NUM_SPECULATIVE_TOKENS="${NUM_SPECULATIVE_TOKENS:-3}"

# Memory defaults adapt to host RAM (explicit env always overrides) - same
# rationale as the b12x script: cap a runaway to the cgroup, not the host.
# Stock's cold start is lighter (no torch.compile pass), so the low-RAM
# thread throttles are omitted.
host_ram_gib=$(awk '/MemTotal/{printf "%d", $2/1048576}' /proc/meminfo)
if [ "${host_ram_gib:-0}" -lt 40 ]; then
  MEM="${MEM:-26g}"
  MEMSWAP="${MEMSWAP:--1}"
else
  MEM="${MEM:-100g}"
  MEMSWAP="${MEMSWAP:-$MEM}"
fi

# pre-flight (no root needed)
podman image exists "$IMAGE" \
  || { echo "image $IMAGE missing - run: ~/bin/minimax-m3-stock-setup.sh" >&2; exit 1; }
[ -f "$MODEL_HOST/config.json" ] \
  || { echo "checkpoint missing at $MODEL_HOST - run: hf download {{ minimax_m3_mxfp4_repo }} --local-dir $MODEL_HOST" >&2; exit 1; }
[ -f "$PATCH_FILE" ] \
  || { echo "clamp patch missing at $PATCH_FILE - run: ~/bin/minimax-m3-stock-setup.sh" >&2; exit 1; }
[ -f "$CHAT_TEMPLATE" ] \
  || { echo "chat template missing at $CHAT_TEMPLATE - run install-minimax-m3.yml" >&2; exit 1; }

# EAGLE3 args split by side: the mount is a podman flag (before the image),
# the spec-config is a vllm flag (after "serve"). Both empty when disabled.
eagle_mount_args=()
eagle_serve_args=()
if [ "$M3_EAGLE3" != 0 ]; then
  [ -f "$EAGLE3_DIR/config.json" ] \
    || { echo "M3_EAGLE3 set but draft missing at $EAGLE3_DIR - run: hf download $EAGLE3_REPO --local-dir $EAGLE3_DIR" >&2; exit 1; }
  if [ -n "${SPECULATIVE_CONFIG:-}" ]; then
    spec_cfg="$SPECULATIVE_CONFIG"
  else
    spec_cfg='{"method":"eagle3","model":"/models/MiniMax-M3-EAGLE3","num_speculative_tokens":'"$NUM_SPECULATIVE_TOKENS"'}'
  fi
  eagle_mount_args=(-v "$EAGLE3_DIR":/models/MiniMax-M3-EAGLE3:ro)
  eagle_serve_args=(--speculative-config "$spec_cfg")
fi

dev_args=()
ngpu=0
for g in $GPUS; do dev_args+=(--device "nvidia.com/gpu=$g"); ngpu=$((ngpu + 1)); done
# CDI renumbers injected GPUs to a 0-based range.
cvd="$(seq -s, 0 $((ngpu - 1)))"

# SERVED_NAMES is deliberately word-split into multiple --served-model-name
# values.
name_args=()
for n in $SERVED_NAMES; do name_args+=("$n"); done

podman rm -f "$CONTAINER" >/dev/null 2>&1 || true
podman run -d --name "$CONTAINER" \
  "${dev_args[@]}" \
  --network=host --shm-size 32g \
  --security-opt seccomp=unconfined --group-add keep-groups \
  --ulimit stack=67108864:67108864 \
  --memory "$MEM" --memory-swap "$MEMSWAP" \
  -e CUDA_VISIBLE_DEVICES="$cvd" \
  -e VLLM_MARLIN_USE_ATOMIC_ADD=1 \
  -v "$MODEL_HOST":/models/MiniMax-M3-MXFP4:ro \
  "${eagle_mount_args[@]}" \
  -v "$PATCH_FILE":"$PATCH_TARGET":ro \
  -v "$CHAT_TEMPLATE":"$CHAT_TEMPLATE_TARGET":ro \
  --entrypoint vllm \
  "$IMAGE" \
  serve /models/MiniMax-M3-MXFP4 \
  --served-model-name "${name_args[@]}" \
  --tensor-parallel-size "$TP" --trust-remote-code \
  --kv-cache-dtype bfloat16 --block-size 128 \
  --max-model-len "$MAXLEN" --max-num-seqs "$MAXSEQS" \
  --max-num-batched-tokens "$MAXBATCH" \
  --gpu-memory-utilization "$GPU_UTIL" \
  --limit-mm-per-prompt '{"image":0,"video":0}' \
  --default-chat-template-kwargs '{"thinking_mode":"enabled"}' \
  --chat-template "$CHAT_TEMPLATE_TARGET" \
  --reasoning-parser minimax_m3 \
  --enable-auto-tool-choice --tool-call-parser minimax_m3 \
  --linear-backend marlin \
  "${eagle_serve_args[@]}" \
  --host 0.0.0.0 --port "$PORT"

eagle_state=$([ "$M3_EAGLE3" != 0 ] && echo "on (eagle3, spec=$NUM_SPECULATIVE_TOKENS)" || echo off)
echo "Started '$CONTAINER' on :$PORT (model ids: $SERVED_NAMES), GPUs [$GPUS], spec-decode $eagle_state. Load ~5 min (warm)."
echo "  watch:  podman logs -f $CONTAINER"
echo "  ready:  curl -fsS http://127.0.0.1:$PORT/v1/models"
