#!/usr/bin/env bash
# (Re)start the DeepSeek-V4-Flash inference server on the
# voipmonitor/vllm:lucifer image. Run as the dev user (no sudo), e.g. after
# a reboot:
#
#   ~/bin/ds4-start.sh
#
# Idempotent: replaces any existing container. Defaults are 1-1 with the
# validated 2×96GB recipe (Ovidiu Dan, "700 tok/s on 2x RTX Pro 6000",
# Jun 2026): TP=2, MTP on (probabilistic draft, 2 speculative tokens),
# FP8 KV, --max-model-len 262144, attention-backend SPARSE_MLA_SM120,
# moe-backend flashinfer_cutlass. Measured ~210 t/s single-stream, ~700 t/s
# aggregate at C10, ~10k t/s prefill aggregate. Managed by
# admin/install-deepseek-v4-flash.yml — edit there.
#
# Tunable knobs (env-var overrides):
#   GPUS / TP / MAX_MODEL_LEN / GPU_UTIL / MAX_NUM_SEQS / MAX_NUM_BATCHED_TOKENS
#   MTP / SPECULATIVE_TOKENS / DRAFT_SAMPLE_METHOD / SERVED_NAME / PORT / MEM
#
# The image is a Blackwell sm_120 fork with FP4-native MoE kernels
# (SPARSE_MLA_SM120 + flashinfer_cutlass); it runs the native FP4+FP8 mix
# weights directly — we do NOT use nvidia/DeepSeek-V4-Flash-NVFP4 (the
# NVIDIA re-quantization buys nothing on this fork).
set -euo pipefail

IMAGE="${IMAGE:-{{ ds4_image }}}"
MODEL_HOST="${MODEL_HOST:-{{ ds4_model_dir }}}"
CONTAINER="${CONTAINER:-ds4}"
PORT="${PORT:-{{ ds4_port }}}"
# CDI GPU indices — the host-visible ones (DS4 runs on the bare host, so this
# host must have at least 2 free host-visible cards; the rest may be bound to
# vfio-pci for a GPU VM). Override per-host via ds4_gpus in host_vars/<node>.yml.
GPUS="${GPUS:-{{ ds4_gpus | default('0 1') }}}"
TP="${TP:-2}"
MTP="${MTP:-1}"
SPECULATIVE_TOKENS="${SPECULATIVE_TOKENS:-2}"
DRAFT_SAMPLE_METHOD="${DRAFT_SAMPLE_METHOD:-probabilistic}"
# Lucifer validated defaults (2×96GB): FP8 KV, 256K context, 64 concurrent,
# 8K batched, 0.90 GPU util, graph cap 192 with MTP (64 without — auto below).
KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"
BLOCK_SIZE="${BLOCK_SIZE:-256}"
GPU_UTIL="${GPU_UTIL:-0.90}"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-262144}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-64}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-8192}"
SERVED_NAME="${SERVED_NAME:-{{ ds4_served_name }}}"
# Persistent JIT/autotune cache (FlashInfer autotune tables, DeepGEMM warmup,
# CUDA-graph capture). First run writes here (~5 min warmup); reusing the
# volume avoids the recompile.
CACHE_DIR="${CACHE_DIR:-{{ ds4_cache_dir | default('/home/dev/.cache/ds4-lucifer') }}}"
# Cgroup cap. The 160GB weights stream from disk (vLLM's safetensors loader
# reads shard-by-shard), so host RAM stays well under this ceiling; the cap
# is just to keep a runaway load from OOM-killing the host, not a real
# memory budget. The 744B GLM-5.2 b12x path uses 110g; we need ~80g for
# peak warmup (JIT compile + cudagraph capture working set).
MEM="${MEM:-80g}"

# pre-flight (no root needed)
podman image exists "$IMAGE" \
  || { echo "image $IMAGE missing - run: ~/bin/ds4-setup.sh" >&2; exit 1; }
[ -f "$MODEL_HOST/config.json" ] && [ -f "$MODEL_HOST/model.safetensors.index.json" ] \
  || { echo "checkpoint missing or incomplete at $MODEL_HOST - run: ~/bin/ds4-setup.sh" >&2; exit 1; }

mkdir -p "$CACHE_DIR"
dev_args=()
ngpu=0
for g in $GPUS; do dev_args+=(--device "nvidia.com/gpu=$g"); ngpu=$((ngpu + 1)); done
# CDI renumbers the injected GPUs to a 0-based range. lucifer's internal
# defaults assume the full first pair; we set it explicitly so a host that
# passes "2 3" still gets a contiguous in-container numbering.
cvd="$(seq -s, 0 $((ngpu - 1)))"

# Graph cap: 192 with MTP (the lucifer fork's MTP path captures up to 192
# shapes), 64 without. The wiki hardcodes 192 for the MTP-on case; mirror.
if [ -z "${MAX_CUDAGRAPH_CAPTURE_SIZE:-}" ]; then
  if [ "$MTP" = "1" ]; then MAX_CUDAGRAPH_CAPTURE_SIZE=192; else MAX_CUDAGRAPH_CAPTURE_SIZE=64; fi
fi

# Build speculative args. vLLM accepts either --spec-method/--spec-tokens
# (covers method + num_speculative_tokens only) or a single --speculative-config
# JSON blob (covers everything including draft_sample_method). We need
# draft_sample_method, so use the blob. The model's num_nextn_predict_layers=1
# makes the built-in MTP layers the draft; "deepseek_mtp" is the matching
# method in vllm.config.speculative.MTPModelTypes (lucifer's June 2026 image).
SPEC_ARGS=()
if [ "$MTP" = "1" ]; then
  SPEC_ARGS=(
    --speculative-config "{\"method\":\"deepseek_mtp\",\"num_speculative_tokens\":$SPECULATIVE_TOKENS,\"draft_sample_method\":\"$DRAFT_SAMPLE_METHOD\"}"
  )
fi

podman rm -f "$CONTAINER" >/dev/null 2>&1 || true

# --unsetenv NCCL_GRAPH_FILE / NCCL_GRAPH_DUMP_FILE: the lucifer image bakes
# these empty, which crashes the patched NCCL's ncclCommInitRank. The
# entrypoint bash also unsets them (and several B12X-related vars that the
# lucifer fork doesn't expect) — both belts and braces.
# --unsetenv VLLM_CACHE_DIR: lucifer wants /cache (mounted), not the image's
# baked default. Same rationale as the b12x path.
podman run -d --name "$CONTAINER" \
  "${dev_args[@]}" \
  --network=host --shm-size 32g \
  --security-opt seccomp=unconfined --group-add keep-groups \
  --ulimit memlock=-1:-1 \
  --ulimit stack=67108864:67108864 \
  --memory "$MEM" --memory-swap "$MEM" \
  --unsetenv NCCL_GRAPH_FILE --unsetenv NCCL_GRAPH_DUMP_FILE \
  --unsetenv VLLM_CACHE_DIR \
  -e CUDA_VISIBLE_DEVICES="$cvd" \
  -e SERVED_MODEL_NAME="$SERVED_NAME" \
  -e PORT="$PORT" \
  -e TP_SIZE="$TP" \
  -e KV_CACHE_DTYPE="$KV_CACHE_DTYPE" \
  -e BLOCK_SIZE="$BLOCK_SIZE" \
  -e GPU_MEMORY_UTILIZATION="$GPU_UTIL" \
  -e MAX_MODEL_LEN="$MAX_MODEL_LEN" \
  -e MAX_NUM_SEQS="$MAX_NUM_SEQS" \
  -e MAX_NUM_BATCHED_TOKENS="$MAX_NUM_BATCHED_TOKENS" \
  -e MAX_CUDAGRAPH_CAPTURE_SIZE="$MAX_CUDAGRAPH_CAPTURE_SIZE" \
  -e CUTE_DSL_ARCH=sm_120a \
  -e HF_HUB_OFFLINE=1 \
  -e NCCL_P2P_LEVEL=SYS \
  -e NCCL_PROTO=LL,LL128,Simple \
  -e NCCL_IB_DISABLE=1 \
  -e VLLM_PREFIX_CACHE_RETENTION_INTERVAL=4096 \
  -v "$MODEL_HOST":/model:ro \
  -v "$CACHE_DIR":/cache \
  "$IMAGE" /bin/bash -lc '
    set -euo pipefail
    unset NCCL_GRAPH_FILE NCCL_GRAPH_DUMP_FILE
    unset VLLM_ENABLE_PCIE_ALLREDUCE VLLM_PCIE_ALLREDUCE_BACKEND
    unset VLLM_CPP_AR_1STAGE_NCCL_CUTOFF VLLM_CPP_AR_IGNORE_CUTOFF_MAX_ROWS
    unset VLLM_RTX6K_FUSED_ALLREDUCE_ADD VLLM_RTX6K_FUSED_ALLREDUCE_ADD_END_BARRIER
    unset VLLM_CACHE_DIR
    exec vllm serve /model \
      --served-model-name "$SERVED_MODEL_NAME" \
      --trust-remote-code \
      --host 0.0.0.0 --port "$PORT" \
      --load-format auto \
      --tensor-parallel-size "$TP_SIZE" \
      --kv-cache-dtype "$KV_CACHE_DTYPE" \
      --block-size "$BLOCK_SIZE" \
      --gpu-memory-utilization "$GPU_MEMORY_UTILIZATION" \
      --max-model-len "$MAX_MODEL_LEN" \
      --max-num-seqs "$MAX_NUM_SEQS" \
      --max-num-batched-tokens "$MAX_NUM_BATCHED_TOKENS" \
      --max-cudagraph-capture-size "$MAX_CUDAGRAPH_CAPTURE_SIZE" \
      --compilation-config '\''{"cudagraph_mode":"FULL_AND_PIECEWISE","custom_ops":["all"]}'\'' \
      --async-scheduling \
      --no-scheduler-reserve-full-isl \
      --enable-chunked-prefill \
      --enable-prefix-caching \
      --enable-flashinfer-autotune \
      --attention-backend SPARSE_MLA_SM120 \
      --kernel-config.moe_backend flashinfer_cutlass \
      --tokenizer-mode deepseek_v4 \
      --tool-call-parser deepseek_v4 \
      --enable-auto-tool-choice \
      --reasoning-parser deepseek_v4 \
      --default-chat-template-kwargs.thinking=true \
      --default-chat-template-kwargs.reasoning_effort=high \
      "$@"
  ' "${SPEC_ARGS[@]}"

mtp_state=$([ "$MTP" = 1 ] && echo on || echo off)
echo "Started '$CONTAINER' on :$PORT (model id: $SERVED_NAME), GPUs [$GPUS] TP=$TP, MTP $mtp_state, max_model_len=$MAX_MODEL_LEN, gpu_util=$GPU_UTIL."
echo "  watch:  podman logs -f $CONTAINER"
echo "  ready:  curl -fsS http://127.0.0.1:$PORT/v1/models"
