#!/usr/bin/env bash
# (Re)start the DeepSeek-V4-Flash-0731 inference server on the Gilded Gnosis
# r16 DSpark image. Run as the dev user (no sudo), e.g. after a reboot:
#
#   ~/bin/ds4-start.sh
#
# Idempotent: replaces any existing container. Defaults match the verified r16
# K5 DSpark profile: TP2/DCP1, 5 draft tokens, InstantTensor loading, 128K
# context, 0.975 GPU memory target, FP8 KV, no native offload.
#
# Tunable knobs (env-var overrides):
#   GPUS / TP_SIZE / DCP_SIZE / MAX_MODEL_LEN / GPU_UTIL / MAX_NUM_SEQS
#   MAX_NUM_BATCHED_TOKENS / DSPARK_TOKENS / DSPARK_DEPTH_MODE / MODE / BACKEND
#   KV_OFFLOADING_SIZE / PORT / SERVED_NAME / MEM
#
# Release reference: https://github.com/local-inference-lab/rtx6kpro/blob/master/models/ds4dspark-v20.md
set -euo pipefail

IMAGE="${IMAGE:-{{ ds4_image }}}"
MODEL_HOST="${MODEL_HOST:-{{ ds4_model_dir }}}"
CONTAINER="${CONTAINER:-ds4-dspark}"
PORT="${PORT:-{{ ds4_port }}}"
# CDI GPU indices — the host-visible ones (DS4 runs on the bare host, so this
# host must have at least 2 free host-visible cards; the rest may be bound to
# vfio-pci for a GPU VM). Override per-host via ds4_gpus in host_vars/<node>.yml.
GPUS="${GPUS:-{{ ds4_gpus | default('0 1') }}}"
SERVED_NAME="${SERVED_NAME:-{{ ds4_served_name }}}"

# ---- r16 launcher defaults ----
# K5 DSpark profile: TP2/DCP1, 5 draft tokens, InstantTensor loading, 128K
# context, 0.975 GPU memory target, FP8 KV, no native offload. Matches the
# r16 release's K5 profile on the 2×RTX PRO 6000 Blackwell topology.
# Requires the 0731 checkpoint (config.json has the DSpark fields;
# safetensors don't have the stale `mtp.0.enorm.weight` key the r16
# speculator's load_weights can't map). See ds4-setup.sh --download.
MODE="${MODE:-dspark}"
BACKEND="${BACKEND:-b12x-a8}"
TP_SIZE="${TP_SIZE:-2}"
DCP_SIZE="${DCP_SIZE:-1}"
DSPARK_DEPTH_MODE="${DSPARK_DEPTH_MODE:-fixed}"
DSPARK_TOKENS="${DSPARK_TOKENS:-5}"
GPU_UTIL="${GPU_UTIL:-0.975}"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-131072}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-16}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-8192}"
LOAD_FORMAT="${LOAD_FORMAT:-instanttensor}"
INSTANTTENSOR_BACKEND="${INSTANTTENSOR_BACKEND:-BUFFERED}"
# Native CPU KV offload (GiB across all TP ranks). 0 disables it.
KV_OFFLOADING_SIZE="${KV_OFFLOADING_SIZE:-0}"
# Persistent JIT/autotune cache (FlashInfer autotune, DeepGEMM warmup,
# CUDA-graph capture). First run writes here; reuse avoids the recompile.
CACHE_DIR="${CACHE_DIR:-{{ ds4_cache_dir | default('/home/dev/.cache/ds4-r16') }}}"
# Cgroup cap. Peak warmup (JIT + cudagraph + model load) can spike high;
# InstantTensor (BUFFERED) reuses page-cache pages rather than host-RAM
# copies of the checkpoint, so peak stays manageable.
MEM="${MEM:-80g}"

# pre-flight (no root needed)
podman image exists "$IMAGE" \
  || { echo "image $IMAGE missing - run: ~/bin/ds4-setup.sh" >&2; exit 1; }
[ -f "$MODEL_HOST/config.json" ] && [ -f "$MODEL_HOST/model.safetensors.index.json" ] \
  || { echo "checkpoint missing or incomplete at $MODEL_HOST - run: ~/bin/ds4-setup.sh --download" >&2; exit 1; }

mkdir -p "$CACHE_DIR" "$CACHE_DIR/tmp"
dev_args=()
ngpu=0
for g in $GPUS; do dev_args+=(--device "nvidia.com/gpu=$g"); ngpu=$((ngpu + 1)); done
cvd="$(seq -s, 0 $((ngpu - 1)))"

# Model parent dir — the r16 entrypoint scans /root/models/ for an HF-style
# model directory. Our checkpoint is at DeepSeek-V4-Flash under the parent;
# mount so it appears at /root/models/DeepSeek-V4-Flash.
MODEL_PARENT="$(dirname "$MODEL_HOST")"

# Stop the previous-generation container (lucifer, named "ds4") so the port
# is free, but leave it in place as a fallback. Remove any prior run of the
# new container.
podman stop ds4 >/dev/null 2>&1 || true
podman rm -f "$CONTAINER" >/dev/null 2>&1 || true

# Deviations from the r16 Compose recipe (offline-cluster workarounds):
#   SERVED_MODEL_NAME=deepseek-v4-flash — our gateway routing key;
#     without this, MODE=dspark serves the model as "DeepSeek-V4-Flash-0731"
#     and local-ai-proxy (which expects "deepseek-v4-flash") can't route.
#   MODEL_PATH=/root/models/DeepSeek-V4-Flash — the launcher otherwise
#     picks "deepseek-ai/DeepSeek-V4-Flash-0731" and tries to fetch from
#     HF (this cluster has no HF egress). Pointing at the local mount
#     bypasses the HF lookup.
#   HF_HUB_OFFLINE=1 — belt-and-suspenders so vllm fails fast on any
#     stray HF call rather than stalling.
podman run -d --name "$CONTAINER" \
  --entrypoint /usr/local/bin/serve-ds4-flash.sh \
  "${dev_args[@]}" \
  --network=host \
  --ipc=host --init \
  --security-opt seccomp=unconfined --group-add keep-groups \
  --ulimit memlock=-1:-1 \
  --ulimit nofile=1048576:1048576 \
  --ulimit stack=67108864:67108864 \
  --memory "$MEM" --memory-swap "$MEM" \
  -e CUDA_VISIBLE_DEVICES="$cvd" \
  -e PORT="$PORT" \
  -e MODE="$MODE" \
  -e BACKEND="$BACKEND" \
  -e TP_SIZE="$TP_SIZE" \
  -e DCP_SIZE="$DCP_SIZE" \
  -e DSPARK_DEPTH_MODE="$DSPARK_DEPTH_MODE" \
  -e DSPARK_TOKENS="$DSPARK_TOKENS" \
  -e MAX_NUM_SEQS="$MAX_NUM_SEQS" \
  -e MAX_MODEL_LEN="$MAX_MODEL_LEN" \
  -e MAX_NUM_BATCHED_TOKENS="$MAX_NUM_BATCHED_TOKENS" \
  -e GPU_MEMORY_UTILIZATION="$GPU_UTIL" \
  -e LOAD_FORMAT="$LOAD_FORMAT" \
  -e INSTANTTENSOR_BACKEND="$INSTANTTENSOR_BACKEND" \
  -e KV_OFFLOADING_SIZE="$KV_OFFLOADING_SIZE" \
  -e SERVED_MODEL_NAME="$SERVED_NAME" \
  -e MODEL_PATH="/root/models/DeepSeek-V4-Flash" \
  -e HF_HUB_OFFLINE=1 \
  -v "$MODEL_PARENT":/root/models:ro \
  -v "$CACHE_DIR":/cache \
  -v "$CACHE_DIR/tmp":/container-tmp \
  "$IMAGE"

echo "Started '$CONTAINER' on :$PORT (model: $SERVED_NAME), GPUs [$GPUS], TP=$TP_SIZE DCP=$DCP_SIZE MODE=$MODE DSPARK_TOKENS=$DSPARK_TOKENS max_model_len=$MAX_MODEL_LEN gpu_util=$GPU_UTIL"
echo "  watch:  podman logs -f $CONTAINER"
echo "  ready:  curl -fsS http://127.0.0.1:$PORT/v1/models"
