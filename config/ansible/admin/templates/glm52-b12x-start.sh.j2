#!/usr/bin/env bash
# (Re)start the GLM-5.2 NVFP4 inference server on the dark-devotion b12x image.
# Run as the dev user (no sudo), e.g. after a reboot:
#
#   ~/bin/glm52-b12x-start.sh
#
# Idempotent: replaces any existing container. Defaults to the full box as
# PP=2 x TP=4 (all 8 GPUs) - the validated layout for the nvidia full-GLM on this
# no-NVLink node (~2.2x prefill vs flat TP=8); override GPUS / TP / PP / DCP for
# other layouts. Managed by install-glm52.yml - edit there.
# See docs/inference/glm-5.2-nvfp4-sm120-design-2026-06.md.
#
# This image is GLM-5.2-specific (dark-devotion = b12x + the DCP global-topk /
# topk-scores patch that fixes >8k-context corruption). It ships its own baked
# launch recipe at /usr/local/bin/serve-glm52.sh, which we drive directly rather
# than hand-roll vllm args - that script carries the validated env matrix and
# flags (B12X_MLA_SPARSE attention, b12x MoE + PCIe-allreduce, AOT compile, the
# index_topk pattern, glm45/glm47 parsers, DCP ag_rs, FULL_AND_PIECEWISE
# cudagraphs, max-model-len auto, fastsafetensors). We supply only the podman
# wrapper + a few env overrides:
#  - PYTHON_BIN=/opt/venv/bin/python: serve-glm52.sh defaults to a sibling .venv
#    that doesn't exist in the image; point it at the image's venv.
#  - CUDA_VISIBLE_DEVICES=0..N-1: CDI renumbers the injected GPUs to 0-based, so
#    override the script's 0-7 default to the actual in-container count.
#  - GLM51_DISABLE_MTP: gated off (DISABLE_MTP=1) - MTP is a measured net loss on
#    this checkpoint, for two compounding reasons. (1) The MTP draft doesn't
#    implement vLLM's SupportsPP, so it can't run under the default PP=2 (forces
#    PP=1 TP=8, giving up the 2.2x prefill win). (2) The checkpoint's MTP layer is
#    bf16/unquantized and b12x only does NVFP4, so the draft must run on a slow
#    generic kernel (MOE_SPEC_BACKEND=triton) - one 256-expert bf16 draft layer
#    costs ~a full main-model forward, so despite high acceptance (~85% on code)
#    decode came out ~26 t/s vs PP's ~39. Revisit only if an NVFP4-quantized MTP
#    checkpoint appears. (The old REAP checkpoint genuinely lacked usable MTP -
#    that's this flag's origin, not the nvidia weights.)
#  - --unsetenv NCCL_GRAPH_FILE: the image bakes it empty, which crashes the
#    patched NCCL's ncclCommInitRank (the entrypoint's own `unset` does the same).
#  - --memory cap: keep a runaway load OOM-killing the container, not the ~125 GiB
#    host (a co-resident attempt once panicked the node). fastsafetensors streams
#    shards direct-to-GPU, so real host use stays well under this ceiling.
#  - VLLM_SPARSE_INDEXER_MAX_LOGITS_MB: enlarge the b12x indexer workspace so long
#    agentic contexts (opencode) don't crash the engine; the image default
#    under-reserves and the workspace is locked after profiling (no runtime growth).
set -euo pipefail

IMAGE="${IMAGE:-{{ glm52_image }}}"
MODEL_HOST="${MODEL_HOST:-{{ glm52_model_dir }}}"
CONTAINER="${CONTAINER:-glm52-b12x}"
PORT="${PORT:-9212}"
TP="${TP:-4}"
# Decode-context-parallel degree. DCP shards the MLA KV across the group along the
# sequence dim - more KV/concurrency capacity, but every attention step pays a
# cross-GPU KV gather (ag_rs) over PCIe. On this no-NVLink box that comms tax is
# steep: measured 2026-06-30, dropping DCP 4->1 lifts single-stream decode 39->52
# t/s (+33%) and 64k prefill 1405->3864 t/s (+175%, TTFT 38s->14s) - and 1M context
# still fits (KV pool 1.16M tok, ~1.1x concurrency at full 1M; ~18 concurrent at
# 64k). DCP=1 is the default for this low-concurrency / interactive cluster; raise
# it (2 or 4) to trade single-stream latency for concurrency headroom at long
# context. See the speedup section in the design doc.
DCP="${DCP:-1}"
# Pipeline-parallel degree. PP=2 x TP=4 across the full box beats flat TP=8 on
# this no-NVLink hardware (~2.2x prefill, validated): PP trades TP's per-layer
# allreduce for one point-to-point hop between two stages, and prefill has the
# token-parallelism to keep the pipeline full. The recipe hardcodes
# --pipeline-parallel-size 1, so we re-pass it below (a benign vllm duplicate-key
# warning; the last value - ours - wins). Set PP=1 TP=8 for the flat layout.
PP="${PP:-2}"
GPUS="${GPUS:-0 1 2 3 4 5 6 7}"
GPU_UTIL="${GPU_UTIL:-0.9}"
SERVED_NAME="${SERVED_NAME:-{{ glm52_served_name }}}"
INDEXER_LOGITS_MB="${INDEXER_LOGITS_MB:-2048}"
# Persistent JIT/compile cache (torch.compile + AOT inductor graphs, b12x/triton/
# flashinfer kernels). The image's baked VLLM_CACHE_DIR/TORCH_EXTENSIONS_DIR point
# under /cache, so just mount it; survives the podman rm below.
CACHE_DIR="${CACHE_DIR:-/home/dev/.cache/glm52-vllm}"
# Full 744B nvidia checkpoint needs ~110g of cgroup headroom for the warmup peak
# (80g sufficed for the smaller REAP variant but OOMs the full one).
MEM="${MEM:-110g}"
# MTP speculative decode toggle (1=off). See the GLM51_DISABLE_MTP note above.
DISABLE_MTP="${DISABLE_MTP:-1}"
# Server-wide hard cap on generated output tokens per request. serve-glm52.sh
# forwards "$@" to `vllm serve`, and the image documents --generation-config
# max_new_tokens as "a server-wide limit on the number of output tokens for all
# requests"; --override-generation-config merges it onto the model's auto config
# (default sampling preserved). GLM-5.2's reasoning_content is ordinary generated
# output, so this bounds reasoning + answer together, not just the visible answer.
MAX_OUTPUT_TOKENS="${MAX_OUTPUT_TOKENS:-10000}"

# Optional recipe-env overrides, forwarded to serve-glm52.sh's same-named knobs
# only when set (left to the recipe's own defaults otherwise, so the image owns
# them). MAX_NUM_BATCHED_TOKENS (def 4096) packs more tokens per prefill step;
# MAX_NUM_SEQS (def 8) caps concurrent sequences. MOE_SPEC_BACKEND (def b12x) is
# the MTP draft's MoE kernel - the draft layer is bf16/unquantized and b12x only
# does NVFP4, so MTP needs MOE_SPEC_BACKEND=triton (or another unquantized-capable
# backend); NUM_SPECULATIVE_TOKENS (def 3) sets the MTP draft depth.
sched_env=()
[ -n "${MAX_NUM_BATCHED_TOKENS:-}" ] && sched_env+=(-e "MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS}")
[ -n "${MAX_NUM_SEQS:-}" ] && sched_env+=(-e "MAX_NUM_SEQS=${MAX_NUM_SEQS}")
[ -n "${MOE_SPEC_BACKEND:-}" ] && sched_env+=(-e "MOE_SPEC_BACKEND=${MOE_SPEC_BACKEND}")
[ -n "${NUM_SPECULATIVE_TOKENS:-}" ] && sched_env+=(-e "NUM_SPECULATIVE_TOKENS=${NUM_SPECULATIVE_TOKENS}")

# Escape hatch for extra `vllm serve` flags. serve-glm52.sh forwards "$@" to
# vllm serve, so anything here is appended verbatim (word-split intentionally) -
# for one-off experiments without rebuilding the image. (Note: the b12x NVFP4
# MoE kernel has no expert-parallel path, so --enable-expert-parallel is rejected
# at init; PP is the working comms-reduction lever, via the PP knob above.)
EXTRA_VLLM_ARGS="${EXTRA_VLLM_ARGS:-}"

# pre-flight (no root needed)
podman image exists "$IMAGE" \
  || { echo "image $IMAGE missing - run: ~/bin/glm52-b12x-setup.sh" >&2; exit 1; }
[ -f "$MODEL_HOST/config.json" ] \
  || { echo "checkpoint missing at $MODEL_HOST - run: HF_HUB_DISABLE_XET=1 hf download {{ glm52_repo }} --local-dir $MODEL_HOST" >&2; exit 1; }

# fastsafetensors needs a deduped checkpoint (this one redundantly stores its MTP
# shards across files, which fastsafetensors rejects as duplicate keys).
# glm52-b12x-setup.sh does the dedup; guard against serving before it ran - a
# non-indexed *.safetensors is the tell-tale of an un-deduped checkpoint.
if [ -f "$MODEL_HOST/model.safetensors.index.json" ]; then
  indexed="$(jq -r '.weight_map[]' "$MODEL_HOST/model.safetensors.index.json" | sort -u)"
  for f in "$MODEL_HOST"/*.safetensors; do
    b="$(basename "$f")"
    grep -qxF "$b" <<<"$indexed" \
      || { echo "checkpoint not deduped ($b not in index) - run: ~/bin/glm52-b12x-setup.sh" >&2; exit 1; }
  done
fi

mkdir -p "$CACHE_DIR"
dev_args=()
ngpu=0
for g in $GPUS; do dev_args+=(--device "nvidia.com/gpu=$g"); ngpu=$((ngpu + 1)); done
# CDI renumbers the injected GPUs to a 0-based range; serve-glm52.sh otherwise
# defaults CUDA_VISIBLE_DEVICES to 0-7, which is wrong for a partial-GPU container.
cvd="$(seq -s, 0 $((ngpu - 1)))"

podman rm -f "$CONTAINER" >/dev/null 2>&1 || true

podman run -d --name "$CONTAINER" \
  "${dev_args[@]}" \
  --network=host --shm-size 32g \
  --security-opt seccomp=unconfined --group-add keep-groups \
  --ulimit stack=67108864:67108864 \
  --memory "$MEM" --memory-swap "$MEM" \
  --unsetenv NCCL_GRAPH_FILE --unsetenv NCCL_GRAPH_DUMP_FILE \
  -e PYTHON_BIN=/opt/venv/bin/python \
  -e CUDA_VISIBLE_DEVICES="$cvd" \
  -e MODEL=/model \
  -e SERVED_MODEL_NAME="$SERVED_NAME" \
  -e HOST=0.0.0.0 -e PORT="$PORT" \
  -e TP_SIZE="$TP" -e DCP_SIZE="$DCP" \
  -e GPU_MEMORY_UTILIZATION="$GPU_UTIL" \
  -e GLM51_DISABLE_MTP="$DISABLE_MTP" \
  -e VLLM_SPARSE_INDEXER_MAX_LOGITS_MB="$INDEXER_LOGITS_MB" \
  "${sched_env[@]}" \
  -v "$MODEL_HOST":/model \
  -v "$CACHE_DIR":/cache \
  "$IMAGE" serve-glm52.sh \
    --override-generation-config "{\"max_new_tokens\":$MAX_OUTPUT_TOKENS}" \
    --pipeline-parallel-size "$PP" \
    $EXTRA_VLLM_ARGS

mtp_state=$([ "$DISABLE_MTP" = 1 ] && echo off || echo on)
echo "Started '$CONTAINER' on :$PORT (model id: $SERVED_NAME), GPUs [$GPUS] PP=$PP TP=$TP DCP=$DCP, MTP $mtp_state, max_new_tokens=$MAX_OUTPUT_TOKENS."
echo "  watch:  podman logs -f $CONTAINER"
echo "  ready:  curl -fsS http://127.0.0.1:$PORT/v1/models"
