[Unit]
Description=DeepSeek-V4.1-Flash inference API
Wants=network-online.target nvidia-persistenced.service
After=network-online.target nvidia-persistenced.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/dev
# The container definition lives in dev's rootless Podman storage. Start the
# existing container attached so systemd detects and restarts engine failures.
ExecStart=/usr/bin/systemd-run --scope --unit=ds41-flash-run /usr/sbin/runuser -u dev -- /usr/bin/podman start --attach ds41-flash
ExecStop=/usr/sbin/runuser -u dev -- /usr/bin/podman stop --time 60 ds41-flash
Restart=always
RestartSec=10
TimeoutStartSec=15min
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
