#!/usr/bin/env bash
# Stage the DeepSeek-V4.1-Flash-1017 checkpoint and pull the Karmic Kraken
# profile image. Run as the dev user:
#
#   ~/bin/ds41-setup.sh --download     # pull image + checkpoint (~510 GB)
#   ~/bin/ds41-setup.sh                # image pull + checkpoint verify
#   ~/bin/ds41-setup.sh --verify-only  # just verify staged checkpoint
#
# Image is digest-pinned from the blackwell-llm-docker container release
# receipt. Checkpoint is pinned to the 1017 revision (config-identical to
# 0909). The R36-era tokenizer patch is gone: the KK tokenizer accepts
# Responses API input_text/output_text part types upstream.
set -eu

IMAGE="{{ ds41_image }}"
IMAGE_TAG="{{ ds41_image_tag }}"
REPO="{{ ds41_repo }}"
REVISION="{{ ds41_revision }}"
MODEL_HOST="${MODEL_HOST:-{{ ds41_model_dir }}}"

action="setup"
while [ $# -gt 0 ]; do
  case "$1" in
    --download)     action="download"; shift ;;
    --verify-only)  action="verify-only"; shift ;;
    -h|--help)
      sed -n '2,11p' "$0"
      exit 0
      ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
done

command -v podman >/dev/null \
  || { echo "podman missing - run admin/setup-gpu-podman.yml first" >&2; exit 1; }

if [ "$action" != "verify-only" ]; then
  echo "== pull $IMAGE_TAG (digest $IMAGE) =="
  podman pull "$IMAGE"
  echo "  image ready: $IMAGE"
  echo
fi

if [ "$action" = "download" ]; then
  echo "== download $REPO @ $REVISION -> $MODEL_HOST =="
  HF_HUB_DISABLE_XET=1 uv tool run hf download "$REPO" \
    --revision "$REVISION" \
    --local-dir "$MODEL_HOST"
  echo
fi

if [ "$action" = "download" ] || [ "$action" = "verify-only" ]; then
  echo "== verify checkpoint revision =="
  trees_dir="$MODEL_HOST/.cache/huggingface/trees"
  if [ ! -d "$trees_dir" ]; then
    echo "no trees metadata at $trees_dir - run --download first" >&2
    exit 1
  fi
  got="$(ls "$trees_dir"/*.json 2>/dev/null \
        | xargs -n1 basename \
        | sed 's/\.json$//' \
        | sort -u \
        | head -1)"
  if [ -z "$got" ]; then
    echo "no trees metadata files at $trees_dir" >&2
    exit 1
  fi
  if [ "$got" != "$REVISION" ]; then
    echo "revision mismatch: expected $REVISION, got '$got'" >&2
    echo "  $MODEL_HOST contains a different HF revision" >&2
    exit 1
  fi
  echo "  revision OK: $got"
  echo
fi

if [ "$action" = "setup" ]; then
  if [ ! -f "$MODEL_HOST/config.json" ]; then
    echo "Checkpoint not found at $MODEL_HOST (~510 GB) - download it:"
    echo "  ~/bin/ds41-setup.sh --download"
    exit 0
  fi
  [ -f "$MODEL_HOST/model.safetensors.index.json" ] \
    || { echo "index missing at $MODEL_HOST/model.safetensors.index.json" >&2; exit 1; }

  # Verify architecture is deepseek_v41 (not the V4 model that lives at
  # DeepSeek-V4-Flash on other hosts).
  model_type="$(python3 -c "import json; print(json.load(open('$MODEL_HOST/config.json'))['model_type'])" 2>/dev/null || echo 'unknown')"
  if [ "$model_type" != "deepseek_v41" ]; then
    echo "expected model_type 'deepseek_v41', got '$model_type' in $MODEL_HOST/config.json" >&2
    exit 1
  fi

  echo
  echo "Start the server:  ~/bin/ds41-start.sh"
fi
