# Tetragon observe-only configuration, rendered by Ansible.
# Docs: docs/design/intrusion-detection.md
#
# Security posture:
#   - gRPC is served on a unix socket only; no TCP listener.
#   - Metrics bind to loopback only.
#   - Observe-only: no enforcement hooks are loaded.
#
# The event log is consumed by ids-forwarder; rotate via logrotate so
# disk usage stays bounded (retention matches the nginx/SSH access-log
# window per the design's IP-retention constraint).

# Serve gRPC on a unix socket only (proto prefix is required).
server-address: unix:///var/run/tetragon/tetragon.sock

# Metrics on loopback only; scraped by the existing Prometheus.
metrics-server: 127.0.0.1:2112
# Default health port :6789 collides with the Ceph monitor.
health-server-address: 127.0.0.1:6790
enable-event-metrics: false

# Export JSON events for ids-forwarder to consume.
export-filename: /var/log/tetragon/tetragon.log
# Group-readable so ids-forwarder (member of the tetragon group) can tail.
export-file-perm: 640
# Bounded retention: rotate daily, keep one week (the access-log window
# used for the IP-retention constraint), cap each file, compress.
export-file-rotation-interval: 24h
export-file-max-backups: 7
export-file-max-size-mb: 50
export-file-compress: true
# PROCESS_EXIT is intentionally omitted: the forwarder does not consume it,
# and exporting it doubles the event-log volume on several node types.
export-allowlist: '{"event_set":["PROCESS_EXEC","PROCESS_KPROBE"]}'
export-denylist: ''

# Do not include raw file contents or network payloads in events.
process-metadata: ''
enable-credentials-access: false
enable-path-resolution: true

# Watch the pinned policies directory; dropping a file there is how a
# policy ships (via Ansible), and tetragon picks it up on restart.
tracing-policy-dir: /etc/tetragon.d

# Event filters: drop noisy cluster-internal traffic. Keep the export set
# limited to event types the forwarder consumes; matching stays in the
# tracing policies.
filters:
  - tags-unset: ["cpu_clock"]
