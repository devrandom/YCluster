# Tetragon observe-only configuration, rendered by Ansible.
# Docs: docs/design/intrusion-detection.md
#
# Security posture:
#   - gRPC is served on a unix socket only; no TCP listener.
#   - Metrics bind to loopback only.
#   - Observe-only: no enforcement hooks are loaded.
#
# The event log is consumed by ids-forwarder; rotate via logrotate so
# disk usage stays bounded (retention matches the nginx/SSH access-log
# window per the design's IP-retention constraint).

# Serve gRPC on a unix socket only. Do not set --server-address (TCP).
server-address: /var/run/tetragon/tetragon.sock

# Metrics on loopback only; scraped by the existing Prometheus.
metrics-address: 127.0.0.1:2112
enable-event-metrics: false

# Export JSON events for ids-forwarder to consume.
export-filename: /var/log/tetragon/tetragon.log
export-allowlist: '{"event_set":["PROCESS_EXEC","PROCESS_EXIT","PROCESS_KPROBE","PROCESS_CONNECT"]}'
export-denylist: ''

# Do not include raw file contents or network payloads in events.
process-metadata: ''
enable-credentials-access: false
enable-path-resolution: true

# Watch the pinned policies directory; dropping a file there is how a
# policy ships (via Ansible), and tetragon picks it up on restart.
policies-dir: /etc/tetragon.d

# Event filters: drop noisy cluster-internal traffic. Tuning happens in
# the tracing policies themselves, not here.
filters:
  - tags-unset: ["cpu_clock"]
