# Central Prometheus configuration for long-term storage
global:
  scrape_interval: 30s
  evaluation_interval: 30s
  external_labels:
    cluster: 'ycluster'
    prometheus: 'central'

rule_files:
  - "/etc/prometheus/rules/ycluster-federated-alerts.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
{% for host in groups['core'] %}
          - {{ hostvars[host]['ansible_host'] }}:9093
{% endfor %}

scrape_configs:
  # Federation from local Prometheus instances
  - job_name: 'prometheus-federation'
    scrape_interval: 30s
    honor_labels: true
    metrics_path: '/federate'
    params:
      'match[]':
        # Federate the full node_exporter feed so Node Exporter Full
        # (dashboard 1860) and similar broad dashboards have 90-day
        # history. ~600 series per host × ~13 hosts = ~7800 series,
        # ~120 MB/day after TSDB compression — fits easily in the 40 GB
        # central budget.
        - '{__name__=~"node_.*"}'
        - '{__name__=~"up|prometheus_.*|ycluster_.*"}'
        - 'prometheus_tsdb_head_samples_appended_total'
        - 'prometheus_tsdb_compaction_duration_seconds'
        - 'prometheus_http_requests_total'
        - '{job=~"ycluster-.*"}'
        - '{__name__=~"ceph_cluster_.*"}'
        - '{__name__=~"ceph_health_.*"}'
        - '{__name__=~"ceph_mon_.*"}'
        - '{__name__=~"ceph_osd_.*"}'
        - '{__name__=~"ceph_pool_.*"}'
        - '{__name__=~"ceph_pg_.*"}'
        - '{__name__=~"ceph_rbd_.*"}'
        - '{__name__=~"ceph_mgr_.*"}'
    static_configs:
{% for host in groups['core'] %}
      - targets: ['{{ hostvars[host]['ansible_host'] }}:9090']
        labels:
          federated_from: '{{ host }}'
{% endfor %}

  # HTTPS-domain probing. Owned here (and only here) so the public site is
  # probed once cluster-wide instead of from every core Prometheus. Per-target
  # module is set via file_sd labels (see update-blackbox-targets.py, which
  # runs on every core node and keeps this shared file fresh on the leader).
  - job_name: 'https-domain'
    scheme: https
    tls_config:
      ca_file: /etc/blackbox_exporter/tls/ca.crt
      cert_file: /etc/blackbox_exporter/tls/server.crt
      key_file: /etc/blackbox_exporter/tls/server.key
      insecure_skip_verify: false
    metrics_path: /probe
    file_sd_configs:
      - files:
        - '/etc/prometheus/blackbox-targets.json'
        refresh_interval: 30s
    relabel_configs:
      - source_labels: [__param_target]
        target_label: instance
      - source_labels: [module]
        target_label: __param_module

  # Direct scraping of critical services (backup)
  - job_name: 'ycluster-health-central'
    metrics_path: '/metrics'
    scrape_interval: 60s
    static_configs:
{% for host in groups['core'] %}
      - targets: ['{{ hostvars[host]['ansible_host'] }}:12724']
        labels:
          node: '{{ host }}'
          node_type: 'core'
{% endfor %}
