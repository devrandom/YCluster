global:
  # No SMTP configuration - using webhooks only

route:
  # IDS alerts carry host/rule_id; other alerts leave them empty. Grouping on
  # both keeps one host's rule separate from the same rule on another host.
  group_by: ['alertname', 'host', 'rule_id', 'instance', 'domain', 'provider', 'account']
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h
  receiver: 'default'
  routes:
    # IDS paging. The forwarder decides the delivery class and sets `page`
    # from the threat model; this file only maps severity to a receiver. See
    # docs/design/ids-coverage-and-evidence.md. A forwarder that predates the
    # label emits no `page`, so it falls through to ids-silent below: a stale
    # binary goes quiet rather than noisy, and IdsForwarderSchemaStale makes
    # that state visible.
    - match:
        alertname: 'IDSAlert'
        page: 'yes'
        severity: 'critical'
      receiver: 'critical-alerts'
      group_wait: 5s
      repeat_interval: 30m
    - match:
        alertname: 'IDSAlert'
        page: 'yes'
        severity: 'warning'
      receiver: 'warning-alerts'
      repeat_interval: 2h
    # Everything else in the IDS class stays observe-only: recorded in
    # Alertmanager and in detections.jsonl, delivered nowhere. That is every
    # coverage class still waiting for its shadow measurement, the Incus audit
    # stream, and the bridge-guard blocks (vm-bridge-*), which are counted per
    # guest and reviewed rather than paged. Coverage alerts such as
    # TetragonDown are not IDSAlert at all and route by their own severity.
    - match:
        alertname: 'IDSAlert'
      receiver: 'ids-silent'
      repeat_interval: 24h
    # Perimeter CVE alerts (osv-feed) repeat daily so an unresolved
    # no_fix_yet/fix_available CVE stays visible instead of being
    # swallowed by the shorter global repeat_interval. Severity still picks
    # the receiver via the nested routes.
    - match:
        perimeter_cve: 'true'
      repeat_interval: 24h
      routes:
        - match:
            severity: critical
          receiver: 'critical-alerts'
        - match:
            severity: warning
          receiver: 'warning-alerts'
    - match:
        severity: critical
      receiver: 'critical-alerts'
      group_wait: 5s
      repeat_interval: 30m
    # Slow-repeat alerts (e.g. held packages pending a deliberate maintenance
    # window) still notify, but only re-page daily instead of every 2h. Must be
    # matched before the generic warning route below, which would otherwise
    # win (Alertmanager routes to the first matching sibling).
    - match:
        slow_repeat: 'true'
      receiver: 'warning-alerts'
      repeat_interval: 24h
    # Balance warnings are grouped per provider/account and should stay
    # visible without being noisy.
    - match:
        slow_repeat: '12h'
      receiver: 'warning-alerts'
      repeat_interval: 12h
    - match:
        severity: warning
      receiver: 'warning-alerts'
      repeat_interval: 2h

# Keep the receiver local: Alertmanager HA deliberately races for availability,
# so cross-host suppression belongs in the webhook (which dedupes via etcd when
# available and fails open when it does not).
receivers:
  - name: 'default'
    # Default receiver - can be configured later
    webhook_configs:
      - url: 'http://localhost:9095/webhook'
        send_resolved: true

  - name: 'ids-silent'
    # No integrations: IDS alerts stay visible in the Alertmanager UI/API
    # during the tuning window but are not delivered to anyone.

  - name: 'critical-alerts'
    # Critical alerts - immediate notification via ntfy webhook handler
    webhook_configs:
      - url: 'http://localhost:9095/webhook'
        send_resolved: true
      - url: 'http://localhost:12723/api/alert-webhook'
        send_resolved: true

  - name: 'warning-alerts'
    # Warning alerts - less frequent notifications via ntfy webhook handler
    webhook_configs:
      - url: 'http://localhost:9095/webhook'
        send_resolved: true
      - url: 'http://localhost:12723/api/alert-webhook'
        send_resolved: true

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    # node is present on the infrastructure alerts; host/rule_id are present
    # on IDS alerts. Missing labels compare equal, so include all four: a
    # critical IDS alert then inhibits only the same rule on the same host,
    # not every warning IDS alert in the cluster.
    equal: ['alertname', 'node', 'host', 'rule_id']

  - source_match:
      alertname: 'NodeDown'
    target_match_re:
      alertname: '.*'
    equal: ['node']
