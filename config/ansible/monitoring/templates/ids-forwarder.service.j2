[Unit]
Description=IDS forwarder (Tetragon/CrowdSec -> Alertmanager)
After=network-online.target rsigma.service
Wants=network-online.target rsigma.service

[Service]
Type=simple
ExecStart=/usr/local/bin/ids-forwarder \
    -alertmanager-url {{ ids_forwarder_alertmanager_url }} \
    -tetragon-log {{ ids_forwarder_tetragon_log }} \
    -events {{ ids_forwarder_events }} \
    -exec-binaries {{ ids_forwarder_exec_binaries }} \
    -metrics-listen {{ ids_forwarder_metrics_listen }} \
    -cursor-file {{ ids_forwarder_cursor_file }} \
    -spool-file {{ ids_forwarder_spool_file }} \
    -spool-max-bytes {{ ids_forwarder_spool_max_bytes }} \
    -detections-file {{ ids_forwarder_detections_file }} \
    -detections-max-bytes {{ ids_forwarder_detections_max_bytes }} \
    -detections-keep {{ ids_forwarder_detections_keep }} \
    -sigma-socket {{ ids_forwarder_sigma_socket }} \
    -sigma-detections {{ ids_forwarder_sigma_detections }} \
    -sigma-cursor {{ ids_forwarder_sigma_cursor }} \
    -max-event-age {{ ids_forwarder_max_event_age }} \
    -startup-grace {{ ids_forwarder_startup_grace }} \
    -http-listen {{ ids_forwarder_http_listen }}
Restart=on-failure
RestartSec=5
# Hardening: no inbound listener beyond the optional localhost receiver;
# the process only needs to read the Tetragon event log and reach
# Alertmanager over loopback/WireGuard.
User=ids-forwarder
Group=ids-forwarder
StateDirectory=ids-forwarder
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths={{ ids_forwarder_tetragon_log | dirname }}
ReadWritePaths={{ ids_forwarder_state_dir }}

[Install]
WantedBy=multi-user.target
