[Unit]
Description=Tetragon eBPF-based security observability
Documentation=https://tetragon.io/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Files created by tetragon (event log) get this group so the
# ids-forwarder user can read them.
Group=tetragon
ExecStart=/usr/local/bin/tetragon --health-server-address=127.0.0.1:6790
Restart=on-failure
RestartSec=5
RuntimeDirectory=tetragon

# Tetragon needs broad privileges to attach eBPF programs and read
# kernel state (bpffs, tracefs, BTF). Run as root with full caps:
# this systemd mis-translates the CAP_BPF/CAP_PERFMON names, so a
# restricted CapabilityBoundingSet drops exactly the caps the sensor
# needs (verified: it granted MAC_* instead).
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
