# Prometheus configuration for YCluster local monitoring
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: 'ycluster'

rule_files:
  - "/etc/prometheus/rules/ycluster-alerts*.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
          - localhost:9093
{% for host in groups['core'] %}
{% if host != inventory_hostname %}
          - {{ hostvars[host]['ansible_host'] }}:9093
{% endif %}
{% endfor %}

scrape_configs:
  # Scrape Prometheus itself
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
        labels:
          node: '{{ ansible_hostname }}'

  # Dynamic scrape targets via the local admin API.
  #
  # /api/prometheus/targets/<job> returns Prometheus http_sd format and
  # filters out hosts marked disabled in etcd (via `ycluster cluster
  # disable <host>`). Disabling a host takes effect on the next refresh
  # (refresh_interval below) — no ansible re-run required.

  - job_name: 'node-exporter'
    http_sd_configs:
      - url: 'http://127.0.0.1:12723/api/prometheus/targets/node-exporter'
        refresh_interval: 30s

  - job_name: 'ycluster-health'
    metrics_path: '/metrics'
    http_sd_configs:
      - url: 'http://127.0.0.1:12723/api/prometheus/targets/ycluster-health'
        refresh_interval: 30s

  - job_name: 'ycluster-dhcp'
    metrics_path: '/metrics'
    http_sd_configs:
      - url: 'http://127.0.0.1:12723/api/prometheus/targets/ycluster-dhcp'
        refresh_interval: 30s

  - job_name: 'ceph-exporter'
    http_sd_configs:
      - url: 'http://127.0.0.1:12723/api/prometheus/targets/ceph-exporter'
        refresh_interval: 30s

  # vLLM backends expose Prometheus metrics natively on the same port
  # as /v1/. Discover them from the inference registry instead of a static
  # list: the admin API probes each registered backend's /v1/models and
  # returns only those reporting owned_by=vllm. It also sets the `backend`
  # label in the same URL form as local_ai_proxy_* metrics, so cross-metric
  # joins work. Discovery is cached for 60s; a backend that is down at
  # refresh time drops out until it answers /v1/models again.
  - job_name: 'vllm'
    metrics_path: '/metrics'
    scrape_interval: 15s
    http_sd_configs:
      - url: 'http://127.0.0.1:12723/api/prometheus/targets/vllm'
        refresh_interval: 30s
    metric_relabel_configs:
      # Rename model_name -> model so joins with proxy metrics work.
      - source_labels: [model_name]
        target_label: model
      - regex: 'model_name'
        action: labeldrop

  # SGLang exposes `sglang:*` metrics on /metrics when started with
  # --enable-metrics. It negotiates OpenMetrics with escaping=underscores,
  # so Prometheus stores those names as `sglang_*` — query the underscore
  # form. Discovery is identical to the vLLM job: the admin API probes each
  # registered backend's /v1/models and returns owned_by=sglang.
  - job_name: 'sglang'
    metrics_path: '/metrics'
    scrape_interval: 15s
    http_sd_configs:
      - url: 'http://127.0.0.1:12723/api/prometheus/targets/sglang'
        refresh_interval: 30s
    metric_relabel_configs:
      # SGLang labels the served model as model_name too.
      - source_labels: [model_name]
        target_label: model
      - regex: 'model_name'
        action: labeldrop

  # local-ai-proxy (inference gateway). Deployed on every storage node
  # but only the storage leader actually runs the service; standbys
  # report up=0, which is itself a useful signal. When the VIP fails
  # over to a different storage host, that host flips to up=1 and the
  # previous one to up=0. Scrapes the dedicated metrics listener
  # ({{ inference_proxy_metrics_port }}) — the API listener is loopback-only.
  - job_name: 'inference-proxy'
    metrics_path: '/metrics'
    scrape_interval: 15s
    static_configs:
{% for host in groups['storage'] | default([]) %}
      - targets: ['{{ hostvars[host]['ansible_host'] }}:{{ inference_proxy_metrics_port }}']
        labels:
          node: '{{ host }}'
{% endfor %}

  # Blackbox exporter itself with TLS. Note: the HTTPS-domain probe job no
  # longer runs here — it moved to the single central Prometheus (see
  # prometheus-central.yml.j2) so the public site is probed once instead of
  # from every core node. This job only tracks local exporter up/down.
  - job_name: 'blackbox-exporter'
    scheme: https
    tls_config:
      ca_file: /etc/blackbox_exporter/tls/ca.crt
      cert_file: /etc/blackbox_exporter/tls/server.crt
      key_file: /etc/blackbox_exporter/tls/server.key
      insecure_skip_verify: false
    static_configs:
      - targets: ['localhost:9115']
{% for host in groups['core'] %}
{% if host != inventory_hostname %}
      - targets: ['{{ hostvars[host]['ansible_host'] }}:9115']
        labels:
          node: '{{ host }}'
{% endif %}
{% endfor %}
{% if groups['frontend'] is defined %}
{% for host in groups['frontend'] %}
      - targets: ['{{ hostvars[host]['ansible_host'] }}:9115']
        labels:
          node: '{{ host }}'
          node_type: 'frontend'
{% endfor %}
{% endif %}

  # IDS components, all loopback-only on their own node. The coverage
  # alerts in ycluster-alerts.yml rely on these jobs: a down sensor is a
  # coverage gap, not just a missing metric. See
  # docs/design/intrusion-detection.md.
  - job_name: 'tetragon'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['localhost:2112']
        labels:
          node: '{{ ansible_hostname }}'

  - job_name: 'crowdsec'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['localhost:6060']
        labels:
          node: '{{ ansible_hostname }}'

  - job_name: 'ids-forwarder'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['localhost:2113']
        labels:
          node: '{{ ansible_hostname }}'

