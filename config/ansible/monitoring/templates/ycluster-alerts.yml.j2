{#- Per-node overrides come from Ansible host_vars:
   ambient_temperature_warn and ambient_temperature_critical. -#}
{% set ambient_warn_overrides = {} -%}
{% set ambient_critical_overrides = {} -%}
{%- for host in groups['all'] -%}
  {%- set warn = hostvars[host].get('ambient_temperature_warn') -%}
  {%- set critical = hostvars[host].get('ambient_temperature_critical') -%}
  {%- if warn is not none -%}
    {%- set _ = ambient_warn_overrides.update({host: warn}) -%}
  {%- endif -%}
  {%- if critical is not none -%}
    {%- set _ = ambient_critical_overrides.update({host: critical}) -%}
  {%- endif -%}
{%- endfor -%}
{% macro ambient_temp_expr(overrides, default_threshold) -%}
{%- set override_nodes = overrides.keys() | sort -%}
{%- set default_selector = 'node!~"' ~ (override_nodes | join('|')) ~ '"' if override_nodes else '' -%}
{%- set exprs = [
  'max by (node) (node_ipmi_temperature_celsius{role="ambient"' ~ (', ' ~ default_selector if default_selector else '') ~ '}) > ' ~ default_threshold,
  'max by (node) (node_comino_temperature_celsius{role="ambient"' ~ (', ' ~ default_selector if default_selector else '') ~ '}) > ' ~ default_threshold
] -%}
{%- for node in override_nodes -%}
  {%- set threshold = overrides[node] -%}
  {%- set _ = exprs.append('max by (node) (node_ipmi_temperature_celsius{role="ambient", node="' ~ node ~ '"}) > ' ~ threshold) -%}
  {%- set _ = exprs.append('max by (node) (node_comino_temperature_celsius{role="ambient", node="' ~ node ~ '"}) > ' ~ threshold) -%}
{%- endfor -%}
[% exprs | join('\n          or\n          ') %]
{%- endmacro -%}

groups:
  - name: ycluster-core
    rules:
      # Node availability
      - alert: NodeDown
        expr: up{job="node-exporter"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Node {{ $labels.node }} is down"
          description: "Node {{ $labels.node }} has been down for more than 1 minute"

      # Any systemd unit in failed state — silent unit failures otherwise
      # surface only on manual journalctl inspection. Known-benign
      # offenders are cleared/masked by clear-benign-failed-units.yml.
      - alert: SystemdUnitFailed
        expr: node_systemd_unit_state{state="failed"} == 1
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Unit {{ $labels.name }} failed on {{ $labels.node }}"
          description: "systemd unit {{ $labels.name }} on {{ $labels.node }} ({{ $labels.instance }}) has been in failed state for more than 15 minutes"

      # Apt jobs can hang without entering failed state (for example while
      # waiting on a mirror or a lock). Catch long-running units explicitly.
      # unattended-upgrades.service is a persistent shutdown helper, not the
      # upgrade job, so it must not be treated as a hung apt run.
      - alert: AptJobHung
        expr: node_systemd_unit_state{name=~"apt-daily.service|apt-daily-upgrade.service",state="active"} == 1
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "Apt job hung on {{ $labels.node }}"
          description: "{{ $labels.name }} on {{ $labels.node }} has been active for more than 1h"

      # Apt and dpkg locks are normally held for seconds or minutes. A lock
      # held for half an hour either means a very large install is running
      # or something is wedged; DPkg::Lock::Timeout makes the wedge case fail
      # fast, so a lasting lock is worth seeing.
      - alert: AptLockHeld
        expr: ycluster_apt_lock_held > 0
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "Apt lock held on {{ $labels.node }}"
          description: "The {{ $labels.lock }} lock on {{ $labels.node }} has been held for over 30m"

      # update-success-stamp is touched only after a successful apt update.
      # Missing stamps are reported as an age equal to the current timestamp.
      # apt-cache-update.timer refreshes every 12h, so 24h gives a 2x margin.
      - alert: AptCacheStale
        expr: ycluster_apt_update_age_seconds > 24 * 3600
        for: 1h
        labels:
          severity: warning
          slow_repeat: "true"
        annotations:
          summary: "Apt cache stale on {{ $labels.node }}"
          description: "The apt cache on {{ $labels.node }} has not successfully updated in over 24h"

      # The collector itself runs every 15m; a missing/aged textfile means the
      # apt freshness signal is absent and should not be silently ignored.
      - alert: AptMetricsStale
        expr: time() - node_textfile_mtime_seconds{file="/var/lib/prometheus/node-exporter/apt_status.prom"} > 1800
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Apt metrics collector stale on {{ $labels.node }}"
          description: "apt_status.prom on {{ $labels.node }} has not been updated in over 30m"

      # YCluster health API
      - alert: YClusterHealthAPIDown
        expr: up{job="ycluster-health"} == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "YCluster health API down on {{ $labels.node }}"
          description: "YCluster health API on {{ $labels.node }} has been down for more than 2 minutes"


      # Multiple DHCP servers (split brain)
      - alert: MultipleDHCPServers
        expr: count(up{job="ycluster-dhcp"} == 1) > 1
        for: 30s
        labels:
          severity: warning
        annotations:
          summary: "Multiple DHCP servers detected"
          description: "{{ $value }} DHCP servers are running - possible split brain condition"

      # No DHCP servers (handles missing metrics)
      - alert: NoDHCPServers
        expr: absent(up{job="ycluster-dhcp"} == 1) or count(up{job="ycluster-dhcp"} == 1) == 0
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "No DHCP servers running"
          description: "No DHCP servers are responding in the cluster"

      # High CPU usage
      - alert: HighCPUUsage
        expr: 100 - (avg by(node) (irate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 80
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High CPU usage on {{ $labels.node }}"
          description: "CPU usage on {{ $labels.node }} is above 80% for more than 5 minutes"

      # High memory usage
      - alert: HighMemoryUsage
        expr: (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100 > 85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High memory usage on {{ $labels.node }}"
          description: "Memory usage on {{ $labels.node }} is above 85% for more than 5 minutes"

      # Low disk space
      - alert: LowDiskSpace
        expr: (1 - (node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"})) * 100 > 85
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Low disk space on {{ $labels.node }}"
          description: "Disk usage on {{ $labels.node }} root filesystem is above 85%"

      # Critical disk space
      - alert: CriticalDiskSpace
        expr: (1 - (node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"})) * 100 > 95
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Critical disk space on {{ $labels.node }}"
          description: "Disk usage on {{ $labels.node }} root filesystem is above 95%"

      # Offsite backup disk (not a scraped node; metric written to the storage
      # leader's node-exporter textfile by backup-databases).
      - alert: LowOffsiteDiskSpace
        expr: ycluster_offsite_disk_used_percent > 85
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Low disk space on offsite destination {{ $labels.destination }}"
          description: "Offsite backup destination {{ $labels.destination }} disk is at {{ $value }}% used"

      - alert: CriticalOffsiteDiskSpace
        expr: ycluster_offsite_disk_used_percent > 95
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Critical disk space on offsite destination {{ $labels.destination }}"
          description: "Offsite backup destination {{ $labels.destination }} disk is at {{ $value }}% used"

      # Load average
      - alert: HighLoadAverage
        expr: node_load15 / count by(node) (node_cpu_seconds_total{mode="idle"}) > 2
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "High load average on {{ $labels.node }}"
          description: "Load average on {{ $labels.node }} is {{ $value }} (normalized by CPU count) for more than 10 minutes"

      # High external network ingress bandwidth (10GB/hr = ~22.2 Mbps)
      - alert: HighNetworkIngress
        expr: rate(node_network_receive_bytes_total{device="enp87s0"}[5m]) * 8 > 22222222
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "High external network ingress on {{ $labels.node }}"
          description: "External network ingress on {{ $labels.node }} interface {{ $labels.device }} is {{ $value | humanize }}bps (>10GB/hr) for more than 2 minutes"

      # High external network egress bandwidth (1GB/hr = ~2.2 Mbps)
      - alert: HighNetworkEgress
        expr: rate(node_network_transmit_bytes_total{device="enp87s0"}[5m]) * 8 > 2222222
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "High external network egress on {{ $labels.node }}"
          description: "External network egress on {{ $labels.node }} interface {{ $labels.device }} is {{ $value | humanize }}bps (>1GB/hr) for more than 2 minutes"

      # Critical external network ingress bandwidth
      - alert: CriticalNetworkIngress
        expr: rate(node_network_receive_bytes_total{device="enp87s0"}[5m]) * 8 > 800000000
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "Critical external network ingress on {{ $labels.node }}"
          description: "External network ingress on {{ $labels.node }} interface {{ $labels.device }} is {{ $value | humanize }}bps - approaching gigabit limit"

      # Critical external network egress bandwidth
      - alert: CriticalNetworkEgress
        expr: rate(node_network_transmit_bytes_total{device="enp87s0"}[5m]) * 8 > 800000000
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Critical external network egress on {{ $labels.node }}"
          description: "External network egress on {{ $labels.node }} interface {{ $labels.device }} is {{ $value | humanize }}bps - approaching gigabit limit"

  - name: ycluster-services
    rules:
      # Clock-skew service health uses node-specific warning/critical bands.
      # Metric ordinals: healthy=0, warning=1, critical/error=2.
      - alert: ClockSkewWarning
        expr: ycluster_service_health{service="clock_skew"} == 1
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Clock skew warning on {{ $labels.node }}"
          description: "Clock offset on {{ $labels.node }} has exceeded its warning threshold for more than 10 minutes"

      - alert: ClockSkewCritical
        expr: ycluster_service_health{service="clock_skew"} >= 2
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Clock skew critical on {{ $labels.node }}"
          description: "Clock offset on {{ $labels.node }} has exceeded its critical threshold, or the skew check failed, for more than 5 minutes"

      # etcd cluster health - grouped by service to show cluster-wide status
      - alert: EtcdClusterUnhealthy
        expr: count(ycluster_service_health{service="etcd"} >= 2) >= 2
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "etcd cluster unhealthy"
          description: "etcd cluster is reporting unhealthy status on {{ $value }} nodes"

      # Ceph cluster health - grouped by service to show cluster-wide status
      - alert: CephClusterDegraded
        expr: count(ycluster_service_health{service="ceph"} >= 1) >= 2
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "Ceph cluster degraded"
          description: "Ceph cluster is reporting degraded status on {{ $value }} nodes"

      - alert: CephClusterUnhealthy
        expr: count(ycluster_service_health{service="ceph"} >= 2) >= 2
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Ceph cluster unhealthy"
          description: "Ceph cluster is reporting unhealthy status on {{ $value }} nodes"

      # A single OSD down: ceph health can stay OK (auto-out + full
      # replication), which the cluster-level CephCluster* alerts miss.
      # ceph_exporter exposes ceph_osd_up (1=up, 0=down) per OSD.
      - alert: CephOSDDown
        expr: ceph_osd_up == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Ceph OSD {{ $labels.ceph_daemon }} is down"
          description: "OSD {{ $labels.ceph_daemon }} on {{ $labels.instance }} has been down for more than 5 minutes"

      # Leadership alerts
      - alert: NoStorageLeader
        expr: sum(ycluster_storage_leader) == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "No storage leader elected"
          description: "No node is currently the storage leader"

      - alert: MultipleStorageLeaders
        expr: sum(ycluster_storage_leader) > 1
        for: 30s
        labels:
          severity: critical
        annotations:
          summary: "Multiple storage leaders detected"
          description: "{{ $value }} nodes claim to be storage leader - possible split brain"

      - alert: NoDHCPLeader
        expr: sum(ycluster_dhcp_leader) == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "No DHCP leader elected"
          description: "No node is currently the DHCP leader"

      - alert: MultipleDHCPLeaders
        expr: sum(ycluster_dhcp_leader) > 1
        for: 30s
        labels:
          severity: critical
        annotations:
          summary: "Multiple DHCP leaders detected"
          description: "{{ $value }} nodes claim to be DHCP leader - possible split brain"

      # Certificate expiry warning - grouped by node
      - alert: CertificateExpiringWarning
        expr: min(ycluster_certificate_days_until_expiry) by (node) < 30 and min(ycluster_certificate_days_until_expiry) by (node) > 7
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "TLS certificate expiring soon on {{ $labels.node }}"
          description: "TLS certificate on {{ $labels.node }} will expire in {{ $value }} days"

      # Certificate expiry critical - grouped by node
      - alert: CertificateExpiringCritical
        expr: min(ycluster_certificate_days_until_expiry) by (node) <= 7
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "TLS certificate expiring very soon on {{ $labels.node }}"
          description: "TLS certificate on {{ $labels.node }} will expire in {{ $value }} days"

      # VIP not active anywhere
      - alert: VIPNotActive
        expr: max(ycluster_vip_active) by (vip) == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "VIP {{ $labels.vip }} not active anywhere"
          description: "Virtual IP {{ $labels.vip }} is not active on any node"

      # Multiple VIP masters (split brain)
      - alert: MultipleVIPMasters
        expr: sum(ycluster_vip_active) by (vip) > 1
        for: 30s
        labels:
          severity: critical
        annotations:
          summary: "Multiple masters for VIP {{ $labels.vip }}"
          description: "VIP {{ $labels.vip }} is active on multiple nodes - possible split brain"

      # Held packages not upgraded for over 30 days
      - alert: HeldPackagesStale
        expr: (time() - ycluster_held_packages_last_upgrade_timestamp_seconds) > 30 * 24 * 3600
        for: 1h
        labels:
          severity: warning
          # Packages are often held deliberately pending a maintenance window
          # (e.g. the PG16 restart). Keep the reminder but don't re-page every
          # 2h -- alertmanager gives slow_repeat a 24h repeat interval.
          slow_repeat: "true"
        annotations:
          summary: "Held packages on {{ $labels.node }} not upgraded in over 30 days"
          description: "Run: cd /etc/ansible && ./run-playbook.sh storage/upgrade-held-packages.yml"

  - name: ycluster-storage-disks
    rules:
      # ZFS pool not ONLINE (DEGRADED / FAULTED / UNAVAIL / ...)
      - alert: ZfsPoolNotOnline
        expr: ycluster_zpool_state != 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "ZFS pool {{ $labels.pool }} on {{ $labels.node }} is {{ $labels.health }}"
          description: "Pool {{ $labels.pool }} is in state {{ $labels.health }} — investigate with `zpool status {{ $labels.pool }}`"

      # Any device-level read/write/cksum errors in a pool
      - alert: ZfsPoolDeviceErrors
        expr: ycluster_zpool_errors_total > 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "ZFS pool {{ $labels.pool }} has {{ $labels.type }} errors on {{ $labels.node }}"
          description: "Pool {{ $labels.pool }} has accumulated {{ $value }} {{ $labels.type }} errors — check `zpool status -v {{ $labels.pool }}`"

      # Pool-level data corruption
      - alert: ZfsPoolDataErrors
        expr: ycluster_zpool_data_errors > 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "ZFS pool {{ $labels.pool }} reports data errors on {{ $labels.node }}"
          description: "Pool {{ $labels.pool }} has {{ $value }} data errors — run `zpool status -v {{ $labels.pool }}` and consider restoring affected files"

      # Pool getting full
      - alert: ZfsPoolHighCapacity
        expr: ycluster_zpool_capacity_ratio > 0.85
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "ZFS pool {{ $labels.pool }} above 85% on {{ $labels.node }}"
          description: "Pool {{ $labels.pool }} is at {{ $value | humanizePercentage }} — ZFS write performance degrades sharply above 80–90%"

      - alert: ZfsPoolCriticalCapacity
        expr: ycluster_zpool_capacity_ratio > 0.95
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "ZFS pool {{ $labels.pool }} above 95% on {{ $labels.node }}"
          description: "Pool {{ $labels.pool }} is at {{ $value | humanizePercentage }} — free space or evict data immediately"

      # Scrub age — RAIDZ1 with 14TB disks should scrub regularly to catch bit rot
      - alert: ZfsScrubOverdue
        expr: (time() - ycluster_zpool_last_scrub_timestamp_seconds) > 60 * 24 * 3600 and ycluster_zpool_last_scrub_timestamp_seconds > 0
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "ZFS pool {{ $labels.pool }} has not been scrubbed in over 60 days"
          description: "Last scrub on {{ $labels.pool }} ({{ $labels.node }}) was over 60 days ago — run `zpool scrub {{ $labels.pool }}`"

      # Samba services on NAS nodes
      - alert: SambaDown
        expr: node_systemd_unit_state{name=~"smbd.service|nmbd.service",state="active"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Samba {{ $labels.name }} not running on {{ $labels.node }}"
          description: "{{ $labels.name }} is not in active state on {{ $labels.node }} — clients cannot reach the share"

      # SMART health failure — drive is reporting overall self-assessment failed
      - alert: SmartDriveUnhealthy
        expr: smartmon_device_smart_healthy == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "SMART unhealthy: {{ $labels.disk }} on {{ $labels.node }}"
          description: "Drive {{ $labels.disk }} on {{ $labels.node }} reports overall SMART health failure — replace the drive"

      # Pending sectors — pending reallocation, often a precursor to drive failure
      - alert: SmartPendingSectors
        expr: smartmon_current_pending_sector_raw_value > 0
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "SMART pending sectors on {{ $labels.disk }} ({{ $labels.node }})"
          description: "Drive {{ $labels.disk }} has {{ $value }} pending sectors — early warning of drive failure"

      # Reallocated sectors — drive has already remapped bad sectors
      - alert: SmartReallocatedSectors
        expr: smartmon_reallocated_sector_ct_raw_value > 0
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "SMART reallocated sectors on {{ $labels.disk }} ({{ $labels.node }})"
          description: "Drive {{ $labels.disk }} has reallocated {{ $value }} sectors — monitor for further degradation"

      # Offline-uncorrectable: data lost
      - alert: SmartOfflineUncorrectable
        expr: smartmon_offline_uncorrectable_raw_value > 0
        for: 30m
        labels:
          severity: critical
        annotations:
          summary: "SMART offline uncorrectable on {{ $labels.disk }} ({{ $labels.node }})"
          description: "Drive {{ $labels.disk }} reports {{ $value }} offline-uncorrectable sectors — replace the drive"

      # Drive temperature high. Different vendors expose temp under different SMART
      # attribute IDs (190 = airflow_temperature_cel, 194 = temperature_celsius);
      # the `or` matches whichever the drive reports.
      - alert: SmartDriveTemperatureHigh
        expr: (smartmon_airflow_temperature_cel_raw_value > 55) or (smartmon_temperature_celsius_raw_value > 55)
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Drive {{ $labels.disk }} hot ({{ $value }}°C) on {{ $labels.node }}"
          description: "Drive {{ $labels.disk }} on {{ $labels.node }} has been above 55°C for 15 minutes"

      - alert: SmartDriveTemperatureCritical
        expr: (smartmon_airflow_temperature_cel_raw_value > 60) or (smartmon_temperature_celsius_raw_value > 60)
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Drive {{ $labels.disk }} critically hot ({{ $value }}°C) on {{ $labels.node }}"
          description: "Drive {{ $labels.disk }} on {{ $labels.node }} is above 60°C — risk of imminent failure"

      # smartmon textfile collector stopped writing
      - alert: SmartmonStale
        expr: (time() - node_textfile_mtime_seconds{file="/var/lib/prometheus/node-exporter/smartmon.prom"}) > 3600
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "smartmon textfile collector stale on {{ $labels.node }}"
          description: "smartmon.prom on {{ $labels.node }} has not been updated in over an hour — SMART metrics may be stale"

      # NVMe controller detached from the PCIe bus — kernel removed
      # the device from /sys/class/nvme/ (typically "nvme nvme0: Removing
      # after probe failure status: -19"). The failure surfaces in two
      # stages, both of which this alert catches:
      #
      #   1. Read-only remount: ext4 with default `errors=remount-ro`
      #      calls ext4_remount(MS_RDONLY) on the first metadata I/O
      #      error. /proc/self/mounts still shows the mount, but with
      #      `ro` in the options. node_filesystem_readonly goes to 1.
      #
      #   2. Forced unmount: eventually systemd / the kernel tears
      #      down the mount entirely, and the filesystem metrics
      #      stop being scraped. `count by (node) (...) == 0` catches
      #      that per-node.
      #
      # Both selectors carry `node!~"m.*"` to exclude macOS nodes —
      # macOS's signed system volume mounts / read-only by design, so
      # the readonly check is meaningless there. Other nodes (s*, c*,
      # nv*, nas*, x*, f*) boot from a local read-write ext4 root,
      # so `node_filesystem_readonly==1` is a genuine failure signal
      # for them.
      #
      # Note: `absent()` is global — if any node has the metric, it
      # returns empty — so it can't catch per-node disappearance.
      # `count by (node) (...) == 0` is the per-node equivalent.
      - alert: NVMeControllerOffline
        expr: |
          node_filesystem_readonly{mountpoint="/", node!~"m.*"} == 1
          or count by (node) (node_filesystem_avail_bytes{mountpoint="/", node!~"m.*"}) == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Boot drive failure on {{ $labels.node }}"
          description: "Root filesystem on {{ $labels.node }} is no longer writable — NVMe boot drive failing. Check `dmesg | grep -i nvme` and verify drive / cable state."

  - name: ycluster-backup
    rules:
      # The nightly verify-restore drill loaded a backup that did NOT restore
      # cleanly — the backup chain is silently broken. Metrics come from
      # `backup-databases verify-restore` (ycluster.utils.backup_status).
      - alert: BackupRestoreFailed
        expr: ycluster_backup_restore_success == 0
        for: 30m
        labels:
          severity: critical
        annotations:
          summary: "Backup verify-restore failed for {{ $labels.component }}"
          description: "The newest {{ $labels.component }} backup did not load cleanly in the nightly drill on {{ $labels.node }} — restorability is not guaranteed"

      # The drill itself stopped running (timer broken, leader stuck, RBD
      # unmounted) — restorability is no longer being checked. Gated on
      # storage leadership so a stale timestamp on a demoted node (which
      # correctly skips the drill) doesn't fire.
      #
      # TODO(cluster-wide drill metric): ycluster_backup_restore_timestamp_seconds
      # is node-local — each node's node-exporter scrapes its own textfile, and the
      # drill only runs on the current storage leader. When leadership shifts to a
      # node whose local timestamp is stale, this fires even though the drill ran
      # fine on the previous leader. The verify-restore result should be published
      # cluster-wide (e.g. written once to the shared RBD the leader mounts, or to
      # etcd) so this reflects the latest drill anywhere in the cluster, not
      # whatever node happens to hold leadership.
      - alert: BackupVerifyStale
        expr: (time() - ycluster_backup_restore_timestamp_seconds > 172800) and on(node) (ycluster_storage_leader == 1)
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "Backup verify-restore has not run in over 2 days"
          description: "No verify-restore drill has completed on {{ $labels.node }} (storage leader) in over 48h — backups may be unverified"

      # Backups themselves are no longer being produced/synced (the daily backup
      # timer is broken) — the newest encrypted backup is too old. Also gated
      # on leadership: only the leader runs the backup, so only its age matters.
      - alert: BackupStale
        expr: (ycluster_backup_age_seconds > 172800) and on(node) (ycluster_storage_leader == 1)
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "{{ $labels.component }} backup is stale (>2 days old)"
          description: "The newest encrypted {{ $labels.component }} backup on {{ $labels.node }} (storage leader) is over 48h old — the daily backup may be failing"

  - name: ycluster-gpu
    rules:
      # ECC counts are cumulative driver counters. Track the rate over the
      # alert window so a card with pre-existing corrected errors does not
      # page forever.
      - alert: GPUCorrectedECCError
        expr: increase(node_gpu_ecc_errors_corrected_total[15m]) > 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Corrected GPU ECC errors on {{ $labels.node }}"
          description: "GPU {{ $labels.index }} on {{ $labels.node }} reported {{ $value | humanize }} corrected ECC errors in 15 minutes"

      - alert: GPUUncorrectedECCError
        expr: increase(node_gpu_ecc_errors_uncorrected_total[15m]) > 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Uncorrected GPU ECC errors on {{ $labels.node }}"
          description: "GPU {{ $labels.index }} on {{ $labels.node }} reported {{ $value | humanize }} uncorrected ECC errors in 15 minutes — validate memory and driver health"

      # Compare each GPU's used/total ratio before aggregating, then page on
      # the hottest card on the node. Covers host-visible and VM-passthrough
      # nvidia-smi collectors.
      # Disabled: too noisy — legitimate high memory use (e.g. large model
      # loaded across all cards) is normal and not actionable.
      # - alert: HighGPUMemoryUsage
      #   expr: |
      #     max by (node) (
      #       node_gpu_memory_used_bytes / node_gpu_memory_total_bytes * 100
      #     ) > 95
      #     or
      #     max by (node) (
      #       node_vm_gpu_memory_used_bytes / node_vm_gpu_memory_total_bytes * 100
      #     ) > 95
      #   for: 5m
      #   labels:
      #     severity: warning
      #   annotations:
      #     summary: "High GPU memory usage on {{ $labels.node }}"
      #     description: "A GPU on {{ $labels.node }} has been above 95% memory usage for more than 5 minutes"

      # A Function Level Reset during normal operation is evidence of a
      # PCIe/driver/device fault. Counted per boot from the host journal.
      # The collector timer fires every 15m, so the rate window must span
      # at least two samples to avoid extrapolation artifacts.
      - alert: GPUFunctionLevelReset
        expr: increase(node_gpu_flr_events_total[20m]) > 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "GPU PCIe Function Level Reset on {{ $labels.node }}"
          description: "The host journal on {{ $labels.node }} recorded {{ $value | humanize }} PCIe Function Level Resets in 20 minutes"

      - alert: GPUFLRProbeFailed
        expr: node_gpu_flr_probe_ok == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "GPU FLR probe failed on {{ $labels.node }}"
          description: "The node-exporter textfile collector on {{ $labels.node }} could not query the host journal for Function Level Resets"

  - name: ycluster-temperature
    rules:
      # Ambient (intake) temperature — true room/inlet air only. Sources:
      # IPMI INLET_AIR_TEMP on server-class chassis, and the Comino RM
      # air-inlet probe on liquid-cooled workstation chassis. Both are
      # role-labeled "ambient" by the collector; internal board sensors are
      # not, so they can't match here. Chassis with neither intake sensor
      # are covered (at higher thresholds) by the chassis-ambient alert below.
      - alert: HighAmbientTemperature
        expr: |
          [% ambient_temp_expr(ambient_warn_overrides, 25) %]
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High ambient temperature on {{ $labels.node }}"
          description: "Intake/ambient sensor on {{ $labels.node }} is {{ $value }}°C (above its warning threshold) for more than 5 minutes"

      - alert: CriticalAmbientTemperature
        expr: |
          [% ambient_temp_expr(ambient_critical_overrides, 30) %]
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Critical ambient temperature on {{ $labels.node }}"
          description: "Intake/ambient sensor on {{ $labels.node }} is {{ $value }}°C (above its critical threshold) — check room HVAC"

      # Chassis-ambient (internal board) temperature — a coarser room-temp
      # proxy for chassis that expose no true intake sensor. Sourced from
      # the Super-I/O SYSTIN ("system") thermistor via the nct6775 hwmon
      # driver, selected by sensor label so it is hardware-keyed, not
      # host-keyed. Thresholds are higher than the intake alert because an
      # internal sensor sits above room air by a chassis/load-dependent
      # offset. Suppressed on any node that has a real intake sensor — that
      # node is governed by the stricter ambient alert, and its internal
      # sensor runs hotter (and would false-fire here).
      - alert: HighChassisAmbientTemperature
        expr: |
          max by (node) (
            node_hwmon_temp_celsius
            * on(chip, sensor, instance) group_left()
            node_hwmon_sensor_label{label="SYSTIN"}
          ) > 38
          unless on(node) (
            max by (node) (node_ipmi_temperature_celsius{role="ambient"})
            or
            max by (node) (node_comino_temperature_celsius{role="ambient"})
          )
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High chassis-ambient temperature on {{ $labels.node }}"
          description: "Internal board (SYSTIN) sensor on {{ $labels.node }} is {{ $value }}°C (>38°C) for 5m — no intake sensor here, check room temperature"

      - alert: CriticalChassisAmbientTemperature
        expr: |
          max by (node) (
            node_hwmon_temp_celsius
            * on(chip, sensor, instance) group_left()
            node_hwmon_sensor_label{label="SYSTIN"}
          ) > 43
          unless on(node) (
            max by (node) (node_ipmi_temperature_celsius{role="ambient"})
            or
            max by (node) (node_comino_temperature_celsius{role="ambient"})
          )
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Critical chassis-ambient temperature on {{ $labels.node }}"
          description: "Internal board (SYSTIN) sensor on {{ $labels.node }} is {{ $value }}°C (>43°C) — no intake sensor here, check room HVAC"

      # CPU die temperature via k10temp (AMD) — temp1 is Tctl. Far more
      # reliable than IPMI "CPU Package Temp", which is often a socket
      # aux thermistor with vendor-set thresholds. The chip-name join
      # is what scopes us to k10temp specifically.
      - alert: HighCPUTemperature
        expr: |
          max by (node) (
            node_hwmon_temp_celsius{sensor="temp1"}
            * on(chip, instance) group_left()
            node_hwmon_chip_names{chip_name="k10temp"}
          ) > 90
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "High CPU temperature on {{ $labels.node }}"
          description: "CPU Tctl on {{ $labels.node }} is {{ $value }}°C (>90°C) for more than 15 minutes"

      - alert: CriticalCPUTemperature
        expr: |
          max by (node) (
            node_hwmon_temp_celsius{sensor="temp1"}
            * on(chip, instance) group_left()
            node_hwmon_chip_names{chip_name="k10temp"}
          ) > 97
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Critical CPU temperature on {{ $labels.node }}"
          description: "CPU Tctl on {{ $labels.node }} is {{ $value }}°C (>97°C) — above TJMax even after boost-clock throttling, cooling is not keeping up"

      # GPU temperature — covers both host-visible GPUs (via nvidia-smi)
      # and VFIO-passthrough GPUs (via IPMI per-slot sensors). Take the
      # max across all GPUs on a node so any hot card fires.
      - alert: HighGPUTemperature
        expr: |
          max by (node) (node_gpu_temperature_celsius) > 88
          or
          max by (node) (node_ipmi_temperature_celsius{role="gpu"}) > 88
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "High GPU temperature on {{ $labels.node }}"
          description: "A GPU on {{ $labels.node }} has been above 88°C for more than 2 minutes"

      - alert: CriticalGPUTemperature
        expr: |
          max by (node) (node_gpu_temperature_celsius) > 92
          or
          max by (node) (node_ipmi_temperature_celsius{role="gpu"}) > 92
        for: 30s
        labels:
          severity: critical
        annotations:
          summary: "Critical GPU temperature on {{ $labels.node }}"
          description: "A GPU on {{ $labels.node }} is above 92°C — at or past the thermal-slowdown point"

      # Stale collector output — timers fire every 30s, so anything
      # older than a few minutes means the script or its dependencies
      # (ipmitool, incus, comino device) stopped working.
      - alert: CollectorStale
        expr: time() - node_textfile_mtime_seconds{file=~".*(temps|vm_gpu|crps).prom"} > 300
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Textfile collector stale on {{ $labels.node }}"
          description: "{{ $labels.file }} on {{ $labels.node }} hasn't been updated in {{ $value | humanizeDuration }}"

  # Comino CRPS power-supply monitoring. On workstation-class GPU chassis
  # the BMC exposes no usable PSU telemetry; these series come from the
  # Comino CRPS controller via crps-collector. See
  # docs/design/comino-crps-power-monitoring.md.
  - name: ycluster-power
    rules:
      # A PSU module dropped out of the bank — either de-enumerated
      # (present=0) or reporting a non-Normal PMBus status (ok=0). On a
      # redundant bank this is tolerated, but it's eating the redundancy
      # margin and the failing module should be serviced.
      - alert: CrpsPsuDropout
        expr: |
          node_crps_psu_present == 0
          or
          node_crps_psu_ok == 0
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: "CRPS PSU module {{ $labels.module }} down on {{ $labels.node }}"
          description: "PSU module {{ $labels.module }} on {{ $labels.node }} is absent or not in Normal state for more than 1 minute"

      # AC sag — input voltage low on MULTIPLE modules at once. A single
      # module ramping (e.g. a benign turn-on) is excluded by requiring
      # two or more modules below threshold simultaneously.
      - alert: CrpsAcSag
        expr: count by (node) (node_crps_psu_vin_volts < 200) >= 2
        for: 30s
        labels:
          severity: warning
        annotations:
          summary: "AC sag on {{ $labels.node }}"
          description: "{{ $value }} CRPS modules on {{ $labels.node }} report input voltage below 200V — likely an AC-side sag"

      # Non-redundant bank: no hot-spare reserve modules configured (or
      # cold redundancy disabled), so losing any single PSU powers the box
      # off instead of riding through. Should never be the steady state.
      - alert: CrpsNonRedundant
        expr: node_crps_reserve_qty == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "CRPS bank non-redundant on {{ $labels.node }}"
          description: "CRPS on {{ $labels.node }} has reserveQty=0 — any single PSU dropout will power the host off"

      # An active controller fault (overheat, cooling, PMBus alert, …) as
      # opposed to a tolerated alarm. Distinct from the per-module dropout
      # alert: this fires on the controller's own aggregate fault state.
      - alert: CrpsControllerFault
        expr: node_crps_state{state="fault"} == 1
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "CRPS controller in FAULT state on {{ $labels.node }}"
          description: "The Comino CRPS controller on {{ $labels.node }} reports an active fault — check node_crps_alarm flags"

      # Transient caught by the on-board event log that the live gauges
      # almost certainly missed: a sub-second AC sag or single-PSU dropout
      # recovers between 30s scrapes, but the controller logs the
      # Normal->Fault transition and the collector harvests it into this
      # counter. So a non-zero increase means "a power fault happened
      # recently even though the PSUs look fine right now." Keyed off the
      # log path, not live state, precisely to surface the invisible blips.
      - alert: CrpsLoggedPowerTransient
        expr: increase(node_crps_log_event_total{state="fault"}[15m]) > 0
        labels:
          severity: warning
        annotations:
          summary: "CRPS logged a power fault transient on {{ $labels.node }}"
          description: "{{ $value | printf \"%.0f\" }} fault entr(ies) appeared in the CRPS event log on {{ $labels.node }} in the last 15m — a brief power fault the live gauges may have ridden over. Inspect `show log` on the controller."

  # Local OSV CVE feed (osv-feed) health and perimeter CVE SLA alerts. The
  # mirror + matcher run on a single collector node; its textfile collector
  # emits osv_feed_mirror_* and osv_feed_collector_error health gauges plus
  # osv_feed_cve_info / osv_feed_cve_first_seen_seconds. See
  # docs/design/osv-feed.md and docs/design/perimeter-software-tracking.md.
  - name: ycluster-security
    rules:
      # The daily mirror hasn't advanced a feed cursor in over two days, so
      # any matcher output is based on stale (or missing) source data.
      # osv_feed_mirror_age_seconds is already the age (a delta from now), so
      # compare it directly rather than subtracting it from time().
      - alert: OSVFeedMirrorStale
        expr: osv_feed_mirror_age_seconds > 2 * 24 * 3600
        for: 6h
        labels:
          severity: warning
        annotations:
          summary: "OSV feed mirror stale on {{ $labels.node }}"
          description: "The OSV feed on {{ $labels.node }} has not been mirrored in over 2 days (most-stale feed cursor age {{ $value | humanizeDuration }}). Matching is running against stale data."

      # The textfile collector isn't refreshing osv_feed.prom (it always
      # rewrites the file each run, so a stale mtime means the collector or
      # its timer stopped rather than a transiently failed match).
      - alert: OSVFeedCollectorStale
        expr: time() - node_textfile_mtime_seconds{file=~".*osv_feed.prom"} > 20 * 60
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "OSV feed collector stale on {{ $labels.node }}"
          description: "osv_feed.prom on {{ $labels.node }} hasn't been updated in over 20 minutes. Check osv-feed-collector.timer/service."

      # The most recent match run on the collector failed (fetch or feed
      # missing); CVE series are dropped, so CVE SLA alerts would otherwise
      # go quiet even though the tooling is broken.
      - alert: OSVFeedCollectorError
        expr: osv_feed_collector_error == 1
        for: 30m
        labels:
          severity: warning
        annotations:
          summary: "OSV feed match failing on {{ $labels.node }}"
          description: "osv-feed match is failing on {{ $labels.node }}. CVE metrics are not being produced; check the collector service logs."

      # Early warning for newly-detected critical CVEs. osv_feed_cve_info
      # emits a series per finding at detection time (acked="false", state is
      # no_fix_yet or fix_available), so this fires well before the 12h SLA
      # alert below. The 1h for-debounce absorbs collector jitter; the
      # critical PerimeterCVECriticalLongPending alert remains the escalation
      # past the SLA.
      - alert: PerimeterCVENewCritical
        expr: osv_feed_cve_info{severity="critical", acked="false"} == 1
        for: 1h
        labels:
          severity: warning
          perimeter_cve: "true"
        annotations:
          summary: "New critical CVE detected: {{ $labels.cve }} in {{ $labels.package }}{{ if $labels.image }} ({{ $labels.image }}){{ end }}"
          description: "Critical CVE {{ $labels.cve }} in {{ $labels.package }} {{ $labels.version }} ({{ $labels.image }}) has been pending for 1h (12h SLA). Review severity and exposure now — it escalates to PerimeterCVECriticalLongPending at 12h."

      # Coalesced perimeter CVE alerts. osv-feed emits one
      # osv_feed_cve_summary series per alert severity (critical / high), with
      # the value = count of non-acked pending (no_fix_yet / fix_available)
      # findings past that severity's SLA and a `cves` label listing up to 5
      # example CVE IDs (oldest first_seen first). This replaces the previous
      # per-CVE alert (one alert per package/CVE/image) so a stepped-up CVE
      # back-log collapses into a single alert per severity instead of flooding.
      # `for: 1h` debounces; both are routed with a daily repeat so unresolved
      # perimeter CVEs stay visible (see alertmanager.yml.j2).
      - alert: PerimeterCVECriticalLongPending
        expr: osv_feed_cve_summary{severity="critical", acked="false"} > 0
        for: 1h
        labels:
          severity: critical
          perimeter_cve: "true"
        annotations:
          summary: "{{ $value }} critical CVEs pending beyond the 12h SLA{{ if $labels.cves }}: {{ $labels.cves }}{{ end }}"
          description: "{{ $value }} non-acked critical-severity CVEs have been pending longer than the 12-hour perimeter SLA{{ if $labels.cves }} (up to 5 examples: {{ $labels.cves }}){{ end }}. Decide within the perimeter SLA or acknowledge each explicitly (osv-feed ack)."

      # The high-severity counterpart, on a 2-day SLA so it pages separately.
      # Same coalesced osv_feed_cve_summary shape as the critical rule.
      - alert: PerimeterCVEHighLongPending
        expr: osv_feed_cve_summary{severity="high", acked="false"} > 0
        for: 1h
        labels:
          severity: warning
          perimeter_cve: "true"
        annotations:
          summary: "{{ $value }} high CVEs pending beyond the 2-day SLA{{ if $labels.cves }}: {{ $labels.cves }}{{ end }}"
          description: "{{ $value }} non-acked high-severity CVEs have been pending longer than the 2-day perimeter SLA{{ if $labels.cves }} (up to 5 examples: {{ $labels.cves }}){{ end }}. Review and decide within the perimeter SLA."

  # Hosting provider balances come from deployment-specific plugins installed
  # on the balance collector node. The public metrics are provider-agnostic:
  # each plugin emits provider/account-labeled balance and up series.
  - name: ycluster-hosting
    rules:
      - alert: HostingBalanceLow
        expr: ycluster_hosting_balance_dollars < 50
        for: 15m
        labels:
          severity: warning
          slow_repeat: "12h"
        annotations:
          summary: "Hosting balance low for {{ $labels.provider }}/{{ $labels.account }}"
          description: "The {{ $labels.provider }} account {{ $labels.account }} balance is {{ $value | printf \"$%.2f\" }}, below the $50 warning threshold."

      - alert: HostingBalanceCritical
        expr: ycluster_hosting_balance_dollars < 20
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Hosting balance critical for {{ $labels.provider }}/{{ $labels.account }}"
          description: "The {{ $labels.provider }} account {{ $labels.account }} balance is {{ $value | printf \"$%.2f\" }}, below the $20 critical threshold."

      - alert: HostingBalanceCollectorError
        expr: ycluster_hosting_balance_up == 0
        for: 30m
        labels:
          severity: warning
          slow_repeat: "12h"
        annotations:
          summary: "Hosting balance collection failing for {{ $labels.provider }}/{{ $labels.account }}"
          description: "The hosting-balance collector could not collect {{ $labels.provider }} account {{ $labels.account }}; balance alerts are stale or absent."

      - alert: HostingBalanceCollectorStale
        expr: time() - node_textfile_mtime_seconds{file=~".*hosting_balance.prom"} > 1800
        for: 15m
        labels:
          severity: warning
          slow_repeat: "12h"
        annotations:
          summary: "Hosting balance collector stale on {{ $labels.node }}"
          description: "hosting_balance.prom on {{ $labels.node }} has not been refreshed in over 30m; check hosting-balance-collector.service/timer."
