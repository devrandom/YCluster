          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CRPS logged power-fault transients (events the live poll misses)",
      "description": "Fault/alarm transitions harvested from the controller's on-board event log. A bar here means a brief power fault occurred even if the live PSU gauges looked fine — sub-second sags/dropouts that recover between scrapes are recorded by the controller and counted here.",
      "datasource": { "type": "prometheus", "uid": "prometheus-local" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "id": 13,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-local" },
          "expr": "increase(node_crps_log_event_total{state=\"fault\"}[$__rate_interval])",
          "legendFormat": "{{node}} fault",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-local" },
          "expr": "increase(node_crps_log_event_total{state=\"alarm\"}[$__rate_interval])",
          "legendFormat": "{{node}} alarm",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CRPS per-PSU dropout events (asymmetry → flaky module/feed)",
      "description": "Per-PSU asymmetric drops from the event log: a single module losing input/output while the others hold steady. One module dominating points at a specific flaky PSU, connector, or AC feed (e.g. PSU4) rather than a bank-wide sag.",
      "datasource": { "type": "prometheus", "uid": "prometheus-local" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "id": 14,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 70, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-local" },
          "expr": "increase(node_crps_psu_event_total[$__rate_interval])",
          "legendFormat": "{{node}} PSU{{module}} {{kind}}",
          "refId": "A"
        }
      ]
    }
