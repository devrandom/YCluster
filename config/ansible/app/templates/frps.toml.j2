# frp server configuration
# Parallel run alongside rathole on disjoint ports. See
# docs/design/frp-migration.md for the port allocation rationale.
#
# v0.70.0 architecture: frps declares only the control listener + auth;
# proxies are registered DYNAMICALLY by each frpc via the control
# connection. The per-service listenPort mapping lives in frpc.toml.j2 /
# frpc-ssh.toml.j2 (and the VM-bastion derivation there), not here. See
# pkg/config/v1/server.go: ServerConfig has no Proxies field, and
# ServerTransportConfig has no ProxyProtocolVersion (that lives per-proxy
# on the client side, see ProxyTransport in proxy.go).
bindAddr = "0.0.0.0"
bindPort = {{ frp_bind_port | default(7000) }}
# Bind dynamically-registered proxy listeners to loopback only — SSH / admin
# / alt-vhost tunnels are reached via the local bastion jump, not the public
# net (matching rathole's 127.0.0.1 SSH bind and the rathole "two-hop"
# pattern). Without this, each frpc-ssh would expose its core node's sshd
# on the WAN. See pkg/config/v1/server.go: ProxyBindAddr.
proxyBindAddr = "127.0.0.1"

auth.method = "token"
auth.token = "{{ frp_token | default('change_me_secret_token') }}"
