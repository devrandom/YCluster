# rathole server configuration
# HTTP (:80) and HTTPS (:14443) were moved to frp — rathole now only
# carries control plane + SSH/admin/bastion ingress. See
# docs/design/frp-migration.md.
[server]
bind_addr = "0.0.0.0:2333"
default_token = "{{ rathole_token | default('change_me_secret_token') }}"

[server.transport]
type = "tcp"

[server.transport.tcp]
nodelay = true
keepalive_secs = 20
keepalive_interval = 8

# Per-core SSH (rathole 2200+N) was retired — frp's frpc-ssh covers it in
# parallel on 17200+N. rathole now only carries the admin and VM-bastion
# services below.
[server.services.admin1]
bind_addr = "127.0.0.1:8821"
type = "tcp"

[server.services.admin2]
bind_addr = "127.0.0.1:8822"
type = "tcp"

# VM-access bastions (one public port per Incus VM host). Each VM host
# runs its own bastion container on its own incusbr0 and registers a
# distinct service name so the tunnels do not collide on the rathole
# server. Reach VMs with: ssh -J jump@<this-host>:<port> user@<vm-name>
#
# Per-host service name is set via `vm_bastion_service` in host_vars; the
# public port is DERIVED here from node type + index. The original low-index
# hosts keep their historical, contiguous ports (idx 1-3: nvidia 2210+idx ->
# 2211-2213, compute 2213+idx -> 2214-2216) so deployed bastions are never
# renumbered. Every host with idx > 3 lands in a per-type DISJOINT block,
# clear of the legacy block: nvidia 2220+idx (2224-2240), compute(c)
# 2240+idx (2244-2260). So adding an
# nv* host can never shift a c* port. nvidia is a child of compute, so one
# loop covers both; scales without naming any node here.
{% for h in groups['compute'] | default([]) | sort %}
{% if hostvars[h].vm_bastion_service is defined %}
{% set idx = h | regex_replace('^[a-z]+', '') | int %}
{% set is_nv = h.startswith('nv') %}
{% set port = ((2210 if is_nv else 2213) + idx) if idx <= 3 else ((2220 if is_nv else 2240) + idx) %}
[server.services.{{ hostvars[h].vm_bastion_service }}]
bind_addr = "0.0.0.0:{{ port }}"
type = "tcp"

{% endif %}
{% endfor %}
