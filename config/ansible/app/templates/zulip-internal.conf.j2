# HTTP - zulip.xc (cluster-internal)
#
# Zulip chat server, internal access (browsing from inside the cluster).
# External access is the separate certbot-managed vhost
# (zulip_zulip.conf.j2 → zulip.<domain>).
# Restricted to the cluster subnet.
server {
    listen 80;
    server_name zulip.xc;

    # Zulip allows file uploads in messages; don't cap small.
    client_max_body_size 100M;

    location / {
        allow 10.0.0.0/24;
        allow 127.0.0.0/8;
        # Docker bridge networks on the host (containers reach us via
        # host-gateway, e.g. the host-side nginx loopback already).
        allow 172.16.0.0/12;
        deny all;

        proxy_pass http://127.0.0.1:{{ zulip_port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Zulip keeps long-lived connections for real-time message delivery
        # (long-polling + websockets).
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;

        proxy_connect_timeout 10m;
        proxy_send_timeout 10m;
        proxy_read_timeout 10m;
    }
}
