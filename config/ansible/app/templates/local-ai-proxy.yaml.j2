# Managed by Ansible — install-local-ai-proxy.yml
# See docs/local-ai-proxy.md for design notes.
listen: "{{ proxy_listen }}"
{% if use_etcd | default(true) | bool %}
etcd:
  prefix: "{{ etcd_prefix | default('/cluster/config/inference/models/') }}"
{% else %}
backend:
  url: "{{ backend_url }}"
{% endif %}
auth:
  # Read by local-ai-proxy-auth.service. When true, the validator falls back
  # to Open-WebUI's api_key table on an etcd miss — used only during the
  # one-time key migration window, then flipped back off (default false).
  allow_owui_fallback: {{ allow_owui_fallback | default(false) | bool | string | lower }}
