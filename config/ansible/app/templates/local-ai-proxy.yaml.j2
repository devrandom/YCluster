# Managed by Ansible — install-local-ai-proxy.yml
# See docs/local-ai-proxy.md for design notes.
listen: "{{ proxy_listen }}"
{% if proxy_metrics_listen | default('') %}
metrics_listen: "{{ proxy_metrics_listen }}"
{% endif %}
{% if use_etcd | default(true) | bool %}
etcd:
  prefix: "{{ etcd_prefix | default('/cluster/config/inference/models/') }}"
{% else %}
backend:
  url: "{{ backend_url }}"
{% endif %}

# Per-user, per-model in-flight cap and wait-queue depth. 0 disables
# either. A full queue gets 429 rate_limit_error (code
# concurrency_limit_exceeded).
max_concurrent_per_user_model: {{ proxy_max_concurrent_per_user_model | default(4) | int }}
max_queued_per_user_model: {{ proxy_max_queued_per_user_model | default(4) | int }}

