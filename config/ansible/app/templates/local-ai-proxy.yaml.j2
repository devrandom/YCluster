# Managed by Ansible — install-local-ai-proxy.yml
# See docs/local-ai-proxy.md for design notes.
listen: "{{ proxy_listen }}"
{% if proxy_metrics_listen | default('') %}
metrics_listen: "{{ proxy_metrics_listen }}"
{% endif %}
{% if use_etcd | default(true) | bool %}
etcd:
  prefix: "{{ etcd_prefix | default('/cluster/config/inference/models/') }}"
{% else %}
backend:
  url: "{{ backend_url }}"
{% endif %}

