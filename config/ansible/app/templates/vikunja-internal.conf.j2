# HTTP - vikunja.xc (cluster-internal)
#
# Vikunja task manager, internal access. External access is the separate
# certbot-managed vhost (vikunja_tasks.conf.j2 -> tasks.<domain>).
# Restricted to the cluster subnet and the host's Docker bridges.
server {
    listen 80;
    server_name vikunja.xc;

    # Task attachments; keep this bounded but large enough for documents.
    client_max_body_size 110M;

    location / {
        allow 10.0.0.0/24;
        allow 127.0.0.0/8;
        allow 172.16.0.0/12;
        deny all;

        proxy_pass http://127.0.0.1:{{ vikunja_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Vikunja uses websockets for live updates and may stream downloads.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
