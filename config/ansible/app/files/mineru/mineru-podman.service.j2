[Unit]
Description=MinerU document parsing API (opendatalab/MinerU 3.4.x, podman)
# Same prerequisites as the venv-based mineru.service: the CUDA
# driver must be initialised before mineru-api imports torch, and
# nvidia-persistenced keeps the driver resident. Podman + NVIDIA
# CDI are required for the pinned `--device nvidia.com/gpu=0` — set up by
# setup-gpu-podman.yml (runs before this play in the app chain).
After=network.target nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=simple
# Run podman as root, then map the container's runtime UID to the host
# dev user's UID via `--userns=keep-id` and `--user`. The reason for this
# oddity: podman under systemd's User=dev can't do CLONE_NEWUSER for its
# re-exec path (sudo/systemd-restricted caps strip the capability that lets
# podman fork into a fresh user namespace). Running podman as root avoids
# the re-exec failure; --userns=keep-id keeps host UIDs 1:1 inside the
# container, so bind-mounted /home/dev/* is writable by the container
# process. mineru_run_uid/mineru_run_gid are set from the host's dev user.
User=root
Group=root
WorkingDirectory=/home/dev
# /run/mineru is the bind-mount source for the container's UDS
# (-v /run/mineru:/run/mineru in ExecStart below). /run is tmpfs
# and disappears on every reboot, so the unit must recreate the
# dir at every start. We do NOT use RuntimeDirectory= here because
# (empirically on this host, systemd 255.4 / Ubuntu 24.04) the
# RuntimeDirectory ends up owned by root:root and our subsequent
# chown ExecStartPre does not stick — a later systemd-internal
# re-check (triggered by systemd-run --scope in the pull/run
# ExecStartPre/ExecStart) silently resets the ownership back to
# root:root. The workaround is to own the dir ourselves with an
# explicit install -d in ExecStartPre, no RuntimeDirectory
# involvement.
#
# Owned by dev:dev because the container's mineru process runs as the
# host dev UID via --userns=keep-id and creates the socket file here.
# Mode 0755: dev rwx (can create the socket), everyone else rx (so
# root-run socat in mineru-podman-proxy.service can connect).
#
# install-mineru.yml also has a `file:` task creating this dir at
# install time (belt-and-suspenders + makes the ownership visible
# in the playbook recap). The ExecStartPre below is the
# authoritative recovery path at every boot/restart.
ExecStartPre=/usr/bin/install -d -o dev -g dev -m 0755 /run/mineru
# Delegate=true lets podman create user namespaces (CLONE_NEWUSER)
# under systemd. Same setting as the upstream
# /usr/lib/systemd/system/podman.service.
Delegate=true
Environment="HOME=/home/dev"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# mineru-api reads these via the ENTRYPOINT/CMD in the Containerfile.
# MINERU_MODEL_SOURCE=local skips the network re-check on every boot
# (cache is pre-populated by install-mineru.yml's warmup step; the
# bind-mount makes that cache persistent across restarts).
Environment="HF_HOME=/home/dev/.cache/huggingface"
Environment="MINERU_MODEL_SOURCE=local"
Environment="MINERU_API_MAX_CONCURRENT_REQUESTS=3"
# Bind-mounts:
#   /home/dev/.cache       — HF model weights + compiled CUDA kernels
#                            (vllm, flashinfer, torch). With this
#                            bind-mount the VLM (~2.2 GB) and
#                            pipeline (~2.5 GB) weights are reused
#                            across every redeploy — the image
#                            itself never bakes them.
#   /home/dev/mineru.json  — mineru config (models-dir snapshot
#                            paths). Without this bind-mount, the
#                            container re-resolves snapshot paths
#                            on first request and re-downloads the
#                            template on every cold start.
#   /run/mineru            — Unix domain socket that mineru-api
#                            binds inside the container (see
#                            run-mineru-uds.py + --network=none
#                            below). The container's UID matches
#                            the host's dev UID via --userns=
#                            keep-id, so the UDS file is created
#                            by the same UID that owns the
#                            directory (the ExecStartPre above
#                            creates it owned by dev). socat in
#                            mineru-podman-proxy.service bridges
#                            host TCP:8000 to this UDS.
# Logging: podman's default log driver is journald; journalctl
# -u mineru-podman captures stdout/stderr. To grep without
# journalctl, `journalctl -u mineru-podman > file`.
#
# podman under systemd's User=dev can't do CLONE_NEWUSER for its
# re-exec path (Delegate=yes isn't enough on this kernel/buildah
# combo — the re-exec happens in a fresh process without the
# delegated cgroup). Wrap in `systemd-run --scope` so the podman
# process gets a transient unit with full caps; the wrapper
# process exits, leaving the inner podman to run normally.
#
# ExecStartPre pulls the image into dev's podman storage. The
# pull is a no-op when the image is already present at the right
# digest (~5 s warm cache). Skipping the pull and assuming the
# image is already there is risky on a fresh host, so we always
# do it.
#
# --network=none is the SSRF hardening: the container has no
# netns interfaces, so no socket(AF_INET, ...) syscall can
# succeed. A crafted PDF that triggers an external fetch
# (pypdf / pdfplumber / font loaders / etc.) fails at the
# syscall layer instead of relying on mineru's application-
# level SSRF mitigation in
# mineru/cli/public_http_client_policy.py (which only blocks
# attacker-supplied server_url / *-http-client backends).
# mineru-api itself listens on a Unix socket at
# /run/mineru/mineru.sock (filesystem bind, not AF_INET);
# mineru-podman-proxy.service bridges host TCP:8000 to that
# UDS so the cluster-internal reach model is unchanged.
#
# VRAM footprint: MinerU's VLM backend auto-defaults to
# gpu_memory_utilization=0.5 (set_default_gpu_memory_utilization in
# mineru/backend/vlm/utils.py), which pre-reserves a KV cache far
# larger than document parsing needs and pins ~48 GB of the 96 GB
# card. An explicit --gpu-memory-utilization overrides that default
# (vLM-analyze only fills it in when absent), so we cap it at 0.2 to
# free the card for a co-tenant. --max-model-len MUST stay <= 8192
# (this VLM's max_position_embeddings; a larger value is rejected by
# vLLM unless VLLM_ALLOW_LONG_MAX_MODEL_LEN=1, which we avoid). Both
# flags are passed to mineru-api (click allow_extra_args) and flow
# into the AsyncEngineArgs. Tune here (0.2 -> ~20 GB idle, measured).
ExecStartPre=/usr/bin/systemd-run --scope --unit=mineru-pull /usr/bin/podman pull registry.xc:5000/mineru:3.4.3-all-vllm
ExecStart=/usr/bin/systemd-run --scope --unit=mineru-run /usr/bin/podman run --rm --name mineru \
    --userns=keep-id \
    --user {{ mineru_run_uid | default(1002) }}:{{ mineru_run_gid | default(1002) }} \
    --network=none \
    --device nvidia.com/gpu=0 \
    -v /home/dev/.cache:/home/dev/.cache \
    -v /home/dev/.config:/home/dev/.config \
    -v /home/dev/.local:/home/dev/.local \
    -v /home/dev/.triton:/home/dev/.triton \
    -v /home/dev/.nv:/home/dev/.nv \
    -v /home/dev/mineru.json:/home/dev/mineru.json \
    -v /run/mineru:/run/mineru \
    -e MINERU_UDS_PATH=/run/mineru/mineru.sock \
    -e MINERU_API_OUTPUT_ROOT=/home/dev/.cache/mineru-output \
    -e CUDA_VISIBLE_DEVICES=0 \
    -e USER=dev -e LOGNAME=dev \
    registry.xc:5000/mineru:3.4.3-all-vllm \
    --host 0.0.0.0 --port 8000 --enable-vlm-preload true \
    --gpu-memory-utilization 0.2 --max-model-len 8192
Restart=always
RestartSec=5
# Cold start runs VLM preload (~22 GB weights settle into VRAM) +
# vLLM init. On Blackwell the VLM weights need ~30 s, vLLM CUDA
# graph compile another ~60 s. Give systemd plenty of headroom
# before it decides the service is wedged.
TimeoutStartSec=600
# In-flight requests get 30 s to drain before SIGKILL.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
