# MinerU 3.4.x on Ubuntu 24.04 (matches prod hosts). The image
# ships mineru[all] + torchvision + vllm so all three MinerU
# backends (pipeline / vlm / hybrid) are runtime-switchable via
# the `backend` form field, and the VLM auto-resolves to
# vllm-async-engine on Linux (`get_vlm_engine('auto',
# is_async=True)`) for proper concurrent page processing.
#
# The image deliberately does NOT bake MinerU model weights — those
# are reused at runtime via bind-mount. The systemd unit
# (mineru-podman.service) bind-mounts /home/dev/.cache from the host
# so the VLM (~2.2 GB) and pipeline (~2.5 GB) weights survive every
# redeploy and don't need re-downloading.
#
# Build with: buildah bud -f Containerfile -t mineru:VERSION .
# Push with:  podman push mineru:VERSION registry.xc:5000/mineru:VERSION
# (Both run from install-mineru.yml on the first Nvidia host.)

FROM docker.io/library/ubuntu:24.04

# System deps. ffmpeg is for media preprocessing, libgl*/glib are
# OpenCV/Pillow deps, fonts-noto-cjk matches the macOS install
# (CJK rendering in the layout pass). python3.12-venv is a fallback
# (uv manages its own envs; not strictly required).
#
# gcc + build-essential + python3-dev are needed by triton to
# JIT-compile CUDA kernels on first run (vllm uses triton internally).
# Without gcc: "RuntimeError: Failed to find C compiler".
# Without python3-dev: "fatal error: Python.h: No such file".
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        ffmpeg \
        fonts-noto-cjk \
        gcc \
        libgl1 \
        libglib2.0-0 \
        python3.12-dev \
        python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

# uv (single small layer) — installed from a pinned, checksum-verified GitHub
# release tarball, NOT the astral.sh/uv/install.sh bootstrap (running a remote
# installer script is avoided). Adds the `uv` + `uvx` binaries to /usr/local/bin
# so the next layer can call `uv pip install --system` directly.
ARG UV_VERSION=0.12.1
ARG UV_SHA256=90b2f223fb69d19db49e117da601f64978593417988530aa733d456141b4bcbb
ADD https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz /uv.tar.gz
RUN echo "${UV_SHA256}  /uv.tar.gz" | sha256sum -c - \
    && tar -xzf /uv.tar.gz -C /usr/local/bin --strip-components=1 \
    && rm /uv.tar.gz \
    && uv --version

# The big layer — caches well across rebuilds because uv's resolver
# produces deterministic wheels. vllm 0.10.x–0.11.x is the version
# range MinerU upstream tests against (3.0 changelog: "base image
# has been upgraded to vllm0.11.2 + torch2.9.0"). Pin below 0.12.0
# so future vllm breaking changes don't surprise us.
#
# mineru[all] on Linux = core (vlm + pipeline + gradio) + s3 + vllm.
# torchvision is pulled by mineru[pipeline] already, but pinning it
# explicitly so the AutoProcessor Video class is satisfied at
# mineru-api startup (see install-mineru.yml for the same fix on
# the venv install).
#
# Ubuntu 24.04 marks /usr as externally managed (PEP 668), so
# --system refuses to install. Use --break-system-packages —
# the container is a single-purpose image, no other Python users
# share /usr.
RUN uv pip install --system --break-system-packages \
        'mineru[all]' \
        torchvision \
        'vllm>=0.10.1.1,<0.12.0'

# Sanity check — fails the build if mineru-api is missing.
RUN mineru-api --help >/dev/null

# Default to a non-root `dev` user so bind-mounts of /home/dev/* are
# writable. The systemd unit runs the container with `--userns=keep-id`
# and an explicit `--user <host dev uid>:<gid>` (mineru_run_uid/gid), so
# hosts whose dev user is not UID 1002 do not need a different image.
# HOME=/home/dev matches the bind-mount layout and lets mineru read
# ~/mineru.json without an explicit MINERU_TOOLS_CONFIG_JSON override.
RUN groupadd --gid 1002 dev \
    && useradd --uid 1002 --gid 1002 --home-dir /home/dev --shell /bin/bash dev \
    && mkdir -p /home/dev \
    && chown -R dev:dev /home/dev
USER dev
ENV HOME=/home/dev
WORKDIR /home/dev

# mineru-api is the FastAPI entrypoint. Under podman's --network=none
# (set in mineru-podman.service) the container has no netns interfaces,
# so a TCP socket(AF_INET, ...) bind would fail with ENETUNREACH. We
# invoke mineru-api via run-mineru-uds.py, a tiny launcher that
# monkey-patches uvicorn.Config.__init__ to bind a Unix domain socket
# instead. UDS binds use filesystem syscalls — they work under
# --network=none because no AF_INET socket is ever created.
#
# The systemd unit on the host bridges host TCP:8000 to this UDS via
# socat (mineru-podman-proxy.service), so the cluster-internal reach
# model is unchanged (local-ai-proxy + nginx still hit <host>.xc:8000).
# The only thing that changes is the container's outbound capability:
# with --network=none, a crafted PDF that triggers an external fetch
# (pypdf / pdfplumber / font loaders / etc.) fails at the syscall layer
# instead of relying on mineru's application-level SSRF mitigation in
# mineru/cli/public_http_client_policy.py.
#
# The wrapper accepts the same CLI args the unit passes (--host,
# --port, --enable-vlm-preload) — host/port are used in the startup
# banner / SSRF policy warning, but uvicorn ignores them when uds is
# set. MINERU_UDS_PATH is set by the unit via `podman run -e`.
# --chown=dev:dev so the chmod below runs as USER dev without EPERM
# (buildah COPY defaults to root:root when --chown is omitted, and
#  `chmod` needs the caller to own the file).
COPY --chown=dev:dev run-mineru-uds.py /usr/local/bin/mineru-api-uds
RUN chmod 0755 /usr/local/bin/mineru-api-uds
ENV MINERU_MODEL_SOURCE=local
ENTRYPOINT ["/usr/local/bin/mineru-api-uds"]
CMD ["--host", "0.0.0.0", "--port", "8000", "--enable-vlm-preload", "true"]
