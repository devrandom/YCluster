# rathole SSH-only client configuration (generated from etcd)
# Retired: per-core SSH moved to frp's frpc-ssh (17200+idx on the frontend),
# and the rathole-ssh service is disabled via install-rathole.yml. This
# template is kept only so the generate-ssh-client command remains valid;
# it registers no services.
[client]
remote_addr = "{{ remote_addr }}"
default_token = "{{ token }}"
heartbeat_timeout = 40
retry_interval = 1

[client.transport]
type = "tcp"

[client.transport.tcp]
nodelay = true
keepalive_secs = 20
keepalive_interval = 8
