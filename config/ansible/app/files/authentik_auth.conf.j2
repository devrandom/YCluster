# HTTPS/HTTP - authentik (cluster IdP), EXTERNAL vhost
#
# The `_auth` suffix in the template filename makes certbot-manager render
# this site with the `auth.` subdomain of the primary domain AND include
# that subdomain in the certificate SAN on the next obtain/renew.
# External and off-cluster access is required for logins (and OAuth
# callbacks if external login sources are enabled); cluster-internal
# access is the separate auth.<domain> vhost (authentik-internal.conf.j2).
#
# Single source of truth for the auth.<domain> surface: this server block
# declares both the cluster-internal / direct listener (plain :443) and
# the frp tunnel landing (127.0.0.2:17443, PROXY protocol v2), so the
# OAuth round-trip works over both the tunnel and internal/direct hits.
server {
    {% if use_tls %}
    listen 443 ssl http2;
    listen 127.0.0.2:17443 ssl http2 proxy_protocol;
    {% else %}
    listen 80;
    listen 127.0.0.2:17443 proxy_protocol;
    {% endif %}
    server_name {{ domain | default('_') }};

    # Trust the PROXY protocol header only from loopback (frpc, the sole
    # source that can reach 127.0.0.2). Plain :443 connections carry no
    # PROXY header and are unaffected.
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    client_max_body_size 10M;

    {% if use_tls %}
    # SSL configuration
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;

    # SSL security settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    {% endif %}
    add_header X-Content-Type-Options nosniff always;

    # Proxy to the authentik server container
    location / {
        proxy_pass http://127.0.0.1:(( proxy_port ))/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (authentik UI + outpost connections)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
