# frp client configuration (generated from etcd)
# frp now serves the production primary public HTTP/HTTPS (see
# docs/archive/frp-migration.md).
serverAddr = "{{ remote_addr.split(':')[0] }}"
serverPort = {{ remote_addr.split(':')[1] }}

auth.method = "token"
auth.token = "{{ token }}"

transport.heartbeatInterval = 40
transport.heartbeatTimeout = 40

# Forward to 127.0.0.2 so the alt nginx vhost (admin-api-alt.conf.j2)
# can serve the frp tunnel with PROXY-protocol-real client IPs. 127.0.0.1
# stays reserved for local health checks + cluster-internal traffic.
# Only the storage leader should register http/https — running this
# template on every core node would cause tunnel-name collisions.
[[proxies]]
name = "http"
type = "tcp"
remotePort = 80
localIP = "127.0.0.2"
localPort = 17080
transport.proxyProtocolVersion = "v2"

# Primary HTTPS — served on :443 (the production primary port). frps
# dynamically binds :443 for this tunnel (v0.70.0+ registers proxy
# listeners from client registrations, so no server-side listenPort change
# is needed). localPort stays :17443, so traffic lands on the alt
# admin-api-alt.conf.j2 vhost (127.0.0.2:17443 with proxy_protocol).
[[proxies]]
name = "https"
type = "tcp"
remotePort = 443
localIP = "127.0.0.2"
localPort = 17443
transport.proxyProtocolVersion = "v2"
