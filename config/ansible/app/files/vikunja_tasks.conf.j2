# HTTPS - tasks.<domain> (external Vikunja vhost)
#
# The `_tasks` suffix in the template filename is load-bearing: certbot-manager
# derives the external subdomain from everything after the last `_`, so this
# template renders tasks.<primary_domain> (same mechanism as
# forgejo_git.conf.j2 -> git.<domain>).
#
# There is deliberately no Authentik forward-auth here. Vikunja is its own
# credential boundary: the web UI logs in through OIDC, and API/CalDAV
# clients use Vikunja tokens rather than an Authentik session cookie. The
# vhost therefore proxies the whole surface without an auth_request gate.
# Public registration is disabled in Vikunja; see install-vikunja.yml.
#
# This one server block declares both the plain :443 listener and the frp
# tunnel landing (127.0.0.2:17443, PROXY protocol v2). The proxy_port marker
# is substituted by the install-vikunja.yml render step.
server {
    {% if use_tls %}
    listen 443 ssl http2;
    listen 127.0.0.2:17443 ssl http2 proxy_protocol;
    {% else %}
    listen 80;
    listen 127.0.0.2:17443 proxy_protocol;
    {% endif %}
    server_name {{ domain | default('tasks') }};

    # Trust the PROXY protocol header only from loopback (frpc, the sole
    # source that can reach 127.0.0.2). Plain :443 connections carry no
    # PROXY header and are unaffected.
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    client_max_body_size 110M;

    {% if use_tls %}
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    {% endif %}
    add_header X-Content-Type-Options nosniff always;

    location / {
        proxy_pass http://127.0.0.1:(( proxy_port ));
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Vikunja uses websockets for live updates and may stream downloads.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
