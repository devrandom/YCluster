# HTTPS - git.<domain> (external Forgejo vhost)
#
# The `_git` suffix in the template filename is load-bearing: certbot-manager
# derives the external subdomain from everything after the last `_`, so this
# template renders git.<primary_domain> (same mechanism as
# authentik_auth.conf.j2 -> auth.<domain> and zulip_zulip.conf.j2 ->
# zulip.<domain>).
#
# Forgejo itself is the auth boundary here, not Authentik forward-auth: git
# clients use tokens over HTTPS and do not carry an Authentik cookie, and the
# web UI has its own OIDC login. The vhost therefore proxies both the web
# and the git smart-HTTP/API surfaces without an auth_request gate.
#
# This one server block declares both the plain :443 listener and the frp
# tunnel landing (127.0.0.2:17443, PROXY protocol v2). The proxy_port
# marker is substituted by the install-forgejo.yml render step.
server {
    {% if use_tls %}
    listen 443 ssl http2;
    listen 127.0.0.2:17443 ssl http2 proxy_protocol;
    {% else %}
    listen 80;
    listen 127.0.0.2:17443 proxy_protocol;
    {% endif %}
    server_name {{ domain | default('git') }};

    # Trust the PROXY protocol header only from loopback (frpc, the sole
    # source that can reach 127.0.0.2). Plain :443 connections carry no
    # PROXY header and are unaffected.
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    client_max_body_size 1G;

    # Bound concurrent write requests per client IP. GET/HEAD are exempt
    # via the map in forgejo-ratelimit.conf, so web UI asset loads are not
    # counted; git push (POST) and LFS uploads (PUT) share this cap.
    limit_conn forgejo_write_conn 4;
    limit_conn_status 429;

    {% if use_tls %}
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    {% endif %}
    add_header X-Content-Type-Options nosniff always;

    location / {
        proxy_pass http://127.0.0.1:(( proxy_port ))/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Git smart HTTP and LFS are streaming protocols; do not buffer.
        proxy_request_buffering off;
        proxy_buffering off;

        # Forgejo uses websockets for live notifications and events.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
