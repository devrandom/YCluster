#!/usr/bin/env bash
# Stage ComfyUI model assets onto local host NVMe. The container never fetches
# models at runtime — it bind-mounts this dir read-only at /opt/comfyui/models
# (see comfyui.service). This is a one-time asset-staging step, run by an
# operator as the dev user:
#
#   ~/bin/seed-comfyui-models.sh                # verify already-staged weights
#   ~/bin/seed-comfyui-models.sh --download     # pull missing/invalid weights
#
# Managed by app/install-comfyui.yml — edit there.
#
# Each manifest row is tab-separated:
#   id  repo  revision  repo_path  destination_relative_path  sha256
set -eu

MODEL_HOST="${MODEL_HOST:-{{ comfyui_model_root }}}"
STAGE_ROOT="${MODEL_HOST}/.seed-staging"

# ---- flags ----
action="verify"
while [ $# -gt 0 ]; do
  case "$1" in
    --download)     action="download"; shift ;;
    --verify-only)  action="verify"; shift ;;
    -h|--help)
      sed -n '2,12p' "$0"
      exit 0
      ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac
done

