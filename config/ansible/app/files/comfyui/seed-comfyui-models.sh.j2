verify_file() {
  file="$1"
  expected="$2"
  if [ ! -f "$file" ]; then
    echo "  missing: $file" >&2
    return 1
  fi
  if [ "$expected" = "skip" ]; then
    echo "  present: $file"
    return 0
  fi
  actual=$(sha256sum "$file" | awk '{print $1}')
  if [ "$actual" != "$expected" ]; then
    echo "  hash mismatch: $file" >&2
    echo "    expected: $expected" >&2
    echo "    actual:   $actual" >&2
    return 1
  fi
  echo "  verified: $file"
}

download_one() {
  id="$1"
  repo="$2"
  revision="$3"
  source_rel="$4"
  dest_rel="$5"
  expected="$6"
  final="$MODEL_HOST/$dest_rel"
  stage="$STAGE_ROOT/$id"

  echo "== $id =="
  if verify_file "$final" "$expected"; then
    return 0
  fi
  if [ "$action" != "download" ]; then
    missing=1
    return 0
  fi

  rm -f "$final"
  mkdir -p "$stage" "$MODEL_HOST/$(dirname "$dest_rel")"
  # HF_HUB_DISABLE_XET=1 keeps large files on the regular CDN. The compute
  # node stalls against the Xet CAS endpoint, as with the original H3 seeding.
  HF_HUB_DISABLE_XET=1 uv tool run --from huggingface-hub==1.24.0 hf download \
    "$repo" \
    --revision "$revision" \
    --include "$source_rel" \
    --local-dir "$stage"

  staged="$stage/$source_rel"
  if [ ! -f "$staged" ]; then
    echo "download did not create $staged" >&2
    missing=1
    return 0
  fi
  if [ "$expected" != "skip" ]; then
    actual=$(sha256sum "$staged" | awk '{print $1}')
    if [ "$actual" != "$expected" ]; then
      echo "downloaded hash mismatch for $id" >&2
      echo "  expected: $expected" >&2
      echo "  actual:   $actual" >&2
      rm -f "$staged"
      missing=1
      return 0
    fi
  fi
  mv "$staged" "$final"
  chmod 0644 "$final"
  rm -f "$staged"
  rmdir "$(dirname "$staged")" "$stage" 2>/dev/null || true
  verify_file "$final" "$expected"
}

missing=0
mkdir -p "$MODEL_HOST" "$STAGE_ROOT"
echo "== ${action} under $MODEL_HOST =="
for row in "${MANIFEST[@]}"; do
  IFS=$'\t' read -r id repo revision source_rel dest_rel expected <<<"$row"
  download_one "$id" "$repo" "$revision" "$source_rel" "$dest_rel" "$expected"
done

if [ "$missing" -ne 0 ]; then
  echo "Incomplete model tree at $MODEL_HOST — re-run with --download" >&2
  exit 1
fi
echo
echo "Model tree is complete. Start the service with:  systemctl start comfyui"
