#!/bin/bash
set -e

# etcd client config (endpoints + TLS certs) from the single source; set -a
# exports the ETCDCTL_* vars so the bare etcdctl calls below pick them up.
set -a; . /etc/ycluster/etcd-client.env 2>/dev/null || true; set +a

ZULIP_DATA_DIR="/rbd/misc/zulip/data"
ZULIP_RABBITMQ_DIR="/rbd/misc/zulip/rabbitmq"
ZULIP_REDIS_DIR="/rbd/misc/zulip/redis"
COMPOSE_PROJECT="zulip"
ETCD_KEY_PREFIX="/cluster/config/zulip"

# Get an existing secret from etcd, or generate one and store it atomically
# (txn: put only if the key doesn't exist, then read back whatever won).
get_or_generate_secret() {
    local etcd_key="${ETCD_KEY_PREFIX}/$1"
    local generator="$2"

    local existing=$(etcdctl get "$etcd_key" --print-value-only 2>/dev/null || true)
    if [ -n "$existing" ]; then
        echo "$existing"
        return 0
    fi

    local new_value=$($generator)
    local txn=$(cat <<EOF
version("$etcd_key") = "0"

put "$etcd_key" "$new_value"

get "$etcd_key" --print-value-only
EOF
)
    # need to echo trailing newlines because here-doc strips them
    echo -e "$txn\n\n" | etcdctl txn > /dev/null

    etcdctl get "$etcd_key" --print-value-only
}

gen_secret_key() { openssl rand -base64 48 | tr -d '\n'; }
gen_password()   { openssl rand -base64 18 | tr -d '\n'; }

# Generate (idempotently) every secret the stack needs into etcd. The
# Postgres password here must equal the `zulip` role password created by
# install-zulip.yml — both read the same etcd key.
ensure_secrets() {
    get_or_generate_secret postgres_password gen_password >/dev/null
    get_or_generate_secret memcached_password gen_password >/dev/null
    get_or_generate_secret rabbitmq_password gen_password >/dev/null
    get_or_generate_secret redis_password gen_password >/dev/null
    get_or_generate_secret secret_key gen_secret_key >/dev/null
}

# Function to wait for the Docker registry to be available
# This handles the race condition during storage leader failover
wait_for_registry() {
    local max_attempts=12  # 12 attempts
    local delay=5          # 5 seconds between attempts = 60s total
    local attempt=1

    while [ $attempt -le $max_attempts ]; do
        if curl -sf --max-time 3 "http://registry.xc:5000/v2/" > /dev/null 2>&1; then
            return 0
        fi
        echo "Waiting for registry (attempt $attempt/$max_attempts)..."
        sleep $delay
        attempt=$((attempt + 1))
    done

    echo "Registry not available after $((max_attempts * delay)) seconds"
    return 1
}

SAML_IDP_CERT="/rbd/misc/zulip/saml/idps/authentik.crt"

# Fetch the IdP signing certificate from the leader's Authentik API and write
# it to the RBD path that compose bind-mounts read-only into the container at
# /opt/saml/authentik.crt, referenced via SOCIAL_AUTH_SAML_ENABLED_IDPS
# ["x509cert_path"]. The SAML provider (authentik-manager write_zulip_blueprint)
# signs responses
# with the `authentik Self-signed Certificate` keypair, so that keypair's
# public cert is exactly what Zulip validates the responses against.
#
# Rerun on every start (and on leader failover) so it follows the RBD like
# the rest of /rbd/misc/zulip. On a fresh install the keypair exists as soon
# as Authentik is up — independently of the blueprint being applied — so
# there is no ordering dependency on the SAML provider. On Authentik
# being unreachable we write an empty placeholder so the compose bind mount
# still resolves and Zulip boots with email auth only (SAML comes back on the
# next restart once Authentik is available).
ensure_saml_cert() {
    mkdir -p "$(dirname "$SAML_IDP_CERT")"
    local token
    token=$(etcdctl get /cluster/config/authentik/bootstrap-token --print-value-only 2>/dev/null || true)
    if [ -z "$token" ]; then
        echo "SAML: authentik bootstrap token unavailable"
        : > "$SAML_IDP_CERT"
        return 1
    fi
    local auth_port="${AUTHENTIK_PORT:-9300}"
    local base="http://127.0.0.1:$auth_port/api/v3"
    local kp_json
    kp_json=$(curl -sS --max-time 10 -H "Authorization: Bearer $token" \
        "$base/crypto/certificatekeypairs/?search=authentik%20Self-signed" 2>/dev/null || true)
    local dl
    dl=$(printf '%s' "$kp_json" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for p in d.get("results", []):
    if p.get("name") == "authentik Self-signed Certificate" and p.get("certificate_download_url"):
        print(p["certificate_download_url"])
        break
')
    if [ -z "$dl" ]; then
        echo "SAML: authentik signing keypair not found"
        : > "$SAML_IDP_CERT"
        return 1
    fi
    local tmp="$SAML_IDP_CERT.tmp"
    if ! curl -sS -f --max-time 10 -H "Authorization: Bearer $token" \
        "http://127.0.0.1:$auth_port$dl" -o "$tmp"; then
        echo "SAML: IdP cert download failed"
        : > "$SAML_IDP_CERT"
        return 1
    fi
    if ! grep -q -- "-----BEGIN CERTIFICATE-----" "$tmp"; then
        echo "SAML: downloaded cert is not a valid PEM"
        : > "$SAML_IDP_CERT"
        rm -f "$tmp"
        return 1
    fi
    mv "$tmp" "$SAML_IDP_CERT"
    chown 1000:1000 "$SAML_IDP_CERT"
    chmod 644 "$SAML_IDP_CERT"
    return 0
}

# Render the SAML settings for the compose env file, derived from the same
# /cluster/https/domain value that authentik-manager's Zulip blueprint uses
# (single source). The dict values are written as Python literals:
# docker-zulip's setConfigurationValue treats env starting with `{` as a
# Python object and appends it verbatim to settings.py. attr_user_permanent_id
# points at Authentik's managed `uid` mapping (user pk), which differs from
# attr_email so Zulip keeps email-change sync enabled.
render_saml_env() {
    local external_domain="$1"
    local sp_entity="https://zulip.$external_domain/"
    local idp_entity="https://auth.$external_domain/"
    local sso_url="https://auth.$external_domain/application/saml/zulip/sso/binding/redirect/"
    echo "ZULIP_SAML_SP_ENTITY_ID=$sp_entity"
    echo "ZULIP_SAML_ORG_INFO={\"en-US\": {\"name\": \"YCluster\", \"displayname\": \"YCluster\", \"url\": \"https://zulip.$external_domain/\"}}"
    echo "ZULIP_SAML_ENABLED_IDPS={\"authentik\": {\"entity_id\": \"$idp_entity\", \"url\": \"$sso_url\", \"x509cert_path\": \"/opt/saml/authentik.crt\", \"attr_user_permanent_id\": \"http://schemas.goauthentik.io/2021/02/saml/uid\", \"attr_full_name\": \"http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name\", \"attr_username\": \"http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress\", \"attr_email\": \"http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress\", \"auto_signup\": True, \"display_name\": \"YCluster\"}}"
    echo "ZULIP_SAML_CERT=$SAML_IDP_CERT"
}

start_zulip() {
    ensure_secrets

    # RBD-backed data dirs (misc-rbd.service dependency ensures /rbd/misc
    # is mounted). The zulip container runs as uid 1000 (the image's zulip
    # user); rabbitmq:4.2 and redis:alpine run as uid/gid 999. The entrypoint
    # chowns /data/uploads itself, but the bind dirs need the right owner up
    # front so the containers can write.
    mkdir -p "$ZULIP_DATA_DIR" "$ZULIP_RABBITMQ_DIR" "$ZULIP_REDIS_DIR"
    chown -R 1000:1000 "$ZULIP_DATA_DIR"
    chown -R 999:999 "$ZULIP_RABBITMQ_DIR" "$ZULIP_REDIS_DIR"

    # External host: zulip.<domain> once an https domain exists, else the
    # internal zulip.xc name (no TLS / no external URL yet).
    local external_domain
    external_domain=$(etcdctl get /cluster/https/domain --print-value-only 2>/dev/null || true)
    local zulip_external_host="$external_domain"
    if [ -n "$zulip_external_host" ]; then
        zulip_external_host="zulip.$zulip_external_host"
    else
        zulip_external_host="zulip.xc"
    fi
    local admin_email="${ZULIP_ADMIN_EMAIL:-zulip-admin@$zulip_external_host}"

    local env_file=$(mktemp --tmpdir=/dev/shm)
    trap "rm -f '$env_file'" EXIT

    echo "ZULIP_VERSION=${ZULIP_VERSION:?ZULIP_VERSION must be set by the unit}" > "$env_file"
    echo "ZULIP_IMAGE=registry.xc:5000/zulip" >> "$env_file"
    echo "ZULIP_PORT=${ZULIP_PORT:-8484}" >> "$env_file"
    echo "ZULIP_EGRESS_SUBNET=${ZULIP_EGRESS_SUBNET:-172.16.0.0/24}" >> "$env_file"
    echo "ZULIP_EXTERNAL_HOST=$zulip_external_host" >> "$env_file"
    echo "ZULIP_ADMIN_EMAIL=$admin_email" >> "$env_file"
    # Hosted push service via push.zulipchat.com. On by default; the install
    # unit passes ZULIP_PUSH_NOTIFICATIONS / ZULIP_SUBMIT_USAGE_STATISTICS
    # (True/False) so both stay explicit and operator-tunable. Usage-statistics
    # submission is off by decision.
    echo "ZULIP_PUSH_NOTIFICATIONS=${ZULIP_PUSH_NOTIFICATIONS:-True}" >> "$env_file"
    echo "ZULIP_SUBMIT_USAGE_STATISTICS=${ZULIP_SUBMIT_USAGE_STATISTICS:-False}" >> "$env_file"

    # SAML (design step 5): fetch the IdP signing cert and, when available,
    # enable the SAML auth backend alongside email. Idempotent on every start
    # and follows the RBD on leader failover; falls back to email-only if
    # Authentik is unreachable (SAML comes back on the next restart). An
    # explicit ZULIP_AUTH_BACKENDS from the unit (e.g. SAML-only, or email-only
    # during an outage) takes precedence over the auto-detected default for the
    # backend set, but the SAML IdP settings are still rendered whenever
    # SAMLAuthBackend is actually active (see below).
    ensure_saml_cert || true
    local auth_backends="${ZULIP_AUTH_BACKENDS:-EmailAuthBackend}"
    if [ -z "${ZULIP_AUTH_BACKENDS:-}" ] \
        && grep -q -- "-----BEGIN CERTIFICATE-----" "$SAML_IDP_CERT" 2>/dev/null; then
        auth_backends="EmailAuthBackend,SAMLAuthBackend"
    fi
    # Render the SAML IdP settings whenever SAMLAuthBackend is in the effective
    # backend set and the IdP cert is in place — not only on the auto-detected
    # path. Otherwise an explicit SAML-only flip (ZULIP_AUTH_BACKENDS=
    # SAMLAuthBackend) boots with the backend active but no
    # SOCIAL_AUTH_SAML_ENABLED_IDPS config, which 500s on SAML logout
    # (KeyError: 'authentik') and breaks new SAML logins.
    case ",$auth_backends," in
        ",SAMLAuthBackend,")
            # SAML-only starts are unusable without the IdP config, so retry
            # briefly while Authentik finishes starting rather than exposing a
            # login button that cannot complete its round trip.
            if ! grep -q -- "-----BEGIN CERTIFICATE-----" "$SAML_IDP_CERT" 2>/dev/null; then
                local attempt=0
                while ! grep -q -- "-----BEGIN CERTIFICATE-----" "$SAML_IDP_CERT" 2>/dev/null; do
                    if [ "$attempt" -eq 30 ]; then
                        echo "SAML: IdP certificate unavailable for SAML-only start"
                        return 1
                    fi
                    echo "SAML: waiting for Authentik IdP certificate ($((attempt + 1))/30)"
                    attempt=$((attempt + 1))
                    sleep 2
                    ensure_saml_cert || true
                done
            fi
            ;;
    esac
    if grep -q -- "-----BEGIN CERTIFICATE-----" "$SAML_IDP_CERT" 2>/dev/null; then
        case ",$auth_backends," in
            *,SAMLAuthBackend,*) render_saml_env "$external_domain" >> "$env_file" ;;
        esac
    fi
    echo "ZULIP_AUTH_BACKENDS=$auth_backends" >> "$env_file"
    echo "ZULIP__POSTGRES_PASSWORD=$(get_or_generate_secret postgres_password gen_password)" >> "$env_file"
    echo "ZULIP__MEMCACHED_PASSWORD=$(get_or_generate_secret memcached_password gen_password)" >> "$env_file"
    echo "ZULIP__RABBITMQ_PASSWORD=$(get_or_generate_secret rabbitmq_password gen_password)" >> "$env_file"
    echo "ZULIP__REDIS_PASSWORD=$(get_or_generate_secret redis_password gen_password)" >> "$env_file"
    echo "ZULIP__SECRET_KEY=$(get_or_generate_secret secret_key gen_secret_key)" >> "$env_file"

    # Wait for registry to be available (handles storage leader failover)
    if ! wait_for_registry; then
        echo "Failed to connect to registry, aborting startup"
        return 1
    fi

    # Refresh the egress filter and the managed /etc/hosts source before the
    # stack comes up, so the bind-mounted file (see zulip-compose.yaml) exists
    # with current push-bouncer addresses even if the 15-min timer hasn't
    # fired yet on a fresh leader tenure. Idempotent; a no-op when the egress
    # filter playbook flag is off (script absent).
    if [ -x /usr/local/lib/cluster/setup-zulip-egress ]; then
        /usr/local/lib/cluster/setup-zulip-egress
    fi

    cd /etc/zulip
    docker compose -p "$COMPOSE_PROJECT" --env-file "$env_file" up --pull=always
    return 0
}

stop_zulip() {
    echo "Stopping Zulip"
    cd /etc/zulip
    docker compose -p "$COMPOSE_PROJECT" down
    echo "Zulip stopped"
}

case "$1" in
    start)
        if start_zulip; then
            echo "Zulip successfully started"
            exit 0
        else
            echo "Failed to start Zulip"
            exit 1
        fi
        ;;
    stop)
        stop_zulip
        ;;
    ensure-secrets)
        # Used by install-zulip.yml on the leader so the Postgres role can be
        # created with the same password Zulip will read at first boot.
        ensure_secrets
        ;;
    register-push)
        # Register this server with the Zulip-hosted push-notification service
        # (push.zulipchat.com). Requires the stack to be running. Re-running is
        # idempotent for the same hostname/contact (Zulip re-applies the
        # registration); if EXTERNAL_HOST ever changes, use Zulip's
        # --registration-transfer path instead. --agree-to-terms-of-service
        # skips the interactive prompt so the step is scriptable.
        cd /etc/zulip
        docker compose -p "$COMPOSE_PROJECT" exec -T zulip su zulip -c \
            '/home/zulip/deployments/current/manage.py register_server --agree-to-terms-of-service'
        ;;
    *)
        echo "Usage: $0 {start|stop|ensure-secrets|register-push}"
        exit 1
        ;;
esac
