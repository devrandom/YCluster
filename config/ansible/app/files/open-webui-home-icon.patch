+	// Link to the YCluster landing page at the apex domain. Open-WebUI is served
+	// at chat.<domain>, so derive the root home from the current hostname by
+	// dropping the first label; hide the icon when there is no subdomain to strip.
+	const homeHref =
+		typeof window !== 'undefined'
+			? (() => {
+					const labels = window.location.hostname.split('.');
+					return labels.length > 1
+						? `${window.location.protocol}//${labels.slice(1).join('.')}/`
+						: null;
+			  })()
+			: null;
 </script>
 
