#!/bin/bash
set -e

# etcd client config (endpoints + TLS certs) from the single source; set -a
# exports the ETCDCTL_* vars so the bare etcdctl calls below pick them up.
set -a; . /etc/ycluster/etcd-client.env 2>/dev/null || true; set +a

AUTHENTIK_DATA_DIR="/rbd/misc/authentik"
COMPOSE_PROJECT="authentik"
ETCD_KEY_PREFIX="/cluster/config/authentik"

# Get an existing secret from etcd, or generate one and store it atomically
# (txn: put only if the key doesn't exist, then read back whatever won).
get_or_generate_secret() {
    local etcd_key="${ETCD_KEY_PREFIX}/$1"
    local generator="$2"

    local existing=$(etcdctl get "$etcd_key" --print-value-only 2>/dev/null || true)
    if [ -n "$existing" ]; then
        echo "$existing"
        return 0
    fi

    local new_value=$($generator)
    local txn=$(cat <<EOF
version("$etcd_key") = "0"

put "$etcd_key" "$new_value"

get "$etcd_key" --print-value-only
EOF
)
    # need to echo trailing newlines because here-doc strips them
    echo -e "$txn\n\n" | etcdctl txn > /dev/null

    etcdctl get "$etcd_key" --print-value-only
}

gen_secret_key() { openssl rand -base64 48 | tr -d '\n'; }
gen_password()   { openssl rand -base64 18 | tr -d '\n'; }
gen_token()      { openssl rand -hex 32; }

# The Open-WebUI OIDC provider blueprint needs two runtime values (the
# etcd-sourced client secret and the external domain), so it is written
# here at service start rather than by Ansible like the static blueprints.
# open-webui-manager reads the same etcd key for the client side.
write_owui_blueprint() {
    local external_domain="$1"
    local client_secret="$2"
    local bp=/etc/authentik/blueprints/ycluster-owui.yaml
    cat > "$bp" <<EOF
# Written by authentik-manager at service start — do not edit.
version: 1
metadata:
  name: ycluster-owui
entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: provider-owui
    identifiers:
      name: open-webui
    attrs:
      client_type: confidential
      client_id: open-webui
      client_secret: "$client_secret"
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      sub_mode: user_email
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
      redirect_uris:
        - matching_mode: strict
          url: https://$external_domain/oauth/oidc/callback
  - model: authentik_core.application
    identifiers:
      slug: open-webui
    attrs:
      name: Open WebUI
      provider: !KeyOf provider-owui
      meta_launch_url: https://$external_domain/
EOF
    chown 1000:1000 "$bp"
    chmod 600 "$bp"
}

# Forward-auth for the admin web pages: proxy provider on the embedded
# outpost + application gated to the ycluster-admins group. Written here
# for the same reason as the OWUI blueprint (needs the external domain).
# Keep flow slugs / shared settings in sync with write_owui_blueprint.
# ycluster-managers is the view-only counterpart — created alongside
# admins so a fresh install doesn't need a separate bootstrap step.
write_admin_blueprint() {
    local external_domain="$1"
    local bp=/etc/authentik/blueprints/ycluster-admin.yaml
    cat > "$bp" <<EOF
# Written by authentik-manager at service start — do not edit.
version: 1
metadata:
  name: ycluster-admin
entries:
  - model: authentik_core.group
    id: group-admins
    identifiers:
      name: ycluster-admins
  - model: authentik_core.group
    id: group-managers
    identifiers:
      name: ycluster-managers
  - model: authentik_providers_proxy.proxyprovider
    id: provider-admin
    identifiers:
      name: cluster-admin
    attrs:
      mode: forward_single
      external_host: https://admin.$external_domain
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
  - model: authentik_core.application
    id: app-admin
    identifiers:
      slug: cluster-admin
    attrs:
      name: YCluster Admin
      provider: !KeyOf provider-admin
      meta_launch_url: https://admin.$external_domain/inventory
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-admin
      group: !KeyOf group-admins
      order: 0
  # User-facing app surface (app.<domain>): self-service VM scheduling.
  # No policy binding -> visible and usable by every enrolled user; the
  # Flask app owner-scopes per VM. nginx serves only the vm-schedule paths
  # on this host, so admin-only pages aren't reachable here.
  - model: authentik_providers_proxy.proxyprovider
    id: provider-app
    identifiers:
      name: cluster-app
    attrs:
      mode: forward_single
      external_host: https://app.$external_domain
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
  - model: authentik_core.application
    id: app-app
    identifiers:
      slug: ycluster
    attrs:
      name: YCluster
      provider: !KeyOf provider-app
      meta_launch_url: https://app.$external_domain/
  # ComfyUI (comfy.<domain>): the MiniMax H3 video backend. Access is granted
  # to the `comfy` group (members added by an admin) plus the ycluster-admins
  # group; a user in neither sees no entry and the auth subrequest 401s.
  - model: authentik_core.group
    id: group-comfy
    identifiers:
      name: comfy
  - model: authentik_providers_proxy.proxyprovider
    id: provider-comfy
    identifiers:
      name: comfy
    attrs:
      mode: forward_single
      external_host: https://comfy.$external_domain
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
  - model: authentik_core.application
    id: app-comfy
    identifiers:
      slug: comfy
    attrs:
      name: Comfy
      provider: !KeyOf provider-comfy
      meta_launch_url: https://comfy.$external_domain/
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-comfy
      group: !KeyOf group-comfy
      order: 0
  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf app-comfy
      group: !KeyOf group-admins
      order: 0
  - model: authentik_outposts.outpost
    identifiers:
      managed: goauthentik.io/outposts/embedded
    attrs:
      providers:
        - !KeyOf provider-admin
        - !KeyOf provider-app
        - !KeyOf provider-comfy
      config:
        authentik_host: https://auth.$external_domain
EOF
    chown 1000:1000 "$bp"
    chmod 600 "$bp"
}

# Zulip SAML provider (zulip.<domain> -> cluster IdP). Mirrors
# write_owui_blueprint but for SAML: a provider that signs responses with
# the shared `authentik Self-signed Certificate`, plus the `zulip`
# application. Attribute claims reuse Authentik's managed SAML property
# mappings so the URIs Zulip's SOCIAL_AUTH_SAML_ENABLED_IDPS references are
# what Authentik actually emits:
#   - email/name -> the WS .../identity/claims/* URIs
#   - username   -> schemas.goauthentik.io .../saml/username
#   - permanent-id (user pk) -> goauthentik.io .../saml/uid (differs from
#     email, so Zulip keeps email-change sync enabled)
# The SSO URL Authentik exposes is derived from the application slug
# (`zulip`) and the IdP base URL (https://auth.<domain>/); zulip-manager
# reads the same domain so the Zulip-side entity_id/url stay in sync.
write_zulip_blueprint() {
    local external_domain="$1"
    local bp=/etc/authentik/blueprints/ycluster-zulip.yaml
    cat > "$bp" <<EOF
# Written by authentik-manager at service start — do not edit.
version: 1
metadata:
  name: ycluster-zulip
entries:
  - model: authentik_providers_saml.samlprovider
    id: provider-zulip
    identifiers:
      name: authentik
    attrs:
      acs_url: https://zulip.$external_domain/complete/saml/
      sls_url: https://zulip.$external_domain/complete/saml/
      audience: https://zulip.$external_domain/
      issuer: https://auth.$external_domain/
      signing_kp: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      # Zulip does not sign its SP AuthnRequest, so SP request verification
      # must be disabled explicitly (null) — omitting the key leaves the
      # existing value in place on an additive blueprint re-apply.
      verification_kp: null
      # Zulip (python-social-auth) posts the AuthnResponse to /complete/saml/
      # and requires the response to be signed (wantMessagesSigned), so send
      # back over POST (lowercase per the Authentik serializer) and sign both
      # the response and the assertion.
      sp_binding: post
      sign_response: true
      sign_assertion: true
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      property_mappings:
        - !Find [authentik_providers_saml.samlpropertymapping, [managed, goauthentik.io/providers/saml/email]]
        - !Find [authentik_providers_saml.samlpropertymapping, [managed, goauthentik.io/providers/saml/name]]
        - !Find [authentik_providers_saml.samlpropertymapping, [managed, goauthentik.io/providers/saml/username]]
        - !Find [authentik_providers_saml.samlpropertymapping, [managed, goauthentik.io/providers/saml/uid]]
  - model: authentik_core.application
    identifiers:
      slug: zulip
    attrs:
      name: Zulip
      provider: !KeyOf provider-zulip
      meta_launch_url: https://zulip.$external_domain/
EOF
    chown 1000:1000 "$bp"
    chmod 600 "$bp"
}

# Write the domain-dependent blueprints (OWUI OIDC client + admin/app
# forward-auth + Zulip SAML). Only once an external domain exists — redirect
# URIs and launch URLs are external-only. The authentik worker watches the
# blueprint dir and auto-applies on change, so refreshing these needs no
# container restart (see the `write-blueprints` command).
write_all_blueprints() {
    local external_domain=$(etcdctl get /cluster/https/domain --print-value-only 2>/dev/null || true)
    if [ -n "$external_domain" ]; then
        write_owui_blueprint "$external_domain" \
            "$(get_or_generate_secret owui-client-secret gen_token)"
        write_admin_blueprint "$external_domain"
        write_zulip_blueprint "$external_domain"
    fi
}

start_authentik() {
    # Data directories with authentik's in-container uid/gid (1000)
    # (misc-rbd.service dependency ensures /rbd/misc is mounted)
    mkdir -p "$AUTHENTIK_DATA_DIR"/{media,custom-templates,certs}
    chown -R 1000:1000 "$AUTHENTIK_DATA_DIR"

    # Rootless Incus workaround: docker0 may be NO-CARRIER with no IP
    # after a Docker restart, breaking host.docker.internal. Re-add it.
    ip addr show docker0 2>/dev/null | grep -q '172.17.0.1' \
        || ip addr add 172.17.0.1/16 dev docker0 2>/dev/null || true

    local secret_key=$(get_or_generate_secret secret-key gen_secret_key)
    local bootstrap_password=$(get_or_generate_secret bootstrap-password gen_password)
    local bootstrap_token=$(get_or_generate_secret bootstrap-token gen_token)

    write_all_blueprints

    local env_file=$(mktemp --tmpdir=/dev/shm)
    trap "rm -f '$env_file'" EXIT

    echo "AUTHENTIK_SECRET_KEY=$secret_key" > "$env_file"
    echo "AUTHENTIK_BOOTSTRAP_PASSWORD=$bootstrap_password" >> "$env_file"
    echo "AUTHENTIK_BOOTSTRAP_TOKEN=$bootstrap_token" >> "$env_file"
    echo "AUTHENTIK_TAG=${AUTHENTIK_TAG:?AUTHENTIK_TAG must be set by the unit}" >> "$env_file"
    echo "AUTHENTIK_PORT=${AUTHENTIK_PORT:-9300}" >> "$env_file"
    echo "AUTHENTIK_DATA_DIR=$AUTHENTIK_DATA_DIR" >> "$env_file"
    echo "AUTHENTIK_DB_USER=authentik" >> "$env_file"
    echo "AUTHENTIK_DB_PASS=authentik" >> "$env_file"
    echo "AUTHENTIK_DB_NAME=authentik" >> "$env_file"

    cd /etc/authentik
    docker compose -p "$COMPOSE_PROJECT" --env-file "$env_file" up -d

    # Wait for the server to be ready, then sync the bootstrap token:
    # set its key to the etcd value and its expiry to never (authentik
    # creates bootstrap tokens with a 48h expiry by default).
    local token_key="$bootstrap_token"
    for i in $(seq 1 30); do
        docker exec authentik-server curl -sS -o /dev/null \
            http://127.0.0.1:9000/-/health/live/ 2>/dev/null || { sleep 2; continue; }
        docker exec -e DJANGO_SETTINGS_MODULE=authentik.root.settings \
            authentik-server python3 -c "
import django; django.setup()
from authentik.core.models import Token
try:
    t = Token.objects.get(identifier='authentik-bootstrap-token')
except Token.DoesNotExist:
    pass
else:
    t.key = '$token_key'
    t.expires = None
    t.save()
" 2>/dev/null && break
        sleep 2
    done

    # Re-attach in the foreground so systemd sees the service alive.
    # On SIGTERM, stop_authentik runs `docker compose down`.
    exec docker compose -p "$COMPOSE_PROJECT" --env-file "$env_file" up
}

stop_authentik() {
    echo "Stopping authentik"
    cd /etc/authentik
    docker compose -p "$COMPOSE_PROJECT" down
    echo "authentik stopped"
}

case "$1" in
    start)
        start_authentik
        ;;
    stop)
        stop_authentik
        ;;
    write-blueprints)
        # Rewrite the domain-dependent blueprints without restarting the
        # containers; the worker auto-applies. Used by install-authentik's
        # handler so a manager update refreshes blueprints with no outage,
        # and by `ycluster https set-domain`.
        write_all_blueprints
        ;;
    *)
        echo "Usage: $0 {start|stop|write-blueprints}"
        exit 1
        ;;
esac
