# zulip.<domain> — Zulip chat server (external certbot-managed vhost).
#
# The `_zulip` suffix in the filename is load-bearing: certbot-manager
# derives the external subdomain from everything after the last `_` in the
# template name, so this template renders `zulip.<primary_domain>` (same
# mechanism as authentik_auth.conf.j2 → auth.<domain>). The server block
# declares both listeners — the plain :443/:80 listener and the frp tunnel
# landing (127.0.0.2:17443, PROXY protocol v2).
#
# zulip.<domain> is edge-gated by the cluster IdP embedded-outpost
# forward-auth: auth_request /outpost.goauthentik.io/auth/nginx runs before
# any bytes reach the Zulip container for the interactive web surface
# (everything except /api/) — same boundary as ComfyUI / admin-api. Zulip
# still has its own SAML login (against the same IdP) for the app-level
# session. /api/ is deliberately NOT gated: non-browser API clients
# (mobile/desktop apps, bots, integrations) authenticate with Zulip API
# keys / basic auth, not an authentik cookie, so Zulip itself is the
# credential gate there — that pre-auth surface is what tiers Zulip P0-U.
#
# The location body is shared across the plain and proxy listeners via
# zulip-locations.conf, whose port marker is substituted by the
# install-zulip.yml render step — the same double-parenthesis convention as
# install-open-webui.yml / install-comfyui.yml.
#
# NOTE: this file is rendered with an alternate variable delimiter, so the
# comment above must not contain a literal double-parenthesis port reference
# (port is only supplied to the zulip-locations.conf render, not this one).
server {
    {% if use_tls %}
    listen 443 ssl http2;
    listen 127.0.0.2:17443 ssl http2 proxy_protocol;
    {% else %}
    listen 80;
    listen 127.0.0.2:17443 proxy_protocol;
    {% endif %}
    server_name {{ domain | default('zulip') }};

    # Trust the PROXY protocol header only from loopback (frpc, the sole
    # source that can reach 127.0.0.2). Plain :443 connections carry no
    # PROXY header and are unaffected.
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    # Zulip allows file uploads in messages; don't cap small.
    client_max_body_size 100M;

    {% if use_tls %}
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    {% endif %}
    add_header X-Content-Type-Options nosniff always;

    # IdP outpost plumbing (login redirect, OAuth callback, auth subrequest)
    # for the edge forward-auth gate on location /. The outpost selects the
    # matching application for zulip.<domain> by the request Host.
    include /etc/nginx/admin-api-authentik-outpost.conf;

    include /etc/nginx/zulip-locations.conf;
}
