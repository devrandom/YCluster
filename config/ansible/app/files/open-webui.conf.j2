# HTTPS/HTTP - Open WebUI
#
# Single source of truth for the <primary> web surface. This one server
# block declares both listeners:
#   - the cluster-internal / direct listener (plain :443/:80), and
#   - the frp tunnel landing (127.0.0.2:17080/17443, PROXY protocol v2).
# External traffic arrives via frps -> frpc on the loopback alt address,
# where frps injects the PROXY header so real client IPs survive; internal
# or direct hits use the plain listener. frp is the only tunnel, so
# per-client rate-limit semantics are possible on the proxy path.
server {
    {% if use_tls %}
    listen 443 ssl http2;
    listen 127.0.0.2:17443 ssl http2 proxy_protocol;
    {% else %}
    listen 80;
    listen 127.0.0.2:17443 proxy_protocol;
    {% endif %}
    server_name {{ domain | default('_') }};

    # Trust the PROXY protocol header only from loopback: frpc is the
    # sole source that can reach 127.0.0.2. Plain connections on :443/:80
    # carry no PROXY header and are unaffected.
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;

    client_max_body_size 20M;

    {% if use_tls %}
    # SSL configuration
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;

    # SSL security settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    {% endif %}
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;

    {% if domain == primary %}
    # IdP outpost plumbing (login redirect, OAuth callback, auth subrequest)
    # for the edge forward-auth gate on location /. The outpost selects the
    # matching application for chat.<domain> by the request Host.
    include /etc/nginx/admin-api-authentik-outpost.conf;

    # The OWUI `location /` body lives in a shared include so both the
    # plain and proxy listeners proxy to the same backend.
    # `(( port ))` is the open-webui port, substituted by the
    # install-open-webui.yml render step. The cluster inference API
    # (`/v1/`) and its `/healthz` probe live at the root <domain> vhost,
    # not on chat.<domain>.
    include /etc/nginx/open-webui-locations.conf;
    {% else %}
    # Named stages are not edge-gated (the manager does not trust the
    # Authentik headers there); Open WebUI's own login form handles auth.
    include /etc/nginx/open-webui-stage-locations.conf;
    {% endif %}
}
