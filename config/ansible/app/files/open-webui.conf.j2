# HTTPS/HTTP - Open WebUI
#
# Listens on both the wildcard address (cluster-internal access) and
# 127.0.0.2 (rathole public tunnel endpoint, shared with admin-api +
# ycluster_app nginx vhosts — see admin-api.conf.j2). The admin-api
# public vhost has its own explicit `listen 127.0.0.2:443` with
# server_name `_` as a 404 fallback; since open-webui sets an explicit
# server_name below, nginx routes main-domain traffic here and admin.*
# / app.* traffic to their respective vhosts on the same address.
# External traffic on dev1.<domain> arrives via rathole → 127.0.0.2:443
# (no PROXY protocol — rathole 0.5.0 doesn't speak it), so real client
# IPs are not preserved on this path; rate-limit zones act as global
# buckets. The frp-side equivalent lives on 127.0.0.2:17443 and is
# served by the alt vhost (admin-api-alt.conf.j2) with proxy_protocol.
server {
    {% if use_tls %}
    listen 443 ssl http2;
    listen 127.0.0.2:443 ssl http2;
    {% else %}
    listen 80;
    listen 127.0.0.2:80;
    {% endif %}
    server_name {{ domain | default('_') }};

    client_max_body_size 20M;

    {% if use_tls %}
    # SSL configuration
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;

    # SSL security settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    {% endif %}
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Location bodies (auth subrequest, /v1/, /) live in a shared include
    # so the alt vhost (admin-api-alt.conf.j2) can serve open-webui on
    # 127.0.0.2:17443 without duplicating them. `(( port ))` is the open-
    # webui port, substituted by the install-open-webui.yml render step.
    include /etc/nginx/open-webui-locations.conf;
}
