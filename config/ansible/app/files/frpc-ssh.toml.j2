# frp SSH-only client configuration (generated from etcd)
serverAddr = "{{ remote_addr.split(':')[0] }}"
serverPort = {{ remote_addr.split(':')[1] }}

auth.method = "token"
auth.token = "{{ token }}"

transport.heartbeatInterval = 40
transport.heartbeatTimeout = 40

# One SSH proxy per core node. The remote port follows the historical
# rathole convention (17200+idx). The idx comes from the hostname `s<N>`.
[[proxies]]
name = "ssh{{ idx }}"
type = "tcp"
remotePort = {{ 17200 + idx }}
localIP = "127.0.0.1"
localPort = 22
