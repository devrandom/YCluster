# rathole client configuration (generated from etcd)
# HTTP/HTTPS were moved to frp; rathole only carries SSH/admin/bastion now.
[client]
remote_addr = "{{ remote_addr }}"
default_token = "{{ token }}"
heartbeat_timeout = 40
retry_interval = 1

[client.transport]
type = "tcp"

[client.transport.tcp]
nodelay = true
keepalive_secs = 20
keepalive_interval = 8
