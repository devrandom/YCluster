# Bash completions for:
#   - the `inference` shell function in contrib/inference-completion.bash
#     (symlinked into the user bash-completion dir)
#   - the `just` command itself (cargo-installed; built-in via
#     `just --completions bash`)
# Both target the same XDG default
# $HOME/.local/share/bash-completion/completions. Override with
# BASH_COMPLETION_USER_DIR.

COMPLETION_DIR := env_var_or_default('BASH_COMPLETION_USER_DIR', env('HOME') + '/.local/share/bash-completion/completions')
INFERENCE_SRC := absolute_path('contrib/inference-completion.bash')
INFERENCE_DST := COMPLETION_DIR + '/inference'
JUST_DST := COMPLETION_DIR + '/just'

install-completions:
    @mkdir -p "{{COMPLETION_DIR}}"
    ln -sf "{{INFERENCE_SRC}}" "{{INFERENCE_DST}}"
    @echo "linked {{INFERENCE_DST}} -> {{INFERENCE_SRC}}"
    just --completions bash > "{{JUST_DST}}"
    @echo "wrote {{JUST_DST}}"

uninstall-completions:
    @target="$(readlink {{INFERENCE_DST}} 2>/dev/null || true)"; \
    if [ "$target" = "{{INFERENCE_SRC}}" ]; then \
        rm -f {{INFERENCE_DST}} && echo "removed {{INFERENCE_DST}}"; \
    else \
        echo "{{INFERENCE_DST}} is not a symlink to {{INFERENCE_SRC}} (skipping)"; \
    fi
    @head -1 "{{JUST_DST}}" 2>/dev/null | grep -q '^eval "\$(JUST_COMPLETE=' && \
        rm -f {{JUST_DST}} && echo "removed {{JUST_DST}}" || \
        echo "{{JUST_DST}} not generated by install-completions (skipping)"
