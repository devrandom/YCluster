#!/usr/bin/env python3
"""Inference CLI — quick smoke tests against the cluster gateway.

Subcommands:
  chat <model>      Stream a one-shot chat completion + tokenizer round-trip.
                    Reasoning streams in dim gray, the answer at normal weight,
                    then prints ttft / tok/s / total stats. (default)
  models            List model ids available on the gateway.
  transcribe <file> POST an audio file to /v1/audio/transcriptions and print
                    the transcript. Optional --diarize adds speaker labels.

Endpoint + bearer token come from config.yml at the repo root via
contrib/_cluster_config.py. The model id comes from the first positional
argument or the MODEL env var.

Usage:
  ./inference chat MiniMaxAI/MiniMax-M2.7
  ./inference models
  ./inference transcribe tmp/ES2002d.Mix-Headset.wav
  ./inference transcribe tmp/ES2002d.Mix-Headset.wav --diarize
  MODEL=<id> ./inference chat
  ./inference MiniMaxAI/MiniMax-M2.7      # defaults to chat
"""
import argparse
import json
import os
import secrets
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _cluster_config

DIM = "\033[2m"
RESET = "\033[0m"


def _load_config():
    cfg = _cluster_config.load()
    return cfg.endpoint, cfg.token


def _get(base, key, path, timeout=30):
    req = urllib.request.Request(
        base + path, headers={"Authorization": f"Bearer {key}"}
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read())


def _post(base, key, path, body, timeout=30):
    req = urllib.request.Request(
        base + path,
        data=json.dumps(body).encode(),
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read())


def cmd_models(args):
    """List model ids available on the gateway."""
    base, key = _load_config()
    data = _get(base, key, "/v1/models")
    for m in data.get("data", []):
        print(m.get("id"))


def cmd_chat(args):
    """Streaming chat-completion smoke test (default)."""
    model = (args[0] if args else None) or os.environ.get("MODEL")
    if not model:
        print(
            f"usage: {sys.argv[0]} chat <model>   (or set MODEL env var)",
            file=sys.stderr,
        )
        return 2
    base, key = _load_config()

    print(f"Endpoint: {base}")
    print(f"Model:    {model}")
    print()

    # Tokenizer round-trip via the proxy's /v1/tokenize and /v1/detokenize
    # passthrough (llama.cpp native; vLLM accepts the same paths).
    sample = "hello world"
    try:
        tok_body = _post(base, key, "/v1/tokenize",
                         {"model": model, "prompt": sample}, 60)
        tokens_list = tok_body.get("tokens") or []
        print(f"tokenize:   {sample!r} -> {tokens_list}")

        detok_body = _post(base, key, "/v1/detokenize",
                           {"model": model, "tokens": tokens_list}, 60)
        roundtrip = detok_body.get("prompt") or detok_body.get("content", "")
        ok = "ok" if roundtrip.strip() == sample else f"MISMATCH: {roundtrip!r}"
        print(f"detokenize: {tokens_list} -> {roundtrip!r}  [{ok}]")
    except urllib.error.HTTPError as e:
        print(f"tokenize: HTTP {e.code} — {e.read().decode('utf-8', 'replace').strip()}")
    print()

    # Stream a one-shot chat completion.
    payload = json.dumps({
        "model": model,
        "stream": True,
        "messages": [{"role": "user", "content": "Say hello in one word"}],
    }).encode()

    req = urllib.request.Request(
        base + "/v1/chat/completions",
        data=payload,
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
            "Accept": "text/event-stream",
        },
        method="POST",
    )

    started = time.monotonic()
    ttft = None
    in_reasoning = False
    bytes_in = 0
    tokens = 0  # count of SSE deltas that carried reasoning or content

    with urllib.request.urlopen(req) as resp:
        for raw in resp:
            bytes_in += len(raw)
            line = raw.decode("utf-8", errors="replace").rstrip("\r\n")
            if not line.startswith("data: "):
                continue
            payload = line[len("data: "):]
            if payload == "[DONE]":
                break
            try:
                ev = json.loads(payload)
            except json.JSONDecodeError:
                continue
            delta = ev.get("choices", [{}])[0].get("delta", {}) or {}
            reasoning = delta.get("reasoning") or delta.get("reasoning_content") or ""
            content = delta.get("content") or ""

            if reasoning:
                if ttft is None:
                    ttft = time.monotonic() - started
                if not in_reasoning:
                    sys.stdout.write(DIM)
                    in_reasoning = True
                sys.stdout.write(reasoning)
                sys.stdout.flush()
                tokens += 1

            if content:
                if ttft is None:
                    ttft = time.monotonic() - started
                if in_reasoning:
                    sys.stdout.write(RESET)
                    in_reasoning = False
                sys.stdout.write(content)
                sys.stdout.flush()
                tokens += 1

    if in_reasoning:
        sys.stdout.write(RESET)
    total = time.monotonic() - started
    print()
    print(
        f"ttft: {ttft * 1000:.0f}ms   "
        f"tok/s: {(tokens - 1) / (total - ttft) if ttft and total > ttft else 0:.1f}   "
        f"tokens: {tokens}   "
        f"total: {total * 1000:.0f}ms   "
        f"bytes: {bytes_in}"
    )
    return 0


def cmd_transcribe(args):
    """Transcribe an audio file via /v1/audio/transcriptions."""
    parser = argparse.ArgumentParser(
        prog=f"{sys.argv[0]} transcribe",
        description="Transcribe an audio file via the gateway.",
    )
    parser.add_argument("audio", help="path to the audio file")
    parser.add_argument(
        "--model", default=os.environ.get("WHISPER_MODEL", "whisper-1"),
        help="model id (default: whisper-1 or $WHISPER_MODEL)",
    )
    parser.add_argument(
        "--format", default="verbose_json",
        help="response_format (default: verbose_json)",
    )
    parser.add_argument(
        "--diarize", action="store_true",
        help="request speaker diarization",
    )
    a = parser.parse_args(args)

    audio = Path(a.audio)
    if not audio.is_file():
        print(f"not a file: {audio}", file=sys.stderr)
        return 2

    base, key = _load_config()

    # multipart/form-data upload built by hand; the stdlib does not
    # expose a multipart writer, so we assemble the body manually.
    boundary = "----ycluster-inference-" + secrets.token_hex(8)
    fields = {
        "model": a.model,
        "response_format": a.format,
    }
    if a.diarize:
        fields["diarize"] = "true"

    parts = []
    for name, value in fields.items():
        parts.append(f"--{boundary}\r\n".encode())
        parts.append(
            f'Content-Disposition: form-data; name="{name}"\r\n\r\n'.encode()
        )
        parts.append(f"{value}\r\n".encode())
    with audio.open("rb") as f:
        parts.append(f"--{boundary}\r\n".encode())
        parts.append(
            'Content-Disposition: form-data; name="file"; '
            f'filename="{audio.name}"\r\n'.encode()
        )
        parts.append(b"Content-Type: application/octet-stream\r\n\r\n")
        parts.append(f.read())
        parts.append(b"\r\n")
    parts.append(f"--{boundary}--\r\n".encode())
    body = b"".join(parts)

    req = urllib.request.Request(
        base + "/v1/audio/transcriptions",
        data=body,
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": f"multipart/form-data; boundary={boundary}",
        },
        method="POST",
    )

    size = audio.stat().st_size
    print(f"Endpoint: {base}/v1/audio/transcriptions")
    print(f"Model:    {a.model}")
    print(f"File:      {audio} ({size} bytes)")
    print(f"Format:    {a.format}")
    print(f"Diarize:   {a.diarize}")
    print()

    started = time.monotonic()
    try:
        with urllib.request.urlopen(req, timeout=600) as resp:
            data = json.loads(resp.read())
    except urllib.error.HTTPError as e:
        print(f"HTTP {e.code}: {e.read().decode('utf-8', 'replace')}", file=sys.stderr)
        return 1

    elapsed = (time.monotonic() - started) * 1000
    print(f"Done in {elapsed:.0f}ms")
    print()

    text = data.get("text") or ""
    segments = data.get("segments") or []
    if text:
        chars = len(text)
        words = len(text.split())
        segs = len(segments) if segments else "n/a"
        print(f"Transcript: {chars} chars, ~{words} words, {segs} segments")
        print()
        print("--- First 500 chars ---")
        print(text[:500])
        print()
        if a.diarize and segments:
            print("--- Diarized segments ---")
            for seg in segments:
                speaker = seg.get("speaker", "?")
                seg_text = seg.get("text", "").strip()
                print(
                    f"  [{seg.get('start', 0):6.2f}-{seg.get('end', 0):6.2f}] "
                    f"{speaker:11} {seg_text}"
                )
    else:
        print("--- Response ---")
        print(json.dumps(data, indent=2))
    return 0


def main():
    # Default to `chat` when the first arg is a model id, not a subcommand.
    if len(sys.argv) >= 2 and sys.argv[1] in ("chat", "models", "transcribe"):
        sub = sys.argv[1]
        rest = sys.argv[2:]
    elif len(sys.argv) >= 2 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    elif len(sys.argv) >= 2 and sys.argv[1].startswith("-"):
        print(f"unknown option: {sys.argv[1]}", file=sys.stderr)
        print(__doc__, file=sys.stderr)
        return 2
    else:
        sub = "chat"
        rest = sys.argv[1:]

    if sub == "models":
        return cmd_models(rest)
    if sub == "chat":
        return cmd_chat(rest)
    if sub == "transcribe":
        return cmd_transcribe(rest)
    return 0


if __name__ == "__main__":
    sys.exit(main())
