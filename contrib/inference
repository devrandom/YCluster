def _suite_smoke_c(base, key, model):
    print(f"\n{'='*60}\nSUITE C  vision smoke (is multimodal enabled?)\n{'='*60}")
    try:
        def draw1(d, sz):
            d.ellipse([60, 60, 200, 200], fill="red")
            d.text((230, 90), "42", fill="black", font=_smoke_font(120))

        def draw2(d, sz):
            d.text((20, 70), "APPLE", fill="black", font=_smoke_font(90))
            d.text((sz[0] - 380, 70), "BANANA", fill="black", font=_smoke_font(90))
        img_basic = _smoke_make_image(draw1, (520, 280))
        img_wide = _smoke_make_image(draw2, (1700, 240))
    except Exception as e:  # noqa: BLE001
        print(f"  {RED}SKIP{RESET} could not build images locally: {e}")
        return {"suite": "C", "skipped": str(e)}

    tests = [
        ("basic", img_basic, "What number and what colored shape are in this image?",
         lambda t: _smoke_has_num(t, 42) and _smoke_has_word(t, "red")),
        ("wide", img_wide, "Read the two words in this image, left then right.",
         lambda t: _smoke_has_word(t, "apple") and _smoke_has_word(t, "banana")),
    ]
    results, passed = [], 0
    for name, data_url, q, check in tests:
        msgs = [{"role": "user", "content": [
            {"type": "text", "text": q},
            {"type": "image_url", "image_url": {"url": data_url}},
        ]}]
        r = _smoke_chat(base, key, msgs, model, max_tokens=512)
        if r["error"]:
            note = "vision likely NOT enabled" if "400" in r["error"] else ""
            print(f"  {RED}ERR {RESET} {name:6} {r['error'][:90]}  {note}")
            results.append({"id": name, "ok": False, "error": r["error"]})
            continue
        ok = bool(check(r["content"]))
        passed += ok
        tag = f"{GREEN}PASS{RESET}" if ok else f"{RED}FAIL{RESET}"
        print(f"  {tag} {name:6} {r['latency']:5.1f}s  {DIM}{r['content'].strip()[:80]}{RESET}")
        results.append({"id": name, "ok": ok, "answer": r["content"].strip()[:200]})
    print(f"  --> {passed}/{len(tests)} vision checks passed")
    return {"suite": "C", "passed": passed, "total": len(tests), "results": results}


def cmd_smoke(args):
    """Run the quality / long-context / vision smoke suite."""
    parser = argparse.ArgumentParser(
        prog=f"{sys.argv[0]} smoke",
        description="Run quality, long-context needle, and vision smoke checks.",
    )
    parser.add_argument("model")
    parser.add_argument(
        "suites", nargs="*", type=str.upper, choices=("A", "B", "C"),
        default=["A", "B", "C"],
        help="suites to run (default: A B C)",
    )
    parser.add_argument(
        "--max", type=int, default=200000,
        help="long-context needle target cap in tokens (default 200000)",
    )
    parser.add_argument("--json", action="store_true",
                        help="emit JSON after the tables")
    a = parser.parse_args(args)

    base, key = _load_config()
    suites = a.suites or ["A", "B", "C"]
    print(f"Endpoint: {base}\nModel:    {a.model}\nSuites:   {' '.join(suites)}")
    out = {"model": a.model, "suites": {}}
    if "A" in suites:
        out["suites"]["A"] = _suite_smoke_a(base, key, a.model)
    if "B" in suites:
        out["suites"]["B"] = _suite_smoke_b(base, key, a.model, a.max)
    if "C" in suites:
        out["suites"]["C"] = _suite_smoke_c(base, key, a.model)

    if a.json:
        print("\n" + json.dumps(out, indent=2))
    print("\nSUMMARY")
    failed = 0
    for s, r in out["suites"].items():
        if r.get("skipped"):
            print(f"  {s}: skipped ({r['skipped']})")
        else:
            print(f"  {s}: {r.get('passed')}/{r.get('total')}"
                  + (f"  leaks={r['leaks']}" if "leaks" in r else ""))
        failed += any(not item.get("ok") for item in r.get("results", []))
    return 1 if failed else 0


