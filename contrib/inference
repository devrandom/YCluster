def _make_test_image(text="42"):
    """Build a simple red-circle-plus-number PNG (pure stdlib) and return its
    data URL. Enough visual content that a vision-capable model has to actually
    read pixels to answer — a text-only path just says it can't see the image."""
    W, H = 400, 220
    cx, cy, r = 120, 110, 80
    scale, ox, oy = 6, 200, 70
    px = [[(255, 255, 255) for _ in range(W)] for _ in range(H)]

    for y in range(H):
        for x in range(W):
            if (x - cx) ** 2 + (y - cy) ** 2 <= r * r:
                px[y][x] = (215, 40, 40)

    def put(x, y):
        # keep the digits clear of the circle's edge
        if 0 <= x < W and 0 <= y < H and (x - 160) ** 2 + (y - 110) ** 2 > 40 ** 2:
            px[y][x] = (20, 20, 20)

    def glyph(d, x0, y0):
        for rr, row in enumerate(_DIGIT_FONT[d]):
            for cc, ch in enumerate(row):
                if ch == "1":
                    for dy in range(scale):
                        for dx in range(scale):
                            put(x0 + cc * scale + dx, y0 + rr * scale + dy)

    for d in text:
        glyph(d, ox, oy)
        ox += 6 * scale + 10

    rows = []
    for y in range(H):
        row = bytearray([0])
        for x in range(W):
            row += bytes(px[y][x])
        rows.append(bytes(row))

    def chunk(t, data):
        c = t + data
        return struct.pack(">I", len(data)) + c + struct.pack(">I", zlib.crc32(c) & 0xffffffff)

    ihdr = struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0)
    idat = zlib.compress(b"".join(rows))
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", ihdr) + chunk(b"IDAT", idat) + chunk(b"IEND", b""))
    return "data:image/png;base64," + base64.b64encode(png).decode()


def cmd_image(args):
    """POST a generated test image and confirm the model reads it (vision check)."""
    parser = argparse.ArgumentParser(
        prog=f"{sys.argv[0]} image",
        description="Verify a model actually reads image input end-to-end.",
    )
    parser.add_argument("model")
    parser.add_argument(
        "--max-tokens", type=int, default=512,
        help="max generated tokens (default 512)",
    )
    parser.add_argument(
        "--timeout", type=int, default=180,
        help="request timeout in seconds (default 180)",
    )
    a = parser.parse_args(args)

    base, key = _load_config()
    img = _make_test_image()
    body = {
        "model": a.model,
        # keep the answer in `content` (nemotron-family emits a reasoning
        # preamble otherwise that can eat the whole budget).
        "chat_template_kwargs": {"thinking_mode": "disabled", "enable_thinking": False},
        "messages": [{"role": "user", "content": [
            {"type": "text",
             "text": "What number and what colored shape are shown in this "
                     "image? Answer concisely."},
            {"type": "image_url", "image_url": {"url": img}},
        ]}],
        "max_tokens": a.max_tokens,
        "temperature": 0.0,
        "stream": False,
    }

    print(f"Endpoint: {base}")
    print(f"Model:    {a.model}")
    print()
    try:
        data = _post(base, key, "/v1/chat/completions", body, a.timeout)
    except urllib.error.HTTPError as e:
        print(f"image request: {RED}FAIL{RESET} — HTTP {e.code}: "
              f"{e.read().decode('utf-8', 'replace')[:200]}")
        print("  (a 400 here usually means the model/backend has no vision "
              "support — enabled images are rejected upstream)")
        return 1
    except Exception as e:  # noqa: BLE001
        print(f"image request: {RED}FAIL{RESET} — {type(e).__name__}: {e}")
        return 1

    msg = (data.get("choices") or [{}])[0].get("message", {}) or {}
    content = msg.get("content") or ""
    reasoning = msg.get("reasoning") or msg.get("reasoning_content") or ""
    full = f"{content}\n{reasoning}".lower()

    print(f"--- model response ---")
    print(content or reasoning)
    print()

    num_ok = "42" in full
    color_ok = "red" in full
    checks = [
        ("reads the number 42", num_ok),
        ("identifies red", color_ok),
    ]
    failed = 0
    for label, ok in checks:
        print(f"  {label:20} {GREEN if ok else RED}{'ok' if ok else 'FAIL'}{RESET}")
        failed += 0 if ok else 1
    print()
    if failed == 0:
        print(f"vision: {GREEN}PASS{RESET} — model read the generated image")
        return 0
    print(f"vision: {RED}FAIL{RESET} — model did not describe the image contents "
          "(image likely not reaching it)")
    return 1


def cmd_chat(args):
    """Streaming chat-completion smoke test (default)."""
    if not args:
        print(f"usage: {sys.argv[0]} chat <model>", file=sys.stderr)
        return 2
    model = args[0]
    base, key = _load_config()

    print(f"Endpoint: {base}")
    print(f"Model:    {model}")
    print()

    # Tokenizer round-trip via the proxy's /v1/tokenize and /v1/detokenize
    # passthrough (llama.cpp native; vLLM accepts the same paths).
    sample = "hello world"
    try:
        tok_body = _post(base, key, "/v1/tokenize",
                         {"model": model, "prompt": sample}, 60)
        tokens_list = tok_body.get("tokens") or []
        print(f"tokenize:   {sample!r} -> {tokens_list}")

        detok_body = _post(base, key, "/v1/detokenize",
                           {"model": model, "tokens": tokens_list}, 60)
        roundtrip = detok_body.get("prompt") or detok_body.get("content", "")
        ok = "ok" if roundtrip.strip() == sample else f"MISMATCH: {roundtrip!r}"
        print(f"detokenize: {tokens_list} -> {roundtrip!r}  [{ok}]")
    except urllib.error.HTTPError as e:
        print(f"tokenize: HTTP {e.code} — {e.read().decode('utf-8', 'replace').strip()}")
    except Exception as e:  # noqa: BLE001 - tokenizer is informational: a backend
                            # without /v1/tokenize must not abort the chat command
        print(f"tokenize: skipped (endpoint not supported?) — {type(e).__name__}: {e}")
    print()

    # Stream a one-shot chat completion.
    payload = json.dumps({
        "model": model,
        "stream": True,
        "messages": [{"role": "user", "content": "Describe how a transistor works in a short paragraph."}],
    }).encode()

    req = urllib.request.Request(
        base + "/v1/chat/completions",
        data=payload,
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
            "Accept": "text/event-stream",
        },
        method="POST",
    )

    started = time.monotonic()
    ttft = None
    in_reasoning = False
    bytes_in = 0
    tokens = 0  # count of SSE deltas that carried reasoning or content
    content_parts = []
    reasoning_parts = []

    with urllib.request.urlopen(req) as resp:
        for raw in resp:
            bytes_in += len(raw)
            line = raw.decode("utf-8", errors="replace").rstrip("\r\n")
            if not line.startswith("data: "):
                continue
            payload = line[len("data: "):]
            if payload == "[DONE]":
                break
            try:
                ev = json.loads(payload)
            except json.JSONDecodeError:
                continue
            choices = ev.get("choices") or []
            if not choices:
                continue
            delta = choices[0].get("delta", {}) or {}
            reasoning = delta.get("reasoning") or delta.get("reasoning_content") or ""
            content = delta.get("content") or ""

            if reasoning:
                if ttft is None:
                    ttft = time.monotonic() - started
                if not in_reasoning:
                    sys.stdout.write(DIM)
                    in_reasoning = True
                sys.stdout.write(reasoning)
                sys.stdout.flush()
                reasoning_parts.append(reasoning)
                tokens += 1

            if content:
                if ttft is None:
                    ttft = time.monotonic() - started
                if in_reasoning:
                    sys.stdout.write(RESET)
                    in_reasoning = False
                sys.stdout.write(content)
                sys.stdout.flush()
                content_parts.append(content)
                tokens += 1

    if in_reasoning:
        sys.stdout.write(RESET)
    total = time.monotonic() - started
    print()
    print(
        f"ttft: {ttft * 1000:.0f}ms   "
        f"tok/s: {(tokens - 1) / (total - ttft) if ttft and total > ttft else 0:.1f}   "
        f"tokens: {tokens}   "
        f"total: {total * 1000:.0f}ms   "
        f"bytes: {bytes_in}"
    )
    print()

    failed = False

    # Check 1: no raw think tags in streamed *content*. If the backend's
    # reasoning parser is working, thinking arrives via the reasoning delta
    # field; literal tags in content mean the parser was bypassed (this is
    # what OWUI renders as visible <mm:think> spam). Reasoning presence
    # itself is informational: a model may legitimately skip thinking.
    full_content = "".join(content_parts)
    leaked = [t for t in ("<mm:think>", "</mm:think>", "<think>", "</think>")
              if t in full_content]
    if leaked:
        print(f"think-tag leak:   {RED}FAIL{RESET} — {', '.join(leaked)} in streamed content")
        failed = True
    else:
        print(f"think-tag leak:   {GREEN}ok{RESET}"
              + ("  (reasoning streamed separately)" if reasoning_parts
                 else "  (no reasoning emitted)"))

    # Check 2: streamed tool calling (tool_choice=auto), the other half of
    # OWUI "native" mode. Expects structured tool_calls deltas and a
    # tool_calls finish_reason; a backend without --enable-auto-tool-choice
    # errors here, and a broken tool parser leaves tool_calls empty.
    tool_req = urllib.request.Request(
        base + "/v1/chat/completions",
        data=json.dumps({
            "model": model,
            "stream": True,
            "max_tokens": 800,
            "temperature": 0,
            "tools": [{"type": "function", "function": {
                "name": "get_weather",
                "description": "Get current weather for a city",
                "parameters": {"type": "object",
                               "properties": {"city": {"type": "string"}},
                               "required": ["city"]}}}],
            "tool_choice": "auto",
            "messages": [{"role": "user",
                          "content": "What is the weather in Paris right now? Use the tool."}],
        }).encode(),
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": "application/json",
            "Accept": "text/event-stream",
        },
        method="POST",
    )
    tc_name, tc_args, finish = None, [], None
    try:
        with urllib.request.urlopen(tool_req, timeout=180) as resp:
            for raw in resp:
                line = raw.decode("utf-8", errors="replace").rstrip("\r\n")
                if not line.startswith("data: ") or line == "data: [DONE]":
                    continue
                try:
                    ev = json.loads(line[len("data: "):])
                except json.JSONDecodeError:
                    continue
                choice = ev.get("choices", [{}])[0] if ev.get("choices") else {}
                finish = choice.get("finish_reason") or finish
                for tc in (choice.get("delta") or {}).get("tool_calls") or []:
                    fn = tc.get("function") or {}
                    tc_name = fn.get("name") or tc_name
                    if fn.get("arguments"):
                        tc_args.append(fn["arguments"])
        args_ok = False
        try:
            args_ok = isinstance(json.loads("".join(tc_args) or "{}"), dict) and bool(tc_args)
        except json.JSONDecodeError:
            pass
        if tc_name and args_ok and finish == "tool_calls":
            print(f"tool-call stream: {GREEN}ok{RESET} — "
                  f"{tc_name}({''.join(tc_args)})")
        else:
            print(f"tool-call stream: {RED}FAIL{RESET} — "
                  f"name={tc_name!r} args={''.join(tc_args)!r} finish={finish!r}")
            failed = True
    except urllib.error.HTTPError as e:
        print(f"tool-call stream: {RED}FAIL{RESET} — HTTP {e.code}: "
              f"{e.read().decode('utf-8', 'replace')[:200]}")
        failed = True

    return 1 if failed else 0


def _bench_build_prompt(target_tokens):
    words_needed = int(target_tokens / 1.3)
    unit = _BENCH_FILLER.split()
    reps = max(1, words_needed // len(unit))
    body = (" ".join(unit) + " ") * reps
    # Fresh nonce per request: vLLM prefix-caches from position 0, so an
    # identical prompt across runs would hit cache and report a fake
    # multi-thousand-tok/s "prefill" (really a KV lookup). A unique prefix
    # busts the whole-prompt match and forces a cold prefill -- the path we
    # tune. Decode length is pinned by ignore_eos; content is irrelevant.
    return (f"[run {secrets.token_hex(8)}] " + body
            + "\n\nBriefly summarize the passage above.")


def _bench_model_max_len(base, key, model):
    try:
        data = _get(base, key, "/v1/models")
        for m in data.get("data", []):
            if m.get("id") == model:
                return m.get("max_model_len")
    except Exception:
        return None


def _bench_stream(base, key, messages, model, gen, timeout,
                   collect_chunks=False, first_token_event=None,
                   deadline_s=None, log_label=None, log_t0=None,
                   progress_label=None, progress_interval_s=None):
    """Stream a completion. Returns timings + usage, or {'error': ...}.

    With collect_chunks, returns ``chunks`` as (monotonic_time, text_length)
    pairs. That is the per-chunk data the fairness benchmark needs; the older
    bench/batch callers keep the cheaper first/last-only path.

    With deadline_s, stop reading that many seconds after the first content chunk
    and close the connection. The server aborts the request when it sees the
    disconnect. ``truncated`` in the result distinguishes this from a normal
    ``max_tokens`` completion.

    log_label/log_t0 print start and stop lines relative to log_t0.
    progress_label/progress_interval_s print the momentary chunk rate at that
    interval while decoding.
    """
    body = {
        "model": model,
        "messages": messages,
        "max_tokens": gen,
        "temperature": 0.0,
        "stream": True,
        "stream_options": {"include_usage": True},
        # ignore_eos: force exactly `gen` decode steps regardless of what the
        # model would say, so decode tok/s is measured over a real sample and
        # not the 1-2 tokens an early EOS would give (vLLM extension).
        "ignore_eos": True,
        # thinking OFF: keep generation a flat token stream, no reasoning
        # preamble. Both spellings (see smoke test).
        "chat_template_kwargs": {"thinking_mode": "disabled", "enable_thinking": False},
    }
    req = urllib.request.Request(
        base + "/v1/chat/completions",
        data=json.dumps(body).encode(),
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
        method="POST",
    )

    def signal_first_token():
        if first_token_event is not None:
            first_token_event.set()

    t0 = time.monotonic()
    t_first = None
    t_last = None
    usage = {}
    timings = {}
    chunks = []
    truncated = False
    progress_last_t = None
    progress_last_n = 0
    if log_label is not None:
        print(f"  {log_label} start +{t0 - (log_t0 or t0):.2f}s")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            for raw in resp:
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if data == "[DONE]":
                    break
                obj = json.loads(data)
                if obj.get("usage"):
                    usage = obj["usage"]
                # Backend-provided timings live either on the chunk (llama-server
                # style `timings`) or nested inside usage. Not all backends emit
                # them, so presence is optional and callers fall back to client
                # wall-clock timing.
                for src in (obj, obj.get("usage") or {}):
                    t = src.get("timings")
                    if isinstance(t, dict):
                        timings = t
                choices = obj.get("choices") or []
                if choices:
                    delta = choices[0].get("delta") or {}
                    text = (delta.get("content") or delta.get("reasoning_content")
                            or delta.get("reasoning"))
                    if text:
                        now = time.monotonic()
                        if t_first is None:
                            t_first = now
                            signal_first_token()
                        t_last = now
                        if collect_chunks:
                            chunks.append((now, len(text)))
                        if progress_label is not None:
                            if progress_last_t is None:
                                progress_last_t = t_first
                            interval = progress_interval_s or 1.0
                            elapsed = now - progress_last_t
                            if elapsed >= interval:
                                rate = ((len(chunks) - progress_last_n) / elapsed)
                                print(f"    {progress_label} "
                                      f"+{now - t_first:.1f}s: "
                                      f"{rate:.1f} tok/s")
                                progress_last_t = now
                                progress_last_n = len(chunks)
                        if (deadline_s is not None
                                and now - t_first >= deadline_s):
                            truncated = True
                            break
    except urllib.error.HTTPError as e:
        signal_first_token()
        return {"error": f"HTTP {e.code}: {e.read().decode('utf-8','replace')[:200]}"}
    except Exception as e:
        signal_first_token()
        return {"error": f"{type(e).__name__}: {e}"}
    finally:
        if log_label is not None:
            print(f"  {log_label} stop  "
                  f"+{time.monotonic() - (log_t0 or t0):.2f}s")
    if collect_chunks and not chunks:
        signal_first_token()
        return {"error": "no streamed content chunks"}
    result = {"t0": t0, "t_first": t_first, "t_last": t_last,
              "t_end": time.monotonic(), "usage": usage, "timings": timings,
              "truncated": truncated}
    if collect_chunks:
        result["chunks"] = chunks
    return result


def _server_tps(timings):
    """Backend-provided prefill/decode tok/s from a `timings` object (e.g.
    llama-server), or (None, None) when absent/non-numeric. Client-side timing
    is the fallback when a backend does not report these."""
    if not isinstance(timings, dict):
        return None, None

    def num(v):
        return v if isinstance(v, (int, float)) else None

    pre = num(timings.get("prompt_per_second") or timings.get("prompt_per_sec"))
    dec = num(timings.get("predicted_per_second") or timings.get("predicted_per_sec"))
    if pre is None:
        pn = num(timings.get("prompt_n"))
        pm = num(timings.get("prompt_ms"))
        if pm is None:
            pm = num(timings.get("t_prompt_ms"))  # older llama.cpp key
        if pn and pm:
            pre = pn / (pm / 1000.0)
    if dec is None:
        dn = num(timings.get("predicted_n"))
        dm = num(timings.get("predicted_ms"))
        if dm is None:
            dm = num(timings.get("t_predicted_ms"))
        if dn and dm:
            dec = dn / (dm / 1000.0)
    return pre, dec


def _agg(name, samples):
    """Median + (min, max) of a list of floats, or (None, None) if empty."""
    vals = [s for s in samples if s is not None]
    if not vals:
        return None, (None, None)
    return statistics.median(vals), (min(vals), max(vals))


def _bench_run(base, key, model, items, gen, timeout, mml=None, repeats=3):
    print(f"Endpoint: {base}\nModel:    {model}"
          + (f"  (max_model_len {mml})" if mml else "")
          + f"\nDecode:   {gen} tokens   Warmup: on   Repeats: {repeats}\n")
    print(f"  {'ptok':>8}  {'TTFT':>7}  {'prefill t/s (med [min-max])':>26}  "
          f"{'decode t/s (med [min-max])':>24}  {'cached':>7}")
    rows = []
    last_ptok = None
    pre_src, dec_src = set(), set()
    # One throwaway request warms up the backend (model load, GPU init,
    # connection setup, page tables) before any measured sample.
    if items:
        wp_payload, wp_target = items[0][1]
        wp = _bench_build_prompt(wp_payload) if wp_target else wp_payload
        r = _bench_stream(base, key, [{"role": "user", "content": wp}],
                          model, gen, timeout)
        if r.get("error"):
            print(f"  {RED}warmup ERR{RESET}: {r['error']}")
    for label, (payload, is_target) in items:
        prefill, dec_tps, ttfts, ptoks, cached = [], [], [], [], []
        errors = []
        for _ in range(repeats):
            # Fresh nonce per sample: identical prompts across repeats would
            # trip vLLM's prefix cache, inflating prefill and decode on the
            # cached samples. A unique prefix forces cold prefill every time.
            content = _bench_build_prompt(payload) if is_target else payload
            r = _bench_stream(base, key,
                              [{"role": "user", "content": content}],
                              model, gen, timeout)
            if r.get("error"):
                errors.append(r["error"])
                continue
            usage = r["usage"] or {}
            ptok = usage.get("prompt_tokens")
            ctok = usage.get("completion_tokens") or gen
            cached.append((usage.get("prompt_tokens_details") or {}).get("cached_tokens") or 0)
            ttft = (r["t_first"] - r["t0"]) if r["t_first"] else None
            # Prefer backend-reported tok/s when the server provides them
            # (llama-server etc.); otherwise fall back to client timing.
            srv_pre, srv_dec = _server_tps(r.get("timings"))
            if srv_pre is not None:
                prefill.append(srv_pre)
                pre_src.add("server")
            else:
                prefill.append((ptok / ttft) if (ptok and ttft) else None)
                pre_src.add("client")
            if srv_dec is not None:
                dec_tps.append(srv_dec)
                dec_src.add("server")
            else:
                # Decode window is bounded by first->last *content* chunk, so
                # the trailing usage SSE and any idle tail do not deflate it.
                dec = (r["t_last"] - r["t_first"]) if (r["t_first"] and r["t_last"]) else None
                dec_tps.append(((ctok - 1) / dec) if (dec and dec > 0 and ctok > 1) else None)
                dec_src.add("client")
            ttfts.append(ttft)
            if ptok:
                ptoks.append(ptok)
        if errors and not prefill:
            print(f"  {RED}ERR {RESET} {label:>8}  {errors[0]}")
            rows.append({"label": label, "error": errors[0]})
            continue
        ptok = statistics.median(ptoks) if ptoks else last_ptok
        last_ptok = ptok
        ttft_med, _ = _agg("ttft", ttfts)
        pre_med, pre_rng = _agg("prefill", prefill)
        dec_med, dec_rng = _agg("decode", dec_tps)
        cache_med = statistics.median(cached)
        pre_s = (f"{pre_med:5.0f} [{pre_rng[0]:.0f}-{pre_rng[1]:.0f}]"
                 if pre_med else "      n/a")
        dec_s = (f"{dec_med:6.1f} [{dec_rng[0]:.1f}-{dec_rng[1]:.1f}]"
                 if dec_med else "   n/a")
        print(f"  {(ptok or label):>8}  {ttft_med or 0:6.2f}s  {pre_s:>26}  "
              f"{dec_s:>24}  {cache_med:>7.0f}")
        rows.append({
            "label": label, "repeats": repeats - len(errors),
            "prompt_tokens": ptok, "completion_tokens": gen,
            "ttft_median_s": ttft_med,
            "prefill_tps_median": pre_med, "prefill_tps_range": pre_rng,
            "prefill_source": _src_label(pre_src),
            "decode_tps_median": dec_med, "decode_tps_range": dec_rng,
            "decode_source": _src_label(dec_src),
            "cached_tokens_median": cache_med,
            "samples": [{"ttft_s": t, "prefill_tps": p, "decode_tps": d,
                         "cached_tokens": c}
                        for t, p, d, c in zip(ttfts, prefill, dec_tps, cached)],
        })
    print(f"\n  timing source: prefill={_src_label(pre_src)}, "
          f"decode={_src_label(dec_src)}  (server=backend-reported, "
          f"client=measured client-side)")
    return {"model": model, "max_model_len": mml, "decode_tokens": gen,
            "warmup": bool(items), "repeats": repeats,
            "prefill_source": _src_label(pre_src),
            "decode_source": _src_label(dec_src), "rows": rows}


def _src_label(srcs):
    """Collapse per-sample source flags to one label for reporting."""
    if srcs == {"server"}:
        return "server"
    if srcs == {"client"}:
        return "client"
    if srcs:
        return "mixed"
    return "n/a"


def cmd_bench(args):
    """Pre-fill/decode benchmark sweep."""
    parser = argparse.ArgumentParser(
        prog=f"{sys.argv[0]} bench",
        description="Bench prefill + decode tok/s at varying prompt depths.",
    )
    parser.add_argument("model")
    parser.add_argument(
        "--lens", default="1000,4000,16000,64000",
        help="comma-separated target prompt token counts (context lengths)",
    )
    parser.add_argument(
        "--gen", type=int, default=256,
        help="decode tokens per request (default 256)",
    )
    parser.add_argument(
        "--repeats", type=int, default=3,
        help="how many times to run each prompt depth (median + min/max, default 3)",
    )
    parser.add_argument(
        "--prompt",
        help="custom user message (decode-only; skips the depth sweep)",
    )
    parser.add_argument("--timeout", type=int, default=600)
    parser.add_argument("--json", action="store_true", help="emit JSON after the table")
    a = parser.parse_args(args)
    if not a.model:
        print(
            f"usage: {sys.argv[0]} bench <model> [--lens ...] [--gen N] "
            "[--repeats N] [--prompt S] [--json]",
            file=sys.stderr,
        )
        return 2

    base, key = _load_config()
    if a.prompt is not None:
        # Custom prompt is passed through verbatim (decode-only); no fresh-nonce
        # regeneration, no depth sweep.
        items, mml = [("custom", (a.prompt, False))], None
    else:
        mml = _bench_model_max_len(base, key, a.model)
        lens = [int(x) for x in a.lens.split(",")]
        # (label, (target_tokens, is_target)): target prompts get a fresh nonce
        # per repeat so consecutive samples never share a prefix and hit cache.
        items = [(str(t), (t, True)) for t in lens
                 if not (mml and t > mml - 2000)]

    sys.stdout.reconfigure(line_buffering=True)
    result = _bench_run(base, key, a.model, items, a.gen, a.timeout, mml, a.repeats)
    if a.json:
        print()
        print(json.dumps(result, indent=2))
    return 0


def _batch_shared_prompt(shared_prefix):
    """Shared-prefix prompt: one long body every request can cache, with a
    unique leaf so requests are not byte-identical."""
    return shared_prefix + f"\n[leaf {secrets.token_hex(4)}]"


def _batch_sample(base, key, model, prompt, gen, timeout):
    """One concurrent load request. Returns timings or {'error': ...}."""
    r = _bench_stream(base, key, [{"role": "user", "content": prompt}],
                      model, gen, timeout)
    if r.get("error"):
        return {"error": r["error"]}
    usage = r["usage"] or {}
    ptok = usage.get("prompt_tokens")
    ctok = usage.get("completion_tokens") or gen
    ttft = (r["t_first"] - r["t0"]) if r["t_first"] else None
    dec = None
    if r["t_first"] and r["t_last"]:
        win = r["t_last"] - r["t_first"]
        if win > 0 and ctok > 1:
            dec = (ctok - 1) / win
    return {
        "prompt_tokens": ptok,
        "completion_tokens": ctok,
        "cached_tokens": (usage.get("prompt_tokens_details") or {}).get(
            "cached_tokens") or 0,
        "ttft_s": ttft,
        "latency_s": r["t_end"] - r["t0"],
        "decode_tps": dec,
    }


def _batch_round(base, key, model, prompt_tokens, gen, timeout, concurrency,
                share_pct, shared_prefix, round_no):
    n_shared = round(concurrency * share_pct / 100)
    n_cold = concurrency - n_shared
    prompts = ([_batch_shared_prompt(shared_prefix) for _ in range(n_shared)]
               + [_bench_build_prompt(prompt_tokens) for _ in range(n_cold)])
    t0 = time.monotonic()
    with ThreadPoolExecutor(max_workers=concurrency) as pool:
        futures = [pool.submit(_batch_sample, base, key, model, p, gen, timeout)
                   for p in prompts]
        samples = [f.result() for f in futures]
    wall = time.monotonic() - t0
    ok = [s for s in samples if "error" not in s]
    errors = [s["error"] for s in samples if "error" in s]
    med = lambda name: _agg(name, [s.get(name) for s in ok])[0]
    return {
        "round": round_no,
        "requests": concurrency,
        "shared": n_shared,
        "cold": n_cold,
        "ok": len(ok),
        "errors": errors,
        "wall_s": wall,
        "requests_per_second": len(ok) / wall if wall else 0.0,
        "median_prompt_tokens": med("prompt_tokens"),
        "median_ttft_s": med("ttft_s"),
        "median_latency_s": med("latency_s"),
        "median_decode_tps": med("decode_tps"),
        "median_cached_tokens": statistics.median(
            [s["cached_tokens"] for s in ok]) if ok else None,
        "samples": samples,
    }


def _batch_aggregate_decode_tps(rows):
    """Median per-round system-wide decode rate: total output / round wall."""
    per_round = []
    for row in rows:
        ok = [s for s in row["samples"] if "error" not in s]
        if ok and row["wall_s"]:
            tokens = sum(s.get("completion_tokens") or 0 for s in ok)
            per_round.append(tokens / row["wall_s"])
    return statistics.median(per_round) if per_round else None


def _batch_run(base, key, model, prompt_tokens, gen, timeout, concurrency,
              rounds, share_pct, mml=None):
    shared_prefix = _bench_build_prompt(prompt_tokens) if share_pct else None
    print(f"Endpoint: {base}\nModel:    {model}"
          + (f"  (max_model_len {mml})" if mml else "")
          + f"\nPrompt:   ~{prompt_tokens} tokens   Decode: {gen} tokens"
          + f"   Concurrency: {concurrency}"
          + f"   Cache: {share_pct}% shared / {100 - share_pct}% cold"
          + f"   Rounds: {rounds}\n")
    if rounds:
        wp = (_batch_shared_prompt(shared_prefix) if shared_prefix
              else _bench_build_prompt(prompt_tokens))
        r = _bench_stream(base, key, [{"role": "user", "content": wp}],
                          model, gen, timeout)
        if r.get("error"):
            print(f"  {RED}warmup ERR{RESET}: {r['error']}")
    print(f"  {'round':>5}  {'req':>3}  {'ok':>3}  {'err':>3}  "
          f"{'wall':>7}  {'r/s':>6}  {'ttft':>6}  {'e2e':>6}  "
          f"{'decode':>8}  {'cached':>7}")
    rows = []
    t_all0 = time.monotonic()
    for round_no in range(1, rounds + 1):
        row = _batch_round(base, key, model, prompt_tokens, gen, timeout,
                          concurrency, share_pct, shared_prefix, round_no)
        rows.append(row)
        print(f"  {row['round']:>5}  {row['requests']:>3}  {row['ok']:>3}  "
              f"{row['requests'] - row['ok']:>3}  {row['wall_s']:6.1f}s  "
              f"{row['requests_per_second']:5.2f}  "
              f"{row['median_ttft_s'] or 0:5.2f}s  "
              f"{row['median_latency_s'] or 0:5.2f}s  "
              f"{row['median_decode_tps'] or 0:6.1f}  "
              f"{row['median_cached_tokens'] or 0:6.0f}")
    overall_wall = time.monotonic() - t_all0
    all_ok = [s for row in rows for s in row["samples"] if "error" not in s]
    summary = {
        "requests": rounds * concurrency,
        "ok": len(all_ok),
        "errors": sum(len(row["errors"]) for row in rows),
        "wall_s": overall_wall,
        "requests_per_second": len(all_ok) / overall_wall if overall_wall else 0.0,
        "median_prompt_tokens": _agg("prompt_tokens",
                                     [s.get("prompt_tokens") for s in all_ok])[0],
        "median_ttft_s": _agg("ttft_s", [s.get("ttft_s") for s in all_ok])[0],
        "median_latency_s": _agg("latency_s",
                                 [s.get("latency_s") for s in all_ok])[0],
        "median_decode_tps": _agg("decode_tps",
                                  [s.get("decode_tps") for s in all_ok])[0],
        "aggregate_decode_tps": _batch_aggregate_decode_tps(rows),
        "median_cached_tokens": statistics.median(
            [s["cached_tokens"] for s in all_ok]) if all_ok else None,
    }
    print("  " + "-" * 78)
    print(f"  TOTAL {summary['ok']}/{summary['requests']} ok  "
          f"{summary['wall_s']:.1f}s  {summary['requests_per_second']:.2f} r/s  "
          f"ttft {summary['median_ttft_s'] or 0:.2f}s  "
          f"e2e {summary['median_latency_s'] or 0:.2f}s  "
          f"decode {summary['median_decode_tps'] or 0:.1f}  "
          f"cached {summary['median_cached_tokens'] or 0:.0f}")
    print(f"  AGGREGATE {summary['ok']}/{summary['requests']} ok  "
          f"{summary['wall_s']:.1f}s  {summary['requests_per_second']:.2f} r/s  "
          f"decode {summary['aggregate_decode_tps'] or 0:.1f} tok/s  "
          f"cached {summary['median_cached_tokens'] or 0:.0f}")
    return {
        "model": model, "max_model_len": mml, "concurrency": concurrency,
        "prompt_tokens_target": prompt_tokens, "decode_tokens": gen,
        "cache_percent_shared": share_pct, "rounds": rounds,
        "summary": summary, "round_results": rows,
    }


def _percentile(values, pct):
    vals = sorted(v for v in values if v is not None)
    if not vals:
        return None
    if len(vals) == 1:
        return vals[0]
    k = (len(vals) - 1) * pct / 100.0
    lo, hi = math.floor(k), math.ceil(k)
    if lo == hi:
        return vals[lo]
    return vals[lo] + (vals[hi] - vals[lo]) * (k - lo)


def _itl_ms(chunks):
    times = [t for t, _ in chunks]
    return [(b - a) * 1000.0 for a, b in zip(times, times[1:])]


def _gen_sample_stats(result, decode_tokens):
    chunks = result.get("chunks") or []
    itls = _itl_ms(chunks)
    usage = result.get("usage") or {}
    truncated = bool(result.get("truncated"))
    # A deadline-limited stream has no final usage chunk, so the received
    # content chunks are the token count. One chunk is one decode step on the
    # backends this benchmarks.
    ctok = usage.get("completion_tokens") or (len(chunks) if truncated
                                              else decode_tokens)
    ptok = usage.get("prompt_tokens")
    cached = (usage.get("prompt_tokens_details") or {}).get("cached_tokens")
    ttft = ((result["t_first"] - result["t0"]) * 1000.0
            if result.get("t_first") else None)
    window = (result["t_last"] - result["t_first"]
              if result.get("t_first") and result.get("t_last") else None)
    decode_tps = ((ctok - 1) / window
                  if window and window > 0 and ctok > 1 else None)
    return {
        "ttft_ms": ttft,
        "itl_p50_ms": _percentile(itls, 50),
        "itl_p95_ms": _percentile(itls, 95),
        "itl_max_ms": max(itls) if itls else None,
        "decode_tps": decode_tps,
        "decode_window_s": window,
        "prompt_tokens": ptok,
        "cached_tokens": cached,
        "completion_tokens": ctok,
        "chunks": len(chunks),
        "truncated": truncated,
        "t_first": result.get("t_first"),
        "t_end": result.get("t_end"),
    }


def _prefill_sample_stats(result):
    usage = result.get("usage") or {}
    ttft = ((result["t_first"] - result["t0"]) * 1000.0
            if result.get("t_first") else None)
    return {
        "ttft_ms": ttft,
        "latency_ms": (result["t_end"] - result["t0"]) * 1000.0,
        "prompt_tokens": usage.get("prompt_tokens"),
        "t_end": result["t_end"],
    }


def _fairness_phase(base, key, model, phase, generation_prompts,
                    max_decode_tokens, prefills, prefill_context_tokens,
                    generation_seconds, timeout, settle_ms, progress=False):
    """Launch cold prefills first, then bounded generations inside them.

    The prefill requests are submitted first, the generations a short settle
    later, and each generation stops after ``generation_seconds`` of decode. The
    caller warms the generation prompts' prefixes beforehand, so the measured
    generation is decode-only rather than a mixed prefill+decode request.
    """
    prefill_prompts = [_bench_build_prompt(prefill_context_tokens)
                       for _ in range(prefills)]
    phase_start = time.monotonic()
    prefill_start = None
    with ThreadPoolExecutor(
            max_workers=len(generation_prompts) + prefills) as pool:
        if prefill_prompts:
            prefill_start = time.monotonic()
            prefill_futures = [
                pool.submit(_bench_stream, base, key,
                            [{"role": "user", "content": prompt}], model,
                            1, timeout, True, log_label=f"p{i}",
                            log_t0=phase_start)
                for i, prompt in enumerate(prefill_prompts, 1)
            ]
            if settle_ms > 0:
                time.sleep(settle_ms / 1000.0)
        else:
            prefill_futures = []
        gen_futures = [
            pool.submit(_bench_stream, base, key,
                        [{"role": "user", "content": prompt}], model,
                        max_decode_tokens, timeout, True, None,
                        deadline_s=generation_seconds, log_label=f"g{i}",
                        log_t0=phase_start,
                        progress_label=(f"g{i}" if progress else None),
                        progress_interval_s=1.0)
            for i, prompt in enumerate(generation_prompts, 1)
        ]
        gen_results = [f.result() for f in gen_futures]
        prefill_results = [f.result() for f in prefill_futures]

    gens = []
    for i, result in enumerate(gen_results):
        if result.get("error"):
            gens.append({"id": f"g{i + 1}", "error": result["error"]})
        else:
            stats = _gen_sample_stats(result, max_decode_tokens)
            stats["id"] = f"g{i + 1}"
            gens.append(stats)

    prefills_out = []
    for i, result in enumerate(prefill_results):
        if result.get("error"):
            prefills_out.append({"id": f"p{i + 1}", "error": result["error"]})
        else:
            stats = _prefill_sample_stats(result)
            stats["id"] = f"p{i + 1}"
            prefills_out.append(stats)

    prefill_last_end = max((r["t_first"] for r in prefill_results
                           if not r.get("error") and r.get("t_first")),
                          default=None)
    prefill_span_s = (prefill_last_end - prefill_start
                      if prefill_start is not None
                      and prefill_last_end is not None else None)
    # Positive margin means the generation finished before the last prefill
    # completed, i.e. the whole decode window was inside the prefill phase.
    # Use the last completion, not the first: with serialized prefills the
    # first one can finish while another is still computing.
    containment_margin_s = []
    if prefill_last_end is not None:
        for gen in gens:
            if "error" in gen or not gen.get("t_end"):
                containment_margin_s.append(None)
                continue
            containment_margin_s.append(prefill_last_end - gen["t_end"])

    return {
        "phase": phase,
        "generations": gens,
        "prefills": prefills_out,
        "prefill_span_s": prefill_span_s,
        "containment_margin_s": containment_margin_s,
    }


def _phase_median(rows, key):
    vals = [g[key] for row in rows for g in row["generations"]
            if "error" not in g and g.get(key) is not None]
    return statistics.median(vals) if vals else None


def _per_generation_ratios(baseline_rows, loaded_rows):
    count = max((len(row["generations"])
                 for row in baseline_rows + loaded_rows), default=0)
    ratios = []
    for i in range(count):
        base = [row["generations"][i]["itl_p50_ms"]
                for row in baseline_rows
                if i < len(row["generations"])
                and "error" not in row["generations"][i]
                and row["generations"][i].get("itl_p50_ms") is not None]
        treat = [row["generations"][i]["itl_p50_ms"]
                 for row in loaded_rows
                 if i < len(row["generations"])
                 and "error" not in row["generations"][i]
                 and row["generations"][i].get("itl_p50_ms") is not None]
        if base and treat and statistics.median(base) > 0:
            ratios.append(statistics.median(treat) / statistics.median(base))
    return ratios


def _fairness_summary(baseline_rows, loaded_rows, thresholds):
    base_p50 = _phase_median(baseline_rows, "itl_p50_ms")
    loaded_p50 = _phase_median(loaded_rows, "itl_p50_ms")
    base_p95 = _phase_median(baseline_rows, "itl_p95_ms")
    loaded_p95 = _phase_median(loaded_rows, "itl_p95_ms")
    base_decode = _phase_median(baseline_rows, "decode_tps")
    loaded_decode = _phase_median(loaded_rows, "decode_tps")
    itl_ratio = (loaded_p50 / base_p50
                  if base_p50 and loaded_p50 is not None else None)
    itl_p95_ratio = (loaded_p95 / base_p95
                      if base_p95 and loaded_p95 is not None else None)
    decode_tps_ratio = (loaded_decode / base_decode
                    if base_decode and loaded_decode is not None else None)
    generation_ratios = _per_generation_ratios(baseline_rows, loaded_rows)
    generation_spread = (max(generation_ratios) / min(generation_ratios)
                  if len(generation_ratios) >= 2 and min(generation_ratios) > 0 else None)

    prefill_ttfts = [p["ttft_ms"] for row in loaded_rows
                    for p in row["prefills"]
                    if "error" not in p and p.get("ttft_ms") is not None]
    prefill_spread = (max(prefill_ttfts) / min(prefill_ttfts)
                      if len(prefill_ttfts) >= 2 and min(prefill_ttfts) > 0
                      else None)
    prefill_spans = [row["prefill_span_s"] for row in loaded_rows
                     if row.get("prefill_span_s") is not None]
    prefill_span_ok = (bool(prefill_spans)
                       and min(prefill_spans) >= thresholds["min_prefill_seconds"])
    margins = [m for row in loaded_rows
               for m in row["containment_margin_s"] if m is not None]
    contained_ok = (bool(margins) and min(margins) >= 0.0)
    windows = [g.get("decode_window_s") for row in baseline_rows + loaded_rows
               for g in row["generations"]
               if "error" not in g and g.get("decode_window_s") is not None]
    window_ok = (bool(windows)
                 and min(windows) >= thresholds["min_decode_seconds"])
    cached_fractions = [
        g["cached_tokens"] / g["prompt_tokens"]
        for row in loaded_rows for g in row["generations"]
        if "error" not in g and g.get("prompt_tokens")
        and g.get("cached_tokens") is not None
    ]
    cache_ok = (None if not cached_fractions
                 else min(cached_fractions) >= _FAIRNESS_MIN_PREFIX_CACHE_HIT)

    errors = sum(
        1 for row in baseline_rows + loaded_rows
        for req in row["generations"] + row["prefills"]
        if "error" in req
    )
    checks = {
        "no_errors": errors == 0,
        "prefill_span": prefill_span_ok,
        "contained": contained_ok,
        "decode_window": window_ok,
        "generation_prefix_cache": cache_ok is not False,
        "itl_ratio": itl_ratio is not None
                     and itl_ratio <= thresholds["max_itl_p50_ratio"],
        "itl_p95_ratio": itl_p95_ratio is not None
                          and itl_p95_ratio <= thresholds["max_itl_p95_ratio"],
        "decode_tps_ratio": decode_tps_ratio is not None
                        and decode_tps_ratio >= thresholds["min_decode_tps_ratio"],
        "generation_spread": generation_spread is None
                      or generation_spread <= thresholds["max_generation_spread"],
        "prefill_spread": prefill_spread is None
                           or prefill_spread <= thresholds["max_prefill_spread"],
    }
    return {
        "baseline_itl_p50_ms": base_p50,
        "with_prefill_itl_p50_ms": loaded_p50,
        "itl_p50_ratio": itl_ratio,
        "baseline_itl_p95_ms": base_p95,
        "with_prefill_itl_p95_ms": loaded_p95,
        "itl_p95_ratio": itl_p95_ratio,
        "baseline_decode_tps": base_decode,
        "with_prefill_decode_tps": loaded_decode,
        "decode_tps_ratio": decode_tps_ratio,
        "per_generation_itl_ratios": generation_ratios,
        "generation_spread": generation_spread,
        "prefill_ttft_ms": prefill_ttfts,
        "prefill_spread": prefill_spread,
        "prefill_span_s": prefill_spans,
        "containment_margin_s": margins,
        "decode_window_s": windows,
        "generation_prefix_cache_hit": cached_fractions,
        "errors": errors,
        "checks": checks,
        "passed": all(checks.values()),
    }


def _print_fairness_rows(rows):
    print(f"  {'phase':>12}  {'req':>4}  {'ttft':>7}  {'itl50':>7}  "
          f"{'itl95':>7}  {'itlmax':>7}  {'dec t/s':>8}  {'chunks':>7}  "
          f"{'win':>7}  {'inside':>8}")
    for row in rows:
        for i, gen in enumerate(row["generations"]):
            margin = (row["containment_margin_s"][i]
                      if i < len(row["containment_margin_s"]) else None)
            if "error" in gen:
                print(f"  {row['phase']:>12}  {gen['id']:>4}  {RED}ERR{RESET} "
                      f"{gen['error'][:60]}")
                continue
            print(f"  {row['phase']:>12}  {gen['id']:>4}  "
                  f"{gen['ttft_ms'] or 0:6.0f}ms  "
                  f"{gen['itl_p50_ms'] or 0:6.1f}ms  "
                  f"{gen['itl_p95_ms'] or 0:6.1f}ms  "
                  f"{gen['itl_max_ms'] or 0:6.1f}ms  "
                  f"{gen['decode_tps'] or 0:7.1f}  "
                  f"{gen['chunks']:>7}  "
                  f"{(gen.get('decode_window_s') or 0):6.2f}s  "
                  f"{(margin or 0):7.2f}s")
        for pre in row["prefills"]:
            if "error" in pre:
                print(f"  {row['phase']:>12}  {pre['id']:>4}  {RED}ERR{RESET} "
                      f"{pre['error'][:60]}")
                continue
            print(f"  {row['phase']:>12}  {pre['id']:>4}  "
                  f"{pre['ttft_ms'] or 0:6.0f}ms  "
                  f"{'-':>7}  {'-':>7}  {'-':>7}  {'-':>8}  {'-':>7}  "
                  f"{pre['latency_ms'] / 1000.0:6.2f}s  {'-':>8}")


def _warm_generation_prefixes(base, key, model, prompts, timeout):
    """Populate the prefix cache for the measured generation prompts."""
    for i, prompt in enumerate(prompts, 1):
        r = _bench_stream(base, key, [{"role": "user", "content": prompt}],
                            model, 1, timeout, True)
        if r.get("error"):
            return f"g{i}: {r['error']}"
    return None


def _size_prefill(base, key, model, mml, min_s, timeout):
    """Measure one cold 32k prefill and extrapolate the needed token count.

    Cold prefill rate is stable on the backends this benchmarks, so one pilot is
    enough. The actual prefill span is gated afterwards, which catches a model
    whose rate degrades at long context.
    """
    tokens = _FAIRNESS_PREFILL_PILOT_TOKENS
    cap = mml - 2000 if mml else None
    if cap:
        tokens = min(tokens, cap)
    prompt = _bench_build_prompt(tokens)
    r = _bench_stream(base, key, [{"role": "user", "content": prompt}],
                        model, 1, timeout, True)
    if r.get("error"):
        return None, r["error"]
    stats = _prefill_sample_stats(r)
    if not stats.get("ttft_ms"):
        return None, "no TTFT from pilot prefill"
    duration = stats["ttft_ms"] / 1000.0
    print(f"Prefill pilot: {tokens} tokens -> {duration:.1f}s "
          f"({tokens / duration:.0f} tok/s)")
    # 10% headroom: prefill rate improves slightly with length here, but
    # do not assume that holds on every backend.
    target = int(math.ceil(1.1 * min_s * tokens / duration))
    if cap:
        target = min(target, cap)
    target = max(target, 1)
    print(f"Prefill size: {target} tokens "
          f"(extrapolated to >= {min_s:.1f}s)")
    return target, None


def cmd_fairness(args):
    """Baseline vs concurrent-prefill fairness qualification."""
    parser = argparse.ArgumentParser(
        prog=f"{sys.argv[0]} fairness",
        description="Compare two generations alone vs two generations running "
                    "entirely inside cold long prefills. Defaults to a 10s "
                    "decode deadline, 32k-pilot extrapolated prefills, and B-A-B.",
    )
    parser.add_argument("model")
    parser.add_argument("--generations", type=int, default=2,
                        help="concurrent generation requests (default 2)")
    parser.add_argument("--prefills", type=int, default=2,
                        help="concurrent cold prefill requests (default 2)")
    parser.add_argument("--generation-seconds", type=float, default=10.0,
                        help="decode window per generation request (default 10s)")
    parser.add_argument("--max-decode-tokens", "--max-gen-tokens",
                        dest="max_decode_tokens", type=int, default=4096,
                        help="max_tokens ceiling; the deadline normally stops "
                             "first (default 4096)")
    parser.add_argument("--prefill-tokens", default="auto",
                        help="cold prefill prompt tokens, or 'auto' (default)")
    parser.add_argument("--min-prefill-seconds", type=float, default=12.0,
                        help="minimum actual prefill span; fail below this "
                             "(default 12s)")
    parser.add_argument("--context-tokens", "--gen-prompt-tokens",
                        dest="context_tokens", type=int, default=16384,
                        help="generation request prompt/context tokens (default 16384)")
    parser.add_argument("--prefill-settle-ms", "--stagger-ms",
                        dest="settle_ms", type=int, default=500,
                        help="delay after launching prefills before generations "
                             "(default 500ms)")
    parser.add_argument("--repeats", type=int, default=1,
                        help="B-A-B repeats (default 1)")
    parser.add_argument("--min-chunks", type=int, default=4,
                        help="minimum content chunks in warmup (default 4)")
    parser.add_argument("--min-decode-fraction", type=float, default=0.9,
                        help="minimum decode window as a fraction of "
                             "--generation-seconds (default 0.9)")
    parser.add_argument("--max-itl-p50-ratio", "--max-itl-ratio",
                        dest="max_itl_p50_ratio", type=float, default=1.5,
                        help="max with-prefill/baseline ITL p50 ratio (default 1.5)")
    parser.add_argument("--max-itl-p95-ratio", type=float, default=2.0,
                        help="max with-prefill/baseline ITL p95 ratio (default 2.0)")
    parser.add_argument("--min-decode-tps-ratio", "--min-decode-ratio",
                        dest="min_decode_tps_ratio", type=float, default=0.7,
                        help="min with-prefill/baseline decode tps ratio (default 0.7)")
    parser.add_argument("--max-generation-spread", "--max-gen-spread",
                        dest="max_generation_spread", type=float, default=1.5,
                        help="max spread across generation degradation ratios (default 1.5)")
    parser.add_argument("--max-prefill-spread", type=float, default=2.0,
                        help="max prefill TTFT spread (default 2.0)")
    parser.add_argument("--no-baseline-after", "--no-post-baseline",
                        action="store_false", dest="post_baseline",
                        help="skip the second baseline phase")
    parser.add_argument("--timeout", type=int, default=600)
    parser.add_argument("--json", action="store_true", help="emit JSON after the table")
    a = parser.parse_args(args)

    if a.generations < 1:
        parser.error("--generations must be >= 1")
    if a.prefills < 0:
        parser.error("--prefills must be >= 0")
    if a.repeats < 1:
        parser.error("--repeats must be >= 1")
    if a.context_tokens < 1:
        parser.error("prompt token counts must be >= 1")
    if a.generation_seconds <= 0:
        parser.error("--generation-seconds must be > 0")
    if a.max_decode_tokens < 1:
        parser.error("--max-decode-tokens must be >= 1")
    if a.min_prefill_seconds <= 0:
        parser.error("--min-prefill-seconds must be > 0")
    if a.settle_ms < 0:
        parser.error("--prefill-settle-ms must be >= 0")
    if a.min_chunks < 1:
        parser.error("--min-chunks must be >= 1")
    if not 0 < a.min_decode_fraction <= 1:
        parser.error("--min-decode-fraction must be > 0 and <= 1")

    auto_prefill = a.prefill_tokens == "auto"
    if auto_prefill:
        prefill_tokens = _FAIRNESS_PREFILL_PILOT_TOKENS
    else:
        try:
            prefill_tokens = int(a.prefill_tokens)
        except ValueError:
            parser.error("--prefill-tokens must be an integer or 'auto'")
        if prefill_tokens < 1:
            parser.error("--prefill-tokens must be >= 1")

    base, key = _load_config()
    mml = _bench_model_max_len(base, key, a.model)

    sys.stdout.reconfigure(line_buffering=True)
    print(f"Endpoint: {base}\nModel:    {a.model}"
          + (f"  (max_model_len {mml})" if mml else ""))

    warm = _bench_stream(
        base, key, [{"role": "user",
                     "content": _bench_build_prompt(a.context_tokens)}],
        a.model, 32, a.timeout, True)
    if warm.get("error"):
        print(f"{RED}warmup ERR{RESET}: {warm['error']}")
        return 1
    warm_chunks = warm.get("chunks") or []
    if len(warm_chunks) < a.min_chunks:
        print(f"{RED}streaming preflight failed{RESET}: warmup returned "
              f"{len(warm_chunks)} content chunks, need >= {a.min_chunks}. "
              "A buffering proxy makes ITL meaningless.")
        return 1

    pilot_stats = None
    if auto_prefill:
        prefill_tokens, err = _size_prefill(
            base, key, a.model, mml, a.min_prefill_seconds, a.timeout)
        if err:
            print(f"{RED}prefill sizing failed{RESET}: {err}")
            return 1

    print(f"Workload: {a.generations} generations x "
          f"{a.generation_seconds:.1f}s decode, {a.prefills} prefills x "
          f"{prefill_tokens} tokens, {a.repeats} repeat(s)")

    generation_prompts = [_bench_build_prompt(a.context_tokens)
                         for _ in range(a.generations)]
    err = _warm_generation_prefixes(
        base, key, a.model, generation_prompts, a.timeout)
    if err:
        print(f"{RED}generation prefix warmup failed{RESET}: {err}")
        return 1

    baselines = []
    loaded_phases = []
    for repeat in range(1, a.repeats + 1):
        print(f"\n=== repeat {repeat}/{a.repeats} ===")
        before = _fairness_phase(
            base, key, a.model, "baseline", generation_prompts,
            a.max_decode_tokens, 0, 0,
            a.generation_seconds, a.timeout, a.settle_ms)
        loaded = _fairness_phase(
            base, key, a.model, "with-prefill", generation_prompts,
            a.max_decode_tokens, a.prefills,
            prefill_tokens, a.generation_seconds, a.timeout, a.settle_ms,
            progress=True)
        baselines.append(before)
        loaded_phases.append(loaded)
        phase_rows = [before, loaded]
        if a.post_baseline:
            after = _fairness_phase(
                base, key, a.model, "baseline-after", generation_prompts,
                a.max_decode_tokens, 0, 0,
                a.generation_seconds, a.timeout, a.settle_ms)
            baselines.append(after)
            phase_rows.append(after)
        _print_fairness_rows(phase_rows)

    thresholds = {
        "min_prefill_seconds": a.min_prefill_seconds,
        "min_decode_seconds": a.generation_seconds * a.min_decode_fraction,
        "max_itl_p50_ratio": a.max_itl_p50_ratio,
        "max_itl_p95_ratio": a.max_itl_p95_ratio,
        "min_decode_tps_ratio": a.min_decode_tps_ratio,
        "max_generation_spread": a.max_generation_spread,
        "max_prefill_spread": a.max_prefill_spread,
    }
    summary = _fairness_summary(baselines, loaded_phases, thresholds)

    def fmt(value, suffix=""):
        return f"{value:.2f}{suffix}" if value is not None else "n/a"

    print("\nSummary")
    print(f"  baseline p50 ITL:  {fmt(summary['baseline_itl_p50_ms'], ' ms')}")
    print(f"  with-prefill p50 ITL: {fmt(summary['with_prefill_itl_p50_ms'], ' ms')}  "
          f"ratio {fmt(summary['itl_p50_ratio'])} "
          f"(<= {a.max_itl_p50_ratio:.2f})")
    print(f"  baseline p95 ITL:  {fmt(summary['baseline_itl_p95_ms'], ' ms')}")
    print(f"  with-prefill p95 ITL: {fmt(summary['with_prefill_itl_p95_ms'], ' ms')}  "
          f"ratio {fmt(summary['itl_p95_ratio'])} "
          f"(<= {a.max_itl_p95_ratio:.2f})")
    print(f"  baseline decode:   {fmt(summary['baseline_decode_tps'], ' tok/s')}")
    print(f"  with-prefill decode:  {fmt(summary['with_prefill_decode_tps'], ' tok/s')}  "
          f"ratio {fmt(summary['decode_tps_ratio'])} "
          f"(>= {a.min_decode_tps_ratio:.2f})")
    print(f"  per-request spread:        {fmt(summary['generation_spread'])} "
          f"(<= {a.max_generation_spread:.2f})")
    print(f"  prefill TTFT:      "
          + (", ".join(f"{v:.0f}ms" for v in summary["prefill_ttft_ms"])
             or "n/a")
          + f"  spread {fmt(summary['prefill_spread'])} "
          f"(<= {a.max_prefill_spread:.2f})")
    print(f"  prefill span:      "
          + (", ".join(f"{v:.1f}s" for v in summary["prefill_span_s"])
             or "n/a")
          + f"  (>= {a.min_prefill_seconds:.1f}s)")
    print(f"  containment:       "
          + (", ".join(f"{v:+.2f}s" for v in summary["containment_margin_s"])
             or "n/a")
          + "  (>= 0 = generation ended before prefill)")
    print(f"  decode window:     "
          + (f"min {min(summary['decode_window_s']):.2f}s"
             if summary["decode_window_s"] else "n/a")
          + f"  (>= {a.generation_seconds * a.min_decode_fraction:.2f}s; "
          "raise --max-decode-tokens if short)")
    print(f"  generation prefix cache: "
          + (f"min {min(summary['generation_prefix_cache_hit']):.2f}"
             if summary["generation_prefix_cache_hit"] else "n/a")
          + f" hit  (>= {_FAIRNESS_MIN_PREFIX_CACHE_HIT:.2f}; prefix warmup)")
    print(f"  errors:            {summary['errors']}")
    print(f"  result:            "
          f"{GREEN + 'PASS' + RESET if summary['passed'] else RED + 'FAIL' + RESET}")

    if a.json:
        print()
        print(json.dumps({
            "model": a.model,
            "config": {
                "generations": a.generations,
                "prefills": a.prefills,
                "generation_seconds": a.generation_seconds,
                "max_decode_tokens": a.max_decode_tokens,
                "prefill_tokens": prefill_tokens,
                "context_tokens": a.context_tokens,
                "prefill_settle_ms": a.settle_ms,
                "repeats": a.repeats,
                "post_baseline": a.post_baseline,
                "min_prefill_seconds": a.min_prefill_seconds,
                "min_decode_fraction": a.min_decode_fraction,
                        "max_itl_p50_ratio": a.max_itl_p50_ratio,
                "max_itl_p95_ratio": a.max_itl_p95_ratio,
                "min_decode_tps_ratio": a.min_decode_tps_ratio,
            },
            "pilot": pilot_stats,
            "phases": baselines + loaded_phases,
            "summary": summary,
        }, indent=2))
    return 0 if summary["passed"] else 1


def cmd_batch(args):
    """Concurrent throughput/latency-under-load benchmark."""
    parser = argparse.ArgumentParser(
        prog=f"{sys.argv[0]} batch",
        description="Fire concurrent requests and report requests/s plus "
                    "median latency under load.",
    )
    parser.add_argument("model")
    parser.add_argument(
        "--concurrency", default="4",
        help="comma-separated requests per round; pass multiple values for a "
             "concurrency sweep (default 4)",
    )
    parser.add_argument(
        "--prompt-tokens", type=int, default=4096,
        help="target prompt token count (default 4096)",
    )
    parser.add_argument(
        "--gen", type=int, default=256,
        help="decode tokens per request (default 256)",
    )
    parser.add_argument(
        "--cache", type=int, default=100,
        help="percent of requests sharing one prompt prefix: 100 = all "
             "cached-prefill (default), 0 = all cold prefill, NN = mix",
    )
    parser.add_argument(
        "--rounds", type=int, default=3,
        help="how many concurrent rounds to run (default 3)",
    )
    parser.add_argument("--timeout", type=int, default=600)
    parser.add_argument("--json", action="store_true", help="emit JSON after the table")
    a = parser.parse_args(args)
    try:
        concurrencies = [int(x) for x in a.concurrency.split(",") if x.strip()]
    except ValueError:
        parser.error("--concurrency must be comma-separated integers")
    if not concurrencies or any(c < 1 for c in concurrencies):
        parser.error("--concurrency values must be >= 1")
    if a.rounds < 1:
        parser.error("--rounds must be >= 1")
    if a.prompt_tokens < 1:
        parser.error("--prompt-tokens must be >= 1")
    if a.gen < 1:
        parser.error("--gen must be >= 1")
    if not 0 <= a.cache <= 100:
        parser.error("--cache must be 0..100")

    base, key = _load_config()
    mml = _bench_model_max_len(base, key, a.model)
    if mml and a.prompt_tokens > mml - 2000:
        print(f"{DIM}note: capping prompt tokens to {mml - 2000} "
              f"(model max_model_len {mml}){RESET}")
        a.prompt_tokens = mml - 2000
    sys.stdout.reconfigure(line_buffering=True)
    results = []
    for i, concurrency in enumerate(concurrencies, 1):
        if i > 1:
            print()
        if len(concurrencies) > 1:
            print(f"=== concurrency {concurrency} ===")
        results.append(_batch_run(base, key, a.model, a.prompt_tokens, a.gen,
                                  a.timeout, concurrency, a.rounds, a.cache, mml))
    if a.json:
        print()
        payload = results[0] if len(results) == 1 else results
        print(json.dumps(payload, indent=2))
    return 1 if any(r["summary"]["ok"] == 0 for r in results) else 0


def cmd_transcribe(args):
    """Transcribe an audio file via /v1/audio/transcriptions."""
    parser = argparse.ArgumentParser(
        prog=f"{sys.argv[0]} transcribe",
        description="Transcribe an audio file via the gateway.",
    )
    parser.add_argument("audio", help="path to the audio file")
    parser.add_argument(
        "--model", default=os.environ.get("WHISPER_MODEL", "whisper-1"),
        help="model id (default: whisper-1 or $WHISPER_MODEL)",
    )
    parser.add_argument(
        "--format", default="verbose_json",
        help="response_format (default: verbose_json)",
    )
    parser.add_argument(
        "--diarize", action="store_true",
        help="request speaker diarization",
    )
    a = parser.parse_args(args)

    audio = Path(a.audio)
    if not audio.is_file():
        print(f"not a file: {audio}", file=sys.stderr)
        return 2

    base, key = _load_config()

    # multipart/form-data upload built by hand; the stdlib does not
    # expose a multipart writer, so we assemble the body manually.
    boundary = "----ycluster-inference-" + secrets.token_hex(8)
    fields = {
        "model": a.model,
        "response_format": a.format,
    }
    if a.diarize:
        fields["diarize"] = "true"

    parts = []
    for name, value in fields.items():
        parts.append(f"--{boundary}\r\n".encode())
        parts.append(
            f'Content-Disposition: form-data; name="{name}"\r\n\r\n'.encode()
        )
        parts.append(f"{value}\r\n".encode())
    with audio.open("rb") as f:
        parts.append(f"--{boundary}\r\n".encode())
        parts.append(
            'Content-Disposition: form-data; name="file"; '
            f'filename="{audio.name}"\r\n'.encode()
        )
        parts.append(b"Content-Type: application/octet-stream\r\n\r\n")
        parts.append(f.read())
        parts.append(b"\r\n")
    parts.append(f"--{boundary}--\r\n".encode())
    body = b"".join(parts)

    req = urllib.request.Request(
        base + "/v1/audio/transcriptions",
        data=body,
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": f"multipart/form-data; boundary={boundary}",
        },
        method="POST",
    )

    size = audio.stat().st_size
    print(f"Endpoint: {base}/v1/audio/transcriptions")
    print(f"Model:    {a.model}")
    print(f"File:      {audio} ({size} bytes)")
    print(f"Format:    {a.format}")
    print(f"Diarize:   {a.diarize}")
    print()

    started = time.monotonic()
    try:
        with urllib.request.urlopen(req, timeout=600) as resp:
            data = json.loads(resp.read())
    except urllib.error.HTTPError as e:
        print(f"HTTP {e.code}: {e.read().decode('utf-8', 'replace')}", file=sys.stderr)
        return 1

    elapsed = (time.monotonic() - started) * 1000
    print(f"Done in {elapsed:.0f}ms")
    print()

    text = data.get("text") or ""
    segments = data.get("segments") or []
    if text:
        chars = len(text)
        words = len(text.split())
        segs = len(segments) if segments else "n/a"
        print(f"Transcript: {chars} chars, ~{words} words, {segs} segments")
        print()
        print("--- First 500 chars ---")
        print(text[:500])
        print()
        if a.diarize and segments:
            print("--- Diarized segments ---")
            for seg in segments:
                speaker = seg.get("speaker", "?")
                seg_text = seg.get("text", "").strip()
                print(
                    f"  [{seg.get('start', 0):6.2f}-{seg.get('end', 0):6.2f}] "
                    f"{speaker:11} {seg_text}"
                )
    else:
        print("--- Response ---")
        print(json.dumps(data, indent=2))
    return 0


def cmd_ocr(args):
    """OCR / document extraction via /v1/file_parse (MinerU).

    Backed by MinerU 3.4.x running on the macOS and Nvidia inference
    nodes. Supports PDF, DOCX, PPTX, XLSX, and images. Layout-aware
    parsing — headings, tables, equations, code blocks, and reading-
    order text blocks all preserved in the markdown output.

    Default backend is `vlm-engine` (pure VLM, no specialised OCR
    pipeline). Both the macOS install (mineru[all]) and the Nvidia
    install (mineru[vlm]) support this — MinerU's API default is
    `hybrid-engine`, which requires the pipeline dependencies, so we
    override it here. Use `--backend hybrid-engine` if you've installed
    `[pipeline]` / `[all]` and want OCR-augmented parsing on edge-case
    docs (handwriting, dense tables, formulas).
    """
    parser = argparse.ArgumentParser(
        prog=f"{sys.argv[0]} ocr",
        description="OCR / document extraction via the gateway (MinerU).",
    )
    parser.add_argument(
        "files", nargs="+",
        help="path(s) to document(s) or image(s); accepts PDF, DOCX, PPTX, XLSX, images",
    )
    parser.add_argument(
        "--model", default="document-parse",
        help="model id (default: document-parse; also: mineru-parse)",
    )
    parser.add_argument(
        "--format", choices=["md", "json", "zip"], default="md",
        help="output format: md (print markdown), json (full response), "
             "zip (download result ZIP; requires --output)",
    )
    parser.add_argument(
        "--output", help="output file path (required for --format zip)",
    )
    parser.add_argument(
        "--backend", default="vlm-engine",
        choices=["vlm-engine", "hybrid-engine", "pipeline"],
        help="MinerU backend (default: vlm-engine). hybrid-engine and "
             "pipeline require mineru[all] / mineru[pipeline] on the host.",
    )
    parser.add_argument(
        "--timeout", type=int, default=300,
        help="request timeout in seconds (default: 300)",
    )
    a = parser.parse_args(args)

    paths = [Path(f) for f in a.files]
    for p in paths:
        if not p.is_file():
            print(f"not a file: {p}", file=sys.stderr)
            return 2

    if a.format == "zip" and not a.output:
        print("--format zip requires --output FILE", file=sys.stderr)
        return 2

    base, key = _load_config()

    # multipart/form-data upload built by hand; the stdlib does not
    # expose a multipart writer, so we assemble the body manually.
    # Mirrors the construction in cmd_transcribe, but with `files`
    # repeated per upload (MinerU accepts multiple documents in one
    # request).
    boundary = "----ycluster-inference-" + secrets.token_hex(8)
    fields = {"model": a.model, "backend": a.backend, "return_md": "true"}
    if a.format == "zip":
        fields["response_format_zip"] = "true"

    parts = []
    for name, value in fields.items():
        parts.append(f"--{boundary}\r\n".encode())
        parts.append(
            f'Content-Disposition: form-data; name="{name}"\r\n\r\n'.encode()
        )
        parts.append(f"{value}\r\n".encode())
    for path in paths:
        with path.open("rb") as f:
            parts.append(f"--{boundary}\r\n".encode())
            parts.append(
                'Content-Disposition: form-data; name="files"; '
                f'filename="{path.name}"\r\n'.encode()
            )
            parts.append(b"Content-Type: application/octet-stream\r\n\r\n")
            parts.append(f.read())
            parts.append(b"\r\n")
    parts.append(f"--{boundary}--\r\n".encode())
    body = b"".join(parts)

    req = urllib.request.Request(
        base + "/v1/file_parse",
        data=body,
        headers={
            "Authorization": f"Bearer {key}",
            "Content-Type": f"multipart/form-data; boundary={boundary}",
        },
        method="POST",
    )

    total_size = sum(p.stat().st_size for p in paths)
    print(f"Endpoint: {base}/v1/file_parse")
    print(f"Model:    {a.model}")
    print(f"Backend:  {a.backend}")
    print(f"Files:    {len(paths)} ({total_size} bytes total)")
    for p in paths:
        print(f"          {p} ({p.stat().st_size} bytes)")
    print(f"Format:   {a.format}")
    print()

    started = time.monotonic()
    try:
        with urllib.request.urlopen(req, timeout=a.timeout) as resp:
            if a.format == "zip":
                Path(a.output).write_bytes(resp.read())
                elapsed = (time.monotonic() - started) * 1000
                print(f"Done in {elapsed:.0f}ms — wrote {a.output} "
                      f"({Path(a.output).stat().st_size} bytes)")
                return 0
            data = json.loads(resp.read())
    except urllib.error.HTTPError as e:
        print(f"HTTP {e.code}: {e.read().decode('utf-8', 'replace')}",
              file=sys.stderr)
        return 1

    elapsed = (time.monotonic() - started) * 1000
    print(f"Done in {elapsed:.0f}ms")
    print()

    if a.format == "json":
        print(json.dumps(data, indent=2))
        return 0

    # md format: print results.<file>.md_content for each uploaded file.
    results = data.get("results") or {}
    if not results:
        print("--- Response (no results key) ---")
        print(json.dumps(data, indent=2))
        return 0

    for name, content in results.items():
        md = content.get("md_content", "")
        if md:
            print(f"=== {name} ===")
            print(md)
            print()
        else:
            print(f"=== {name} (no md_content) ===")
            print(json.dumps(content, indent=2))
            print()
    return 0


def main():
    if len(sys.argv) >= 2 and sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    if (
        len(sys.argv) < 2
        or sys.argv[1] not in ("chat", "bench", "batch", "fairness", "models",
                              "image", "smoke", "transcribe", "ocr")
    ):
        print(__doc__, file=sys.stderr)
        return 2
    sub = sys.argv[1]
    rest = sys.argv[2:]

    if sub == "models":
        return cmd_models(rest)
    if sub == "chat":
        return cmd_chat(rest)
    if sub == "image":
        return cmd_image(rest)
    if sub == "smoke":
        return cmd_smoke(rest)
    if sub == "bench":
        return cmd_bench(rest)
    if sub == "batch":
        return cmd_batch(rest)
    if sub == "fairness":
        return cmd_fairness(rest)
    if sub == "transcribe":
        return cmd_transcribe(rest)
    if sub == "ocr":
        return cmd_ocr(rest)


if __name__ == "__main__":
    sys.exit(main())
