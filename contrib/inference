def _smoke_has_num(text, n):
    # match the number allowing $, commas, decimals; word-boundary-ish
    return re.search(rf"(?<![\d.]){re.escape(str(n))}(?![\d])",
                     text.replace(",", "")) is not None


def _smoke_has_word(text, w):
    return w.lower() in text.lower()


def _smoke_check_json(text, expected):
    m = re.search(r"\{.*\}", text, re.DOTALL)
    if not m:
        return False
    try:
        obj = json.loads(m.group(0))
    except json.JSONDecodeError:
        return False
    return all(obj.get(k) == v for k, v in expected.items())


