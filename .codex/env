# Codex agent shell environment. This file is loaded via BASH_ENV in *every*
# bash subshell in this repo (including just recipes), so the redirects below
# are conditional: they only kick in when the default home locations are not
# writable (Codex sandbox / restricted environments). On a normal dev machine
# with writable ~/go, ~/.local, and ~/.cache, uv/go use their defaults.
#
#   tmp/gopath/bin  govulncheck, osv-scanner (built here via `go install`
#                   when the default GOPATH isn't writable)
#   tmp/bin         uv tool executables (UV_TOOL_BIN_DIR redirect)
#   tmp/uv-tools    uv tool environments
#   tmp/xdg-cache   XDG cache for tools that honor it
#   tmp/gopath, tmp/go-cache, tmp/uv-cache — Go + uv scratch caches
export PATH=$PWD/tmp/gopath/bin:$PWD/tmp/bin:$PWD/.venv/bin:$PWD/mcp/cluster-exec:$HOME/.opencode/bin:$HOME/.cargo/bin:$HOME/go/bin:$HOME/.local/bin:$HOME/bin:/usr/local/bin:/usr/bin:/bin

if [ ! -w "$HOME/go" ]; then
    export GOPATH=$PWD/tmp/gopath
    export GOMODCACHE=$PWD/tmp/gopath/pkg/mod
    export GOCACHE=$PWD/tmp/go-cache
fi
if [ ! -w "$HOME/.local" ]; then
    export UV_CACHE_DIR=$PWD/tmp/uv-cache
    export UV_TOOL_DIR=$PWD/tmp/uv-tools
    export UV_TOOL_BIN_DIR=$PWD/tmp/bin
fi
if [ ! -w "$HOME/.cache" ]; then
    export XDG_CACHE_HOME=$PWD/tmp/xdg-cache
fi
