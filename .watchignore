.git
.aider*
AGENTS.local.md
config/ansible/vault/
data/dnsmasq.leases
data/*.iso
data/*_key
data/*_key.pub
data/SHA256SUMS
dev/ansible/host_vars/
dev/dnsmasq.conf
dev/dnsmasq.leases
dev/tftpboot/
dev/dhcp-hosts
**/*.egg-info
.idea
__pycache__
.vault_pass
# group_vars vault.yml are symlinks into config/ansible/vault/; sync the links
# themselves (the real encrypted targets stay excluded via line 4). rsync is
# first-match-wins, so these includes must precede the **/vault*.yml exclude.
+ /config/ansible/group_vars/all/vault.yml
+ /config/ansible/group_vars/storage/vault.yml
**/vault*.yml
.venv/
venv/
bench-results/
research/
*.token
# ext/ holds third-party checkouts (llama.cpp, flashinfer) cloned for local
# reference and benchmarking — not part of the repo, regenerated independently.
ext/
# npm install output; the tracked content is skills/ under .opencode/, the rest
# is installed via a separate mechanism on the cluster.
.opencode/node_modules
# local scratch (test logs, sync logs, etc.) — gitignored in .gitignore too.
tmp/
# linked git worktrees created by `just worktree` (./trees/<branch>) — gitignored
# in .gitignore, and must never sync: worktree branch edits would silently
# overwrite the cluster's main-tree copy of /opt/infrastructure.
/trees/
