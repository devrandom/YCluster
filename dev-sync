#!/usr/bin/python3
"""
Sync the ycluster repo to $YC_SYNC_HOST:/opt/infrastructure/ (default s1.yc).

Replaced watchman (orphaned in Debian 13; bug #1019497) with an inotify-based
daemon using python3-pyinotify. Single source of truth for the rsync options
(so --check and the live transfer can't drift) and the event-filter set.

Subcommands:
  --start   Spawn the daemon in the background (start_new_session so it
            survives shell exit), run an initial sync, exit.
  --stop    SIGTERM the daemon (clears its PID file).
  --status  Print 'running' or 'not running'.
  --check   Dry-run checksum compare against the cluster: list files whose
            content differs (exit 1 if any) and report daemon state.
  --once    Do a single sync, no daemon.
  --daemon  Long-running watcher (debounces events, then rsyncs). Exits
            cleanly on SIGTERM/SIGINT. Not meant to be called directly —
            --start spawns it.

PID file:  tmp/dev-sync.pid
Log file:  tmp/dev-sync.log

Events under these paths are ignored (same set watchman skipped):
  .git/, tmp/, any __pycache__/, .venv/, venv/
The tmp/ exclusion in particular breaks the feedback loop where the daemon's
own log writes re-fire the watcher.
"""

import errno
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

import pyinotify

REPO = Path(__file__).resolve().parent
LOG = REPO / 'tmp' / 'dev-sync.log'
PID = REPO / 'tmp' / 'dev-sync.pid'
DEBOUNCE_S = 0.2

DEST = os.environ.get('YC_SYNC_HOST', 's1.yc') + ':/opt/infrastructure/'

# --copy-unsafe-links dereferences symlinks pointing OUTSIDE the repo tree
# (config/ansible/host_vars -> ../../../ycluster-private/host_vars) so their
# real contents land on the cluster; in-tree links (dev/ansible/prod, CLAUDE.md)
# stay as symlinks. .watchignore is the source of truth for both rsync and the
# daemon's debounce, so they cannot drift.
RSYNC_OPTS = ['-az', '--copy-unsafe-links', f'--exclude-from={REPO / ".watchignore"}']
RSYNC_CHECK_OPTS = ['-naci', '--copy-unsafe-links', f'--exclude-from={REPO / ".watchignore"}']

# Match a path component exactly (.git, tmp, ...) at any depth: anchored at
# either start-of-path or after a slash, and either end-of-path or before a
# slash -- so ".git" matches ".git", ".git/HEAD", "subdir/.git", "x/.git/y".
SKIP_RE = re.compile(r'(^|/)(.git|tmp|__pycache__|\.venv|venv)(/|$)')


def log(line):
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open('a') as f:
        f.write(f'[{time.strftime("%H:%M:%S")}] {line}\n')
        f.flush()
        os.fsync(f.fileno())


def write_pid():
    PID.parent.mkdir(parents=True, exist_ok=True)
    PID.write_text(str(os.getpid()))


def clear_pid():
    try:
        PID.unlink()
    except FileNotFoundError:
        pass


def is_running():
    if not PID.exists():
        return False
    try:
        pid = int(PID.read_text().strip())
    except (ValueError, OSError):
        return False
    try:
        os.kill(pid, 0)
    except OSError as e:
        if e.errno == errno.ESRCH:
            return False  # stale
        raise
    return True


def should_skip(path):
    try:
        rel = str(Path(path).resolve().relative_to(REPO))
    except ValueError:
        return True  # outside the repo
    return bool(SKIP_RE.search(rel))


def run_rsync_quiet():
    """Run rsync (live transfer). Errors go to the log via run_rsync()."""
    rc = subprocess.run(
        ['rsync', *RSYNC_OPTS, f'{REPO}/', DEST],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
    log('done' if rc == 0 else f'rsync failed (rc={rc})')


def cmd_sync_verbose():
    """Foreground sync with a 'syncing.../done/rsync failed' trail (for --once
    and the initial sync from --start). Writes the same lines to stdout so the
    operator sees progress; the daemon's quiet variant goes to the log only."""
    print(f'[{time.strftime("%H:%M:%S")}] syncing...')
    rc = subprocess.run(
        ['rsync', *RSYNC_OPTS, f'{REPO}/', DEST]).returncode
    line = 'done' if rc == 0 else f'rsync failed (rc={rc})'
    print(f'[{time.strftime("%H:%M:%S")}] {line}')
    return rc


def cmd_check():
    # Dry-run, checksum-based (-c) comparison with the same exclude set as the
    # live sync. No --delete: the synced set includes untracked scratch dirs
    # that legitimately differ from a clean checkout, and we only care that
    # local state landed. Exit 1 on any difference so the result is scriptable.
    if is_running():
        print('watcher: running')
    else:
        print('watcher: NOT running — edits are not being auto-synced')
    out = subprocess.run(
        ['rsync', *RSYNC_CHECK_OPTS, f'{REPO}/', DEST],
        capture_output=True, text=True).stdout
    if not out:
        print(f'in sync with {DEST}')
        return 0
    print(out)
    n = out.count('\n')
    print(f'--- out of sync: {n} item(s) differ ---')
    return 1


def cmd_start():
    if is_running():
        print(f'watcher already running for {REPO} (log: {LOG})')
        return 0
    LOG.parent.mkdir(parents=True, exist_ok=True)
    LOG.write_text('')  # truncate so the log holds only this run's output
    # start_new_session=True so the daemon survives the parent shell exiting
    # (no SIGHUP on terminal close). stdout/stderr to DEVNULL so it doesn't
    # spam the parent's stream when the parent shell is gone.
    subprocess.Popen(
        [sys.executable, __file__, '--daemon'],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True)
    cmd_sync_verbose()  # initial sync; rc ignored (daemon will catch up)
    print(f'started — watching {REPO} in the background; log: {LOG}')
    print(f'stop with: {__file__} --stop')
    return 0


def cmd_stop():
    if not is_running():
        print('not running')
        return 0
    pid = int(PID.read_text().strip())
    try:
        os.kill(pid, signal.SIGTERM)
        print(f'sent SIGTERM to pid {pid}')
    except OSError as e:
        if e.errno == errno.ESRCH:
            print(f'pid {pid} not alive (stale pid file)')
            clear_pid()
        else:
            raise
    return 0


def main_daemon():
    if is_running():
        sys.exit(f'dev-sync already running (pid {PID.read_text().strip()})')
    write_pid()
    log('daemon started')

    state = {'dirty': False, 'stop': False}

    def on_event(event):
        if not should_skip(event.pathname):
            state['dirty'] = True

    wm = pyinotify.WatchManager()
    mask = (pyinotify.IN_CLOSE_WRITE | pyinotify.IN_CREATE
            | pyinotify.IN_DELETE | pyinotify.IN_MOVED_TO
            | pyinotify.IN_MOVED_FROM)
    wm.add_watch(str(REPO), mask, rec=True)
    notifier = pyinotify.Notifier(wm, on_event)

    def shutdown(signum, frame):
        state['stop'] = True
        notifier.stop()
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    try:
        while not state['stop']:
            # process_events() drains any queued events (no-op when empty);
            # check_events() blocks up to DEBOUNCE_S for more. When the quiet
            # window expires with no new events, fire rsync if anything
            # changed -- the debounce that coalesces a burst of edits into a
            # single transfer.
            notifier.process_events()
            if notifier.check_events(timeout=DEBOUNCE_S):
                notifier.read_events()
            else:
                if state['dirty']:
                    state['dirty'] = False
                    run_rsync_quiet()
    finally:
        clear_pid()
        log('daemon stopped')


USAGE = f"""Usage: {Path(__file__).name} <command>

Sync local repo to {DEST} using rsync + an inotify daemon.

Commands:
  --start   Spawn the daemon (detached) and run an initial sync.
            Log: {LOG}
  --stop    SIGTERM the daemon.
  --check   Dry-run checksum compare against the cluster: list files whose
            content differs (exit 1 if any), and report if the daemon is up.
  --once    Do a single sync and exit (no daemon).
  --status  Print 'running' or 'not running'.
"""


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else None
    if cmd in (None, '-h', '--help'):
        print(USAGE)
        return 0
    if cmd == '--daemon':
        main_daemon()
        return 0
    if cmd == '--start':
        return cmd_start()
    if cmd == '--stop':
        return cmd_stop()
    if cmd == '--status':
        print('running' if is_running() else 'not running')
        return 0
    if cmd == '--once':
        return cmd_sync_verbose()
    if cmd == '--check':
        return cmd_check()
    print(f'unknown command: {cmd}\n', file=sys.stderr)
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main() or 0)
