#!/usr/bin/env python3
"""
Sync the ycluster repo to $YC_SYNC_HOST:/opt/infrastructure/ (default s1.yc).

Replaced watchman (orphaned in Debian 13; bug #1019497) with an inotify-based
daemon using python3-pyinotify. Single source of truth for the rsync options
(so --check and the live transfer can't drift) and the event-filter set.

Subcommands:
  --start   Spawn the daemon in the background (start_new_session so it
            survives shell exit), run an initial sync, exit.
  --stop    Tell the daemon to stop (via control socket).
  --status  Print 'running' or 'not running'.
  --check   Dry-run checksum compare against the cluster: list files whose
            content differs (timestamps ignored; exit 1 if any) and report
            daemon state.
  --once    Do a single sync, no daemon.
  --daemon  Long-running watcher (debounces events, then rsyncs). Exits
            cleanly on SIGTERM/SIGINT. Not meant to be called directly —
            --start spawns it.

Control socket:  tmp/dev-sync.sock
Log file:       tmp/dev-sync.log

Events under these paths are ignored (same set watchman skipped):
  .git/, tmp/, any __pycache__/, .venv/, venv/, ./trees/ (linked worktrees),
  ./work/ (throwaway agent worktrees)
The tmp/ exclusion in particular breaks the feedback loop where the daemon's
own log writes re-fire the watcher.
"""

import os
import re
import signal
import socket
import subprocess
import sys
import threading
import time
from fnmatch import fnmatch
from pathlib import Path

import pyinotify

REPO = Path(__file__).resolve().parent
LOG = REPO / 'tmp' / 'dev-sync.log'
SOCK = REPO / 'tmp' / 'dev-sync.sock'
DEBOUNCE_S = 0.2

DEST = os.environ.get('YC_SYNC_HOST', 's1.yc') + ':/opt/infrastructure/'

# --copy-unsafe-links dereferences symlinks pointing OUTSIDE the repo tree
# (config/ansible/host_vars -> ../../../ycluster-private/host_vars) so their
# real contents land on the cluster; in-tree links (dev/ansible/prod, CLAUDE.md)
# stay as symlinks. .watchignore is the source of truth for both rsync and the
# daemon's debounce, so they cannot drift.
RSYNC_OPTS = ['-az', '--no-owner', '--no-group', '--copy-unsafe-links', f'--exclude-from={REPO / ".watchignore"}']
# --no-times: -a includes -t, which makes rsync report (and would update)
# files whose content matches but whose mtime differs. --check is a
# content comparison, so ignore timestamps there.
RSYNC_CHECK_OPTS = ['-naci', '--no-owner', '--no-group', '--copy-unsafe-links',
                    '--no-times', f'--exclude-from={REPO / ".watchignore"}']

# Match a path component exactly (.git, tmp, ...) at any depth: anchored at
# either start-of-path or after a slash, and either end-of-path or before a
# slash -- so ".git" matches ".git", ".git/HEAD", "subdir/.git", "x/.git/y".
SKIP_RE = re.compile(r'(^|/)(\.git|tmp|__pycache__|\.venv|venv|trees|work)(/|$)')

# fs.inotify max_user_watches is 65536 here, and the repo has ~115k
# directories: ext/ ~19k, tmp/ ~38k, work/ ~53k, .venv/ ~4k. Adding a watch
# for every one of them exhausted the budget part-way through the walk, and
# pyinotify's add_watch is quiet=True by default, so every later watch --
# including the out-of-tree config/ansible/host_vars symlink target --
# failed with ENOSPC and was silently dropped. Private-repo edits then never
# fired an event even though --check saw them as out of sync.
#
# The fix is to watch only what is actually synced: .watchignore is already
# the source of truth for the rsync side, so prune the same paths here and
# the walk drops to a few hundred directories.
WATCHIGNORE = REPO / '.watchignore'


def _excluded_patterns():
    """Parse .watchignore into (kind, pattern) directory-prune rules."""
    pats = []
    try:
        lines = WATCHIGNORE.read_text().splitlines()
    except OSError:
        return pats
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith('#'):
            continue
        if line.startswith('+ '):  # rsync include; never a prune rule
            continue
        line = line.rstrip('/')
        if line.startswith('/'):
            pats.append(('root', line[1:]))
        elif line.startswith('**/'):
            pats.append(('name', line[3:]))
        elif '/' in line:
            pats.append(('root', line))
        else:
            pats.append(('name', line))
    return pats


EXCLUDED = _excluded_patterns()


def is_excluded(rel):
    """True when a repo-relative path is kept off the cluster."""
    if rel in ('', '.'):
        return False
    rel = rel[2:] if rel.startswith('./') else rel
    base = rel.rsplit('/', 1)[-1]
    for kind, pat in EXCLUDED:
        if kind == 'root':
            if rel == pat or rel.startswith(pat + '/'):
                return True
        elif fnmatch(base, pat):
            return True
    return bool(SKIP_RE.search(rel))


def add_watches(wm, root, mask, label, prune):
    """Watch root recursively, skipping paths the sync excludes.

    pyinotify's rec=True would add a watch per directory in the tree,
    including ext/, tmp/, work/ and .venv/ -- more directories than
    fs.inotify allows user watches for. Walk ourselves instead so the watch
    set matches the synced set, and report (rather than swallow) failures.
    Returns the list of directories that could not be watched.
    """
    failed = []
    watched = 0
    for dirpath, dirnames, _ in os.walk(root, followlinks=False):
        if prune:
            rel_dir = os.path.relpath(dirpath, root)
            dirnames[:] = [
                d for d in dirnames
                if not is_excluded(d if rel_dir == '.' else f'{rel_dir}/{d}')
            ]
        if wm.add_watch(dirpath, mask, quiet=True).get(dirpath, -1) < 0:
            failed.append(dirpath)
        else:
            watched += 1
    log(f'{label}: {watched} dir(s) watched'
        + (f', {len(failed)} FAILED' if failed else ''))
    for p in failed[:5]:
        try:
            limit = Path('/proc/sys/fs/inotify/max_user_watches').read_text().strip()
        except OSError:
            limit = '?'
        log(f'{label}: cannot watch {p} (max_user_watches={limit}) — '
            'edits there will not trigger a sync')
    return failed


def log(line):
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open('a') as f:
        f.write(f'[{time.strftime("%H:%M:%S")}] {line}\n')
        f.flush()
        os.fsync(f.fileno())


def is_running():
    """Check if the daemon is alive by connecting to its control socket."""
    if not SOCK.exists():
        return False
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(2)
        sock.connect(str(SOCK))
        sock.sendall(b'\x00')  # ping
        resp = sock.recv(1)
        return resp == b'\x00'
    except (FileNotFoundError, ConnectionRefusedError, OSError, socket.timeout):
        return False
    finally:
        try:
            sock.close()
        except OSError:
            pass


def socket_loop(state):
    """Accept connections on the control socket. Runs in a daemon thread."""
    SOCK.unlink(missing_ok=True)
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.bind(str(SOCK))
    sock.listen(5)
    sock.settimeout(1)
    try:
        while not state.get('stop', False):
            try:
                conn, _ = sock.accept()
                data = conn.recv(1)
                if data == b'\x01':  # stop
                    state['stop'] = True
                    conn.sendall(b'\x01')
                else:
                    conn.sendall(b'\x00')  # ping response
                conn.close()
            except socket.timeout:
                continue
    finally:
        sock.close()
        try:
            SOCK.unlink()
        except FileNotFoundError:
            pass


def unsafe_link_targets(root):
    """Real dirs targeted by symlinks under root that point outside root.

    inotify does not follow directory symlinks when adding watches
    recursively, so edits inside e.g. config/ansible/host_vars ->
    ../../../ycluster-private/host_vars never fire an event on the repo
    watch. Return the resolved external targets so the daemon can watch
    them directly too. The rsync side already dereferences these via
    --copy-unsafe-links, so the two stay in sync.
    """
    targets = []
    seen = set()
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        for name in list(dirnames) + filenames:
            p = Path(dirpath) / name
            if p.is_symlink() and p.is_dir():
                real = p.resolve()
                try:
                    real.relative_to(root)  # in-tree link: keep as-is
                except ValueError:
                    if real not in seen:
                        seen.add(real)
                        targets.append(real)
    return targets


def should_skip(path, extra_roots=()):
    rel = None
    resolved = Path(path).resolve()
    try:
        rel = str(resolved.relative_to(REPO))
    except ValueError:
        for r in extra_roots:
            try:
                rel = str(resolved.relative_to(r))
                break
            except ValueError:
                continue
    if rel is None:
        return True  # nothing under the repo or a synced external target
    return bool(SKIP_RE.search(rel))


def run_rsync_quiet():
    """Run rsync (live transfer). Errors go to the log via run_rsync()."""
    rc = subprocess.run(
        ['rsync', *RSYNC_OPTS, f'{REPO}/', DEST],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
    log('done' if rc == 0 else f'rsync failed (rc={rc})')


def cmd_sync_verbose():
    """Foreground sync with a 'syncing.../done/rsync failed' trail (for --once
    and the initial sync from --start). Writes the same lines to stdout so the
    operator sees progress; the daemon's quiet variant goes to the log only."""
    print(f'[{time.strftime("%H:%M:%S")}] syncing...')
    rc = subprocess.run(
        ['rsync', *RSYNC_OPTS, f'{REPO}/', DEST]).returncode
    line = 'done' if rc == 0 else f'rsync failed (rc={rc})'
    print(f'[{time.strftime("%H:%M:%S")}] {line}')
    return rc


def cmd_check():
    # Dry-run, checksum-based (-c) comparison with the same exclude set as the
    # live sync. No --delete: the synced set includes untracked scratch dirs
    # that legitimately differ from a clean checkout, and we only care that
    # local state landed. Exit 1 on any difference so the result is scriptable.
    if is_running():
        print('watcher: running')
    else:
        print('watcher: NOT running — edits are not being auto-synced')
    out = subprocess.run(
        ['rsync', *RSYNC_CHECK_OPTS, f'{REPO}/', DEST],
        capture_output=True, text=True).stdout
    if not out:
        print(f'in sync with {DEST}')
        return 0
    print(out)
    n = out.count('\n')
    print(f'--- out of sync: {n} item(s) differ ---')
    return 1


def cmd_start():
    if is_running():
        print(f'watcher already running for {REPO} (log: {LOG})')
        return 0
    LOG.parent.mkdir(parents=True, exist_ok=True)
    LOG.write_text('')  # truncate so the log holds only this run's output
    # start_new_session=True so the daemon survives the parent shell exiting
    # (no SIGHUP on terminal close). stdout/stderr to DEVNULL so it doesn't
    # spam the parent's stream when the parent shell is gone.
    subprocess.Popen(
        [sys.executable, __file__, '--daemon'],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True)
    cmd_sync_verbose()  # initial sync; rc ignored (daemon will catch up)
    print(f'started — watching {REPO} in the background; log: {LOG}')
    print(f'stop with: {__file__} --stop')
    return 0


def cmd_stop():
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(5)
        sock.connect(str(SOCK))
        sock.sendall(b'\x01')  # stop
        resp = sock.recv(1)
        if resp == b'\x01':
            print('stopped')
            return 0
        print(f'unexpected response: {resp!r}')
        return 1
    except (FileNotFoundError, ConnectionRefusedError, OSError, socket.timeout):
        print('not running')
        return 0
    finally:
        try:
            sock.close()
        except OSError:
            pass


def main_daemon():
    if is_running():
        sys.exit(f'dev-sync already running (socket {SOCK} exists)')
    log('daemon started')

    state = {'dirty': False, 'stop': False}

    t = threading.Thread(target=socket_loop, args=(state,), daemon=True)
    t.start()

    def on_event(event):
        if not should_skip(event.pathname, extra_roots):
            state['dirty'] = True

    extra_roots = unsafe_link_targets(REPO)

    wm = pyinotify.WatchManager()
    mask = (pyinotify.IN_CLOSE_WRITE | pyinotify.IN_CREATE
            | pyinotify.IN_DELETE | pyinotify.IN_MOVED_TO
            | pyinotify.IN_MOVED_FROM | pyinotify.IN_ATTRIB)

    # A failed repo watch means nothing fires at all; that is fatal, not a
    # warning, so the operator sees it in --status instead of trusting a
    # daemon that silently watches nothing.
    if add_watches(wm, REPO, mask, 'repo', prune=True):
        log('daemon exiting: repo watch incomplete')
        try:
            SOCK.unlink()
        except FileNotFoundError:
            pass
        sys.exit('dev-sync: could not watch the repo; see tmp/dev-sync.log')
    for r in extra_roots:
        add_watches(wm, r, mask, f'external {r}', prune=False)
    notifier = pyinotify.Notifier(wm, on_event)

    def shutdown(signum, frame):
        state['stop'] = True
        notifier.stop()
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    try:
        while not state['stop']:
            notifier.process_events()
            if notifier.check_events(timeout=DEBOUNCE_S):
                notifier.read_events()
            else:
                if state['dirty']:
                    state['dirty'] = False
                    run_rsync_quiet()
    finally:
        try:
            SOCK.unlink()
        except FileNotFoundError:
            pass
        log('daemon stopped')


USAGE = f"""Usage: {Path(__file__).name} <command>

Sync local repo to {DEST} using rsync + an inotify daemon.

Commands:
  --start   Spawn the daemon (detached) and run an initial sync.
            Log: {LOG}
  --stop    Tell the daemon to stop (via control socket).
  --check   Dry-run checksum compare against the cluster: list files whose
            content differs (timestamps ignored; exit 1 if any), and report
            if the daemon is up.
  --once    Do a single sync and exit (no daemon).
  --status  Print 'running' or 'not running'.
"""


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else None
    if cmd in (None, '-h', '--help'):
        print(USAGE)
        return 0
    if cmd == '--daemon':
        main_daemon()
        return 0
    if cmd == '--start':
        return cmd_start()
    if cmd == '--stop':
        return cmd_stop()
    if cmd == '--status':
        print('running' if is_running() else 'not running')
        return 0
    if cmd == '--once':
        return cmd_sync_verbose()
    if cmd == '--check':
        return cmd_check()
    print(f'unknown command: {cmd}\n', file=sys.stderr)
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main() or 0)
